{%- comment -%}
  destination-card — 撮影地一覧／地域別一覧で使う共通カード。
  Params:
    destination — 必須。shop.metaobjects.destination の1エントリー
{%- endcomment -%}
<a href="/pages/{{ destination.slug }}" class="group block">
  <div class="w-full relative overflow-hidden rounded-lg" style="padding-top: 125%;">
    {% if destination.hero_image != blank %}
      {{ destination.hero_image | image_url: width: 800 | image_tag: class: 'absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105', alt: destination.name_ja }}
    {% else %}
      <div class="absolute inset-0 w-full h-full bg-gray-200"></div>
    {% endif %}
    {% if destination.popular %}
      <span class="absolute top-3 left-3 px-3 py-1 text-[11px] font-bold text-white rounded-sm" style="background-color:#B8860B;">人気</span>
    {% endif %}
  </div>
  <div class="mt-3">
    <p class="text-xs tracking-wider uppercase" style="color:#B8860B;">{{ destination.country }}</p>
    <h3 class="font-serif font-medium mt-1" style="font-size: calc(var(--font-heading-scale, 1) * 18px);">{{ destination.name_ja }}</h3>
    {% if destination.description != blank %}
      <p class="text-xs text-gray-500 mt-1 line-clamp-2">{{ destination.description | strip_html | truncate: 60 }}</p>
    {% endif %}
  </div>
</a>
