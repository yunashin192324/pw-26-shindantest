{%- comment -%}
  destination-plans — この都市のプラン一覧。

  page.destination.jsonは全都市共通の1つのテンプレートなので、
  この「セクションのブロック」に商品を登録する従来方式だと、
  ある都市ページで追加したプランが他の全都市ページにも表示されて
  しまう(共有プールの問題)。そのため、Destination metaobject側の
  `plans`フィールド(商品参照のリスト)で都市ごとに商品を直接選ぶ
  方式に変更した。

  既存の互換性のため、`plans`が未設定の都市では、従来の
  セクションブロック(plan_blocks)にフォールバックする
  (Hawaiiなど、ブロック方式で既に設定済みのページがそのまま
  動き続けるようにするため)。新しく都市を追加する場合は
  `plans`メタフィールドの利用を推奨する。

  各商品のメイン画像の代替テキストに「｜位置」と書くと、その
  プランだけトリミング位置を上書きできる(product-plan.liquidの
  商品ギャラリーと同じ仕組み)。
{%- endcomment -%}
{%- comment -%}
  where: 'slug.value', page.handle はこの環境ではネストしたプロパティの
  絞り込みが効かないことがあるため、確実に動く明示的なfor+ifに置き換え。
{%- endcomment -%}
{%- assign all_destination_entries = shop.metaobjects.destination.values -%}
{%- assign destination = blank -%}
{%- for d in all_destination_entries -%}
  {%- if d.slug.value == page.handle -%}{%- assign destination = d -%}{%- endif -%}
{%- endfor -%}

{%- assign plan_products = destination.plans.value -%}
{%- assign plan_blocks = section.blocks | where: 'type', 'plan' -%}

{%- if plan_products.size > 0 or plan_blocks.size > 0 -%}
<section id="dst-plans"{% if section.settings.bg_ivory %} class="dst-bg-ivory"{% endif %}>
  <div class="dst-container">
    <div class="dst-section-head dst-reveal">
      <p class="dst-eyebrow" style="color:{{ section.settings.eyebrow_color }};">{{ section.settings.eyebrow }}</p>
      <h2 style="color:{{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
      <hr class="dst-divider">
    </div>
    <div class="dst-plans-grid">
      {%- if plan_products.size > 0 -%}
        {%- for linked_product in plan_products -%}
          {%- assign plan_variant = linked_product.selected_or_first_available_variant -%}
          {%- assign is_instant = false -%}
          {%- if linked_product.tags contains '即予約' -%}{%- assign is_instant = true -%}{%- endif -%}
          <a href="{{ linked_product.url }}" class="dst-plan-card dst-reveal">
            <div class="dst-plan-media">
              {%- if linked_product.featured_image != blank -%}
                {%- assign p_alt_parts = linked_product.featured_image.alt | replace: '｜', '|' | replace: '￤', '|' | replace: '¦', '|' | replace: '│', '|' | replace: '‖', '|' | split: '|' -%}
                {%- assign p_position_key = p_alt_parts[1] | strip -%}
                {%- capture p_pos_mapped -%}{% render 'destination-image-position', position_key: p_position_key %}{%- endcapture -%}
                {%- assign p_pos_mapped = p_pos_mapped | strip -%}
                {%- if p_pos_mapped != blank -%}
                  {%- assign plan_img_position = p_pos_mapped -%}
                {%- elsif p_position_key != blank -%}
                  {%- assign plan_img_position = p_position_key -%}
                {%- elsif linked_product.featured_image.presentation.focal_point -%}
                  {%- comment -%}
                    ALTテキストに｜位置の指定が無ければ、Shopify標準の
                    「フォーカスポイント」（管理画面の画像編集で設定する
                    青い点）を優先的に使う。無指定の「中央」より正確に
                    被写体を残せるため。
                  {%- endcomment -%}
                  {%- assign plan_img_position = linked_product.featured_image.presentation.focal_point.x | append: '% ' | append: linked_product.featured_image.presentation.focal_point.y | append: '%' -%}
                {%- else -%}
                  {%- assign plan_img_position = section.settings.img_position -%}
                {%- endif -%}
                {%- capture plan_img_style -%}object-position: {{ plan_img_position | escape }};{%- endcapture -%}
                {{ linked_product.featured_image | image_url: width: 900 | image_tag: class: 'dst-plan-img', loading: 'lazy', alt: linked_product.title, style: plan_img_style }}
              {%- endif -%}
              {%- if is_instant -%}<span class="dst-plan-badge">即予約</span>{%- endif -%}
            </div>
            <div class="dst-plan-body">
              <h3 class="dst-plan-title">{% render 'safe-linebreak', text: linked_product.title %}</h3>
              {%- if linked_product.description != blank -%}
                <p class="dst-plan-desc">{{ linked_product.description | strip_html | truncate: 60 }}</p>
              {%- endif -%}
              {%- if plan_variant -%}
                <p class="dst-plan-price">{{ plan_variant.price | money_without_currency }}<span style="font-size:0.6em;">円〜</span></p>
              {%- endif -%}
              <span class="dst-card-link">詳しく見る ＞</span>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for block in plan_blocks -%}
          {%- assign linked_product = block.settings.product -%}
          {%- assign plan_variant = linked_product.selected_or_first_available_variant -%}
          {%- assign is_instant = false -%}
          {%- if linked_product.tags contains '即予約' -%}{%- assign is_instant = true -%}{%- endif -%}
          <a href="{{ linked_product.url }}" class="dst-plan-card dst-reveal" {{ block.shopify_attributes }}>
            <div class="dst-plan-media">
              {%- if linked_product.featured_image != blank -%}
                {%- assign plan_img_position = block.settings.img_position -%}
                {%- if plan_img_position == blank -%}
                  {%- if linked_product.featured_image.presentation.focal_point -%}
                    {%- assign plan_img_position = linked_product.featured_image.presentation.focal_point.x | append: '% ' | append: linked_product.featured_image.presentation.focal_point.y | append: '%' -%}
                  {%- else -%}
                    {%- assign plan_img_position = section.settings.img_position -%}
                  {%- endif -%}
                {%- endif -%}
                {%- capture plan_img_style -%}object-position: {{ plan_img_position }};{%- endcapture -%}
                {{ linked_product.featured_image | image_url: width: 900 | image_tag: class: 'dst-plan-img', loading: 'lazy', alt: linked_product.title, style: plan_img_style }}
              {%- endif -%}
              {%- if is_instant -%}<span class="dst-plan-badge">即予約</span>{%- endif -%}
            </div>
            <div class="dst-plan-body">
              <h3 class="dst-plan-title">{% render 'safe-linebreak', text: linked_product.title %}</h3>
              {%- if linked_product.description != blank -%}
                <p class="dst-plan-desc">{{ linked_product.description | strip_html | truncate: 60 }}</p>
              {%- endif -%}
              {%- if plan_variant -%}
                <p class="dst-plan-price">{{ plan_variant.price | money_without_currency }}<span style="font-size:0.6em;">円〜</span></p>
              {%- endif -%}
              <span class="dst-card-link">詳しく見る ＞</span>
            </div>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "都市 プラン一覧",
  "settings": [
    { "type": "checkbox", "id": "bg_ivory", "label": "背景をアイボリーにする", "default": true },
    { "type": "text", "id": "eyebrow", "label": "英字見出し", "default": "Plans" },
    { "type": "color", "id": "eyebrow_color", "label": "英字見出し色", "default": "#c9a96e" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "おすすめプラン" },
    { "type": "color", "id": "heading_color", "label": "見出し色", "default": "#1a1a1a" },
    { "type": "select", "id": "img_position", "label": "画像トリミング位置（既定値）", "default": "center",
      "info": "各プランの画像位置が未指定の場合に使われる既定値です。",
      "options": [
        { "value": "top", "label": "上" },
        { "value": "center", "label": "中央" },
        { "value": "bottom", "label": "下" },
        { "value": "left", "label": "左" },
        { "value": "right", "label": "右" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "プラン（旧・後方互換用）",
      "settings": [
        { "type": "paragraph", "content": "⚠️ このブロック方式は、都市ごとに独立させられる新方式(Destinationの「plans」欄)に置き換わりました。新しい都市にはブロックではなくDestinationメタオブジェクトの「plans」欄をお使いください。このブロックは既存ページの後方互換のためだけに残しています。" },
        { "type": "product", "id": "product", "label": "商品" },
        { "type": "select", "id": "img_position", "label": "画像トリミング位置", "default": "",
          "options": [
            { "value": "", "label": "セクションの既定値を使う" },
            { "value": "top", "label": "上" },
            { "value": "center", "label": "中央" },
            { "value": "bottom", "label": "下" },
            { "value": "left", "label": "左" },
            { "value": "right", "label": "右" }
          ]
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [{ "name": "都市 プラン一覧" }]
}
{% endschema %}
