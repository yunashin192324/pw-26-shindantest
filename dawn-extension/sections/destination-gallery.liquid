{%- comment -%}
  destination-gallery — フォトギャラリー。Destination metaobjectの
  `gallery_images`（画像のリストフィールド）が未入力の間はセクションごと
  非表示になる。Metaobjectの「リスト」型フィールドはエントリー編集画面で
  複数枚まとめて選択・アップロードできるため、area-lp.liquidのように
  ブロックを1枚ずつ追加する必要がない。
{%- endcomment -%}
{%- assign destination = shop.metaobjects.destination.values | where: 'slug.value', page.handle | first -%}
{%- assign gallery_images = destination.gallery_images.value -%}

{%- if destination and gallery_images.size > 0 -%}
<section style="background-color:{{ section.settings.bg_color }};padding-top:64px;padding-bottom:64px;">
  <div class="dst-container">
    <div class="dst-section-head dst-reveal" style="color:{{ section.settings.heading_color }};">
      <p class="dst-eyebrow" style="color:{{ section.settings.eyebrow_color }};">{{ section.settings.eyebrow }}</p>
      <h2 style="color:{{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
      <hr class="dst-divider">
    </div>
    {%- capture gallery_img_style -%}object-position: {{ section.settings.img_position }};{%- endcapture -%}
    <div class="dst-gallery-grid">
      {%- for image in gallery_images -%}
        <div class="dst-gallery-item">
          {{ image | image_url: width: 700 | image_tag: class: 'dst-gallery-img', loading: 'lazy', style: gallery_img_style }}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "都市 フォトギャラリー",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "背景色", "default": "#1a1a1a" },
    { "type": "text", "id": "eyebrow", "label": "英字見出し", "default": "Gallery" },
    { "type": "color", "id": "eyebrow_color", "label": "英字見出し色", "default": "#c9a96e" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "フォトギャラリー" },
    { "type": "color", "id": "heading_color", "label": "見出し色", "default": "#ffffff" },
    { "type": "select", "id": "img_position", "label": "画像トリミング位置", "default": "center",
      "options": [
        { "value": "top", "label": "上" },
        { "value": "center", "label": "中央" },
        { "value": "bottom", "label": "下" }
      ]
    }
  ]
}
{% endschema %}
