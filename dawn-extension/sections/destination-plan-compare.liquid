{%- comment -%}
  destination-plan-compare — この都市のプラン比較表。
  ----------------------------------------------------------------
  destination-plans.liquidと同じ`destination.plans`(商品参照のリスト)を
  使い、その都市のプランを横並びの表で比較する。プランが2件以上ある
  都市だけ表示する(1件では比較にならないため)。

  従来のブロック方式(plan_blocks、例:ハワイ)には対応していない。
  比較表を使いたい都市は、先にdestination-plans.liquidと同じ`plans`
  フィールド方式に移行すること(8節6番、任意タスク参照)。

  各項目は商品のメタフィールド(custom.compare_*、すべて単一行テキスト・
  任意)から取得する。未入力の項目は「-」表示になるだけで表は崩れない。
  価格だけは商品自体の価格をそのまま使うので入力不要。
{%- endcomment -%}
{%- comment -%}
  where: 'slug.value', page.handle はこの環境ではネストしたプロパティの
  絞り込みが効かないことがあるため、確実に動く明示的なfor+ifに置き換え。
{%- endcomment -%}
{%- assign all_destination_entries = shop.metaobjects.destination.values -%}
{%- assign destination = blank -%}
{%- for d in all_destination_entries -%}
  {%- if d.slug.value == page.handle -%}{%- assign destination = d -%}{%- endif -%}
{%- endfor -%}

{%- assign plan_products = destination.plans.value -%}

{%- comment -%}
  【一時デバッグ】このセクション自体がページに追加されているか／
  compare_*メタフィールドの中身を確認用。原因が分かり次第削除します。
{%- endcomment -%}
<div style="border:3px solid blue; background:#fff; color:#000; padding:16px; margin:16px; font-family:monospace; font-size:13px; white-space:pre-wrap;">
【デバッグ】比較表セクションの判定結果
（この枠が見えている＝比較表セクション自体はページに追加されています）
page.handle = {{ page.handle }}
plan_products.size = {{ plan_products.size }}（2以上でないと表自体が出ません）
{%- for p in plan_products %}

商品: {{ p.title }}
  compare_data_count = "{{ p.metafields.custom.compare_data_count.value }}"
  compare_dress = "{{ p.metafields.custom.compare_dress.value }}"
  compare_hair_makeup = "{{ p.metafields.custom.compare_hair_makeup.value }}"
  compare_shooting_hours = "{{ p.metafields.custom.compare_shooting_hours.value }}"
  compare_location_count = "{{ p.metafields.custom.compare_location_count.value }}"
  compare_transfer = "{{ p.metafields.custom.compare_transfer.value }}"
  compare_japanese_assistant = "{{ p.metafields.custom.compare_japanese_assistant.value }}"
{%- endfor %}
</div>

{%- if plan_products.size > 1 -%}
<section{% if section.settings.bg_ivory %} class="dst-bg-ivory"{% endif %}>
  <div class="dst-container">
    <div class="dst-section-head dst-reveal">
      <p class="dst-eyebrow" style="color:{{ section.settings.eyebrow_color }};">{{ section.settings.eyebrow }}</p>
      <h2 style="color:{{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
      <hr class="dst-divider">
    </div>

    <p class="dst-compare-hint">{{ section.settings.scroll_hint_text | default: '→ 横にスワイプすると他のプランも見比べられます' }}</p>
    <div class="dst-compare-wrap">
    <div class="dst-compare-scroll">
      <table class="dst-compare-table">
        <thead>
          <tr>
            <th class="dst-compare-th-label"></th>
            {%- for p in plan_products -%}
              <th><a href="{{ p.url }}">{{ p.title }}</a></th>
            {%- endfor -%}
          </tr>
        </thead>
        <tbody>
          <tr>
            <th>価格</th>
            {%- for p in plan_products -%}
              {%- assign cp_variant = p.selected_or_first_available_variant -%}
              <td>
                {{ cp_variant.price | money }}
                {%- comment -%}
                  商品に複数バリアント（例：撮影年2026年/2027年）がある場合、
                  代表価格だけだと「どちらの年の価格か」が分からないため、
                  カッコ書きでバリアント名を添える(Default Titleの場合は
                  何も付けない＝バリアントが1種類の商品には影響なし)。
                {%- endcomment -%}
                {%- if cp_variant.title != blank and cp_variant.title != 'Default Title' -%}
                  <span class="dst-compare-price-variant">（{{ cp_variant.title }}）</span>
                {%- endif -%}
              </td>
            {%- endfor -%}
          </tr>
          <tr>
            <th>データ数</th>
            {%- for p in plan_products -%}
              <td>{{ p.metafields.custom.compare_data_count.value | default: '-' }}</td>
            {%- endfor -%}
          </tr>
          <tr>
            <th>ドレス</th>
            {%- for p in plan_products -%}
              <td>{{ p.metafields.custom.compare_dress.value | default: '-' }}</td>
            {%- endfor -%}
          </tr>
          <tr>
            <th>ヘアメイク</th>
            {%- for p in plan_products -%}
              <td>{{ p.metafields.custom.compare_hair_makeup.value | default: '-' }}</td>
            {%- endfor -%}
          </tr>
          <tr>
            <th>撮影時間</th>
            {%- for p in plan_products -%}
              <td>{{ p.metafields.custom.compare_shooting_hours.value | default: '-' }}</td>
            {%- endfor -%}
          </tr>
          <tr>
            <th>ロケ数</th>
            {%- for p in plan_products -%}
              <td>{{ p.metafields.custom.compare_location_count.value | default: '-' }}</td>
            {%- endfor -%}
          </tr>
          <tr>
            <th>送迎</th>
            {%- for p in plan_products -%}
              <td>{{ p.metafields.custom.compare_transfer.value | default: '-' }}</td>
            {%- endfor -%}
          </tr>
          <tr>
            <th>日本語アシスタント</th>
            {%- for p in plan_products -%}
              <td>{{ p.metafields.custom.compare_japanese_assistant.value | default: '-' }}</td>
            {%- endfor -%}
          </tr>
        </tbody>
      </table>
    </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "都市 プラン比較表",
  "settings": [
    { "type": "checkbox", "id": "bg_ivory", "label": "背景をアイボリーにする", "default": true },
    { "type": "text", "id": "eyebrow", "label": "英字見出し", "default": "COMPARE" },
    { "type": "color", "id": "eyebrow_color", "label": "英字見出し色", "default": "#c9a96e" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "プラン比較" },
    { "type": "color", "id": "heading_color", "label": "見出し色", "default": "#1a1a1a" },
    { "type": "text", "id": "scroll_hint_text", "label": "スマホ表示のスワイプ案内文言", "default": "→ 横にスワイプすると他のプランも見比べられます", "info": "スマホ幅の時だけ表内の上に表示されます。" }
  ],
  "presets": [{ "name": "都市 プラン比較表" }]
}
{% endschema %}
