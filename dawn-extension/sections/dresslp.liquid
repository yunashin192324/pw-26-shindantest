{% comment %}
  Shopify プロ仕様 LPビルダー（テーマ完全連動型・店舗自動エリア仕分け実装版）
{% endcomment %}

<script src="{{ 'tailwindcss.js' | asset_url }}" defer></script>
<script src="{{ 'lucide.min.js' | asset_url }}" defer></script>

<script>
/* Tailwind CSSのフォント設定をShopifyテーマの共通変数に連動させる */
tailwind.config = {
  theme: {
    extend: {
      colors: { ivory: '#FAF8F5', gold: '#B8860B', 'gold-light': '#D4A843' },
      fontFamily: {
        serif: ['var(--font-heading-family)', 'serif'],
        sans: ['var(--font-body-family)', 'sans-serif']
      }
    }
  }
}
</script>

<style>
  /* Shopifyテーマの基準サイズとフォントを適用 */
  .lp-container {
    font-family: var(--font-body-family), sans-serif;
    font-size: calc(var(--font-body-scale) * 100%);
  }
  .lp-container .font-serif {
    font-family: var(--font-heading-family), serif;
  }
  .divider-gold { width: 48px; height: 2px; background: #B8860B; margin: 16px auto;
  }
</style>

<div class="lp-container w-full min-h-screen bg-white text-gray-800 relative" style="background-color: {{ section.settings.bg_color }};">

  {% for block in section.blocks %}
    {% case block.type %}

      {% comment %} --- ヒーローセクション --- {% endcomment %}
      {% when 'hero' %}
      <section class="relative w-full pt-16 flex flex-col justify-center items-center text-center" style="height: 70vh;"
        {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {% capture hero_img_style %}object-position: {{ block.settings.image_position }};{% endcapture %}
          {{ block.settings.image | image_url: width: 2000 | image_tag: class: 'absolute inset-0 w-full h-full object-cover', style: hero_img_style, alt: block.settings.title }}
        {% else %}
          <div class="absolute inset-0 w-full h-full bg-gray-200"></div>
        {% endif %}
        <div class="absolute inset-0" style="background-color: rgba(0,0,0,{{ block.settings.overlay_opacity | divided_by: 100.0 }});"></div>

        <div class="relative z-10 px-6 w-full max-w-4xl">
          <p class="font-serif tracking-widest uppercase mb-4" style="color: {{ block.settings.text_color }}; font-size: calc(var(--font-heading-scale) * {{ block.settings.sub_size }}px);">{{ block.settings.subtitle }}</p>
          <h1 class="font-serif font-light leading-tight mb-4" style="color: {{ block.settings.text_color }}; font-size: calc(var(--font-heading-scale) * {{ block.settings.title_size }}px);">{{ block.settings.title | newline_to_br }}</h1>
          <p class="font-light" style="color: {{ block.settings.text_color }}; font-size: calc(var(--font-body-scale) * {{ block.settings.desc_size }}px);">{{ block.settings.desc | newline_to_br }}</p>
        </div>
      </section>

      {% comment %} --- About (画像+テキスト) セクション --- {% endcomment %}
      {% when 'about' %}
      <section class="py-16 md:py-24" style="background-color: {{ block.settings.bg_color }};"
        {{ block.shopify_attributes }}>
        <div class="max-w-6xl mx-auto px-6">
          <div class="grid md:grid-cols-2 gap-10 items-center">
            <div class="w-full relative {% if block.settings.image_alignment == 'right' %}md:order-2{% endif %}" style="padding-top: 125%;">
              {% if block.settings.image != blank %}
                {% capture about_img_style %}object-position: {{ block.settings.image_position }};{% endcapture %}
                {{ block.settings.image | image_url: width: 1000 | image_tag: class: 'absolute top-0 left-0 w-full h-full object-cover rounded-lg shadow-lg', style: about_img_style, alt: 'About' }}
              {% else %}
                <div class="absolute top-0 left-0 w-full h-full bg-gray-200 rounded-lg shadow-lg"></div>
              {% endif %}
            </div>
            <div class="{% if block.settings.image_alignment == 'right' %}md:order-1{% endif %}">
              <p class="font-serif tracking-widest uppercase mb-2" style="color: {{ block.settings.sub_color }}; font-size: calc(var(--font-heading-scale) * {{ block.settings.sub_size }}px);">{{ block.settings.subtitle }}</p>
              <h2 class="font-medium leading-relaxed mb-3" style="color: {{ block.settings.title_color }}; font-size: calc(var(--font-heading-scale) * {{ block.settings.title_size }}px);">{{ block.settings.title | newline_to_br }}</h2>
              <div style="width: 48px; height: 2px; background: #B8860B; margin: 16px 0;"></div>
              <p class="text-sm leading-relaxed mt-4" style="color: {{ block.settings.desc_color }}; font-size: calc(var(--font-body-scale) * 14px);">{{ block.settings.desc | newline_to_br }}</p>
            </div>
          </div>
        </div>
      </section>

      {% comment %} --- 画像ギャラリー（2枚並び） + ボタン --- {% endcomment %}
      {% when 'gallery' %}
      <section class="py-16 md:py-24" style="background-color: {{ block.settings.bg_color }};"
        {{ block.shopify_attributes }}>
        <div class="max-w-6xl mx-auto px-6">

          {% if block.settings.title != blank or block.settings.subtitle != blank %}
          <div class="text-center mb-16">
            {% if block.settings.subtitle != blank %}
            <p class="font-serif tracking-widest uppercase mb-2" style="color: {{ block.settings.sub_color }}; font-size: calc(var(--font-heading-scale) * {{ block.settings.sub_size }}px);">{{ block.settings.subtitle }}</p>
            {% endif %}
            {% if block.settings.title != blank %}
            <h2 class="font-medium" style="color: {{ block.settings.title_color }}; font-size: calc(var(--font-heading-scale) * {{ block.settings.title_size }}px);">{{ block.settings.title | newline_to_br }}</h2>
            <div class="divider-gold"></div>
            {% endif %}
          </div>
          {% endif %}

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="w-full relative" style="padding-top: 125%;">
              {% if block.settings.image_1 != blank %}
                {% capture gallery_img_style_1 %}object-position: {{ block.settings.image_position_1 }};{% endcapture %}
                {{ block.settings.image_1 | image_url: width: 800 | image_tag: class: 'absolute top-0 left-0 w-full h-full object-cover rounded-lg', style: gallery_img_style_1, alt: 'Gallery 1' }}
              {% else %}
                <div class="absolute top-0 left-0 w-full h-full bg-gray-200 rounded-lg"></div>
              {% endif %}
            </div>
            <div class="w-full relative" style="padding-top: 125%;">
              {% if block.settings.image_2 != blank %}
                {% capture gallery_img_style_2 %}object-position: {{ block.settings.image_position_2 }};{% endcapture %}
                {{ block.settings.image_2 | image_url: width: 800 | image_tag: class: 'absolute top-0 left-0 w-full h-full object-cover rounded-lg', style: gallery_img_style_2, alt: 'Gallery 2' }}
              {% else %}
                <div class="absolute top-0 left-0 w-full h-full bg-gray-200 rounded-lg"></div>
              {% endif %}
            </div>
          </div>

          {% if block.settings.button_text != blank %}
          <div class="text-center mt-12">
            <a href="{{ block.settings.button_link }}" class="inline-block px-8 py-3 rounded-full font-medium text-sm transition hover:opacity-80" style="background-color: {{ block.settings.button_bg_color }}; color: {{ block.settings.button_text_color }};">
              {{ block.settings.button_text }}
            </a>
          </div>
          {% endif %}

        </div>
      </section>

      {% comment %} --- WHY IT MATTERS (3つの特徴) --- {% endcomment %}
      {% when 'features' %}
      <section class="py-16 md:py-24" style="background-color: {{ block.settings.bg_color }};"
        {{ block.shopify_attributes }}>
        <div class="max-w-6xl mx-auto px-6">
          <div class="text-center mb-16">
            <p class="font-serif tracking-widest uppercase mb-2" style="color: {{ block.settings.sub_color }}; font-size: calc(var(--font-heading-scale) * {{ block.settings.sub_size }}px);">{{ block.settings.subtitle }}</p>
            <h2 class="font-medium" style="color: {{ block.settings.title_color }}; font-size: calc(var(--font-heading-scale) * {{ block.settings.title_size }}px);">{{ block.settings.title | newline_to_br }}</h2>
            <div class="divider-gold"></div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-10 text-center">
            {% for i in (1..3) %}
              {% capture title_key %}item_title_{{ i }}{% endcapture %}
              {% capture desc_key %}item_desc_{{ i }}{% endcapture %}
              {% if block.settings[title_key] != blank %}
                <div>
                  <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-gold/10 flex items-center justify-center text-gold">
                     <span class="font-serif text-xl">{{ i }}</span>
                  </div>
                  <h3 class="font-bold mb-3" style="color: {{ block.settings.title_color }}; font-size: calc(var(--font-heading-scale) * 18px);">{{ block.settings[title_key] }}</h3>
                  <p class="leading-relaxed" style="color: {{ block.settings.desc_color }}; font-size: calc(var(--font-body-scale) * 14px);">{{ block.settings[desc_key] | newline_to_br }}</p>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </section>

      {% comment %} --- FLOW (4ステップ) --- {% endcomment %}
      {% when 'flow' %}
      <section class="py-16 md:py-24" style="background-color: {{ block.settings.bg_color }};" {{ block.shopify_attributes }}>
        <div class="max-w-6xl mx-auto px-6">
          <div class="text-center mb-16">
            <p class="font-serif tracking-widest uppercase mb-2" style="color: {{ block.settings.sub_color }}; font-size: calc(var(--font-heading-scale) * {{ block.settings.sub_size }}px);">{{ block.settings.subtitle }}</p>
            <h2 class="font-medium" style="color: {{ block.settings.title_color }}; font-size: calc(var(--font-heading-scale) * {{ block.settings.title_size }}px);">{{ block.settings.title | newline_to_br }}</h2>
            <div class="divider-gold"></div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
            {% for i in (1..4) %}
              {% capture title_key %}step_title_{{ i }}{% endcapture %}
              {% capture desc_key %}step_desc_{{ i }}{% endcapture %}
              {% if block.settings[title_key] != blank %}
                <div class="text-center">
                  <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-gold text-white flex items-center justify-center font-serif text-lg">{{ i }}</div>
                  <h4 class="font-bold mb-2" style="color: {{ block.settings.title_color }}; font-size: calc(var(--font-heading-scale) * 14px);">{{ block.settings[title_key] }}</h4>
                  <p class="leading-relaxed" style="color: {{ block.settings.desc_color }}; font-size: calc(var(--font-body-scale) * 12px);">{{ block.settings[desc_key] | newline_to_br }}</p>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </section>

      {% comment %} --- ▼ 店舗一覧 (SHOP LIST) 自動仕分け最適化セクション ▼ --- {% endcomment %}
      {% when 'shop_list' %}
      <section class="py-16 md:py-24" style="background-color: {{ block.settings.bg_color }};"
        {{ block.shopify_attributes }}>
        <div class="max-w-5xl mx-auto px-6">

          {% if block.settings.title != blank or block.settings.subtitle != blank %}
          <div class="text-center mb-16">
            {% if block.settings.subtitle != blank %}
            <p class="font-serif tracking-widest uppercase mb-2" style="color: {{ block.settings.sub_color }}; font-size: calc(var(--font-heading-scale) * {{ block.settings.sub_size }}px);">{{ block.settings.subtitle }}</p>
            {% endif %}
            {% if block.settings.title != blank %}
            <h2 class="font-medium" style="color: {{ block.settings.title_color }}; font-size: calc(var(--font-heading-scale) * {{ block.settings.title_size }}px);">{{ block.settings.title | newline_to_br }}</h2>
            <div class="divider-gold"></div>
            {% endif %}
          </div>
          {% endif %}

          <div class="hidden json-shop-source" data-block-id="{{ block.id }}">

            {% comment %} 画像付き店舗（上段3つ）の抽出元 {% endcomment %}
            {% for i in (1..3) %}
              {% assign img_key = 'image_' | append: i %}
              {% assign pos_key = 'image_position_' | append: i %}
              {% assign badge_key = 'badge_' | append: i %}
              {% assign name_key = 'name_' | append: i %}
              {% assign url_key = 'url_' | append: i %}

              {% if block.settings[name_key] != blank %}
                <div class="raw-shop-card" data-badge="{{ block.settings[badge_key] | escape }}" data-type="featured">
                  <a href="{{ block.settings[url_key] | default: '#' }}" class="group block">
                    <div class="w-full relative aspect-[4/3] overflow-hidden mb-4 rounded-md">
                      {% if block.settings[img_key] != blank %}
                        {% capture shop_img_style %}object-position: {{ block.settings[pos_key] }};{% endcapture %}
                        {{ block.settings[img_key] | image_url: width: 800 | image_tag: class: 'absolute top-0 left-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105', style: shop_img_style, alt: block.settings[name_key] }}
                      {% else %}
                        <div class="absolute top-0 left-0 w-full h-full bg-gray-200 rounded-md"></div>
                      {% endif %}
                    </div>
                    <div class="flex flex-col items-start gap-2">
                      {% if block.settings[badge_key] != blank %}
                        <span class="inline-block px-3 py-1 text-[11px] font-bold text-white tracking-wider rounded-sm" style="background-color: {{ block.settings.badge_bg_color | default: '#C9A96E' }};">{{ block.settings[badge_key] }}</span>
                      {% endif %}
                      <h3 class="font-bold text-[16px]" style="color: {{ block.settings.title_color }};">{{ block.settings[name_key] }}</h3>
                    </div>
                  </a>
                </div>
              {% endif %}
            {% endfor %}

            {% comment %} 画像なし店舗（下段9つ）の抽出元 {% endcomment %}
            {% for i in (1..9) %}
              {% assign simple_badge_key = 'simple_badge_' | append: i %}
              {% assign simple_name_key = 'simple_name_' | append: i %}
              {% assign simple_url_key = 'simple_url_' | append: i %}

              {% if block.settings[simple_name_key] != blank %}
                <div class="raw-shop-card" data-badge="{{ block.settings[simple_badge_key] | escape }}" data-type="simple">
                  <a href="{{ block.settings[simple_url_key] | default: '#' }}" class="group flex items-center gap-3 border-b border-gray-200 pb-3 transition-colors hover:border-[#B8860B] w-full">
                    {% if block.settings[simple_badge_key] != blank %}
                      <span class="inline-block px-3 py-1 text-[11px] font-bold text-white tracking-wider shrink-0 rounded-sm" style="background-color: {{ block.settings.badge_bg_color | default: '#C9A96E' }};">{{ block.settings[simple_badge_key] }}</span>
                    {% endif %}
                    <h3 class="font-bold text-[15px] flex-1 transition-colors group-hover:text-[#B8860B]" style="color: {{ block.settings.title_color }};">{{ block.settings[simple_name_key] }}</h3>
                  </a>
                </div>
              {% endif %}
            {% endfor %}
          </div>

          <div id="dynamicShopTarget-{{ block.id }}" class="space-y-16">
            <div class="text-center py-10 text-gray-400 text-sm">店舗一覧を読み込み中...</div>
          </div>

        </div>
      </section>
      {% comment %} --- ▲ 店舗一覧セクション ▲ --- {% endcomment %}

      {% comment %} --- 診断・CTAブロック --- {% endcomment %}
      {% if block.type == 'cta' %}
      <section class="py-20 text-center" style="background-color: {{ block.settings.bg_color }};"
        {{ block.shopify_attributes }}>
        <div class="max-w-4xl mx-auto px-6">
          <p class="font-serif tracking-widest uppercase mb-3" style="color: {{ block.settings.sub_color }}; font-size: calc(var(--font-heading-scale) * {{ block.settings.sub_size }}px);">{{ block.settings.subtitle }}</p>
          <h2 class="font-medium mb-6" style="color: {{ block.settings.title_color }}; font-size: calc(var(--font-heading-scale) * {{ block.settings.title_size }}px);">{{ block.settings.title | newline_to_br }}</h2>
          <p class="mb-10 leading-relaxed" style="color: {{ block.settings.desc_color }}; font-size: calc(var(--font-body-scale) * 16px);">{{ block.settings.desc | newline_to_br }}</p>
          {% if block.settings.button_text != blank %}
            <a href="{{ block.settings.button_link }}" class="inline-block px-12 py-4 rounded-full font-bold text-lg transition hover:opacity-80 shadow-lg hover:scale-105 transform duration-300" style="background-color: {{ block.settings.button_bg_color }}; color: {{ block.settings.button_text_color }};">
              {{ block.settings.button_text }}
            </a>
          {% endif %}
        </div>
      </section>
      {% endif %}

    {% endcase %}
  {% endfor %}

  {% comment %} --- フローティングボタン --- {% endcomment %}
  {% if section.settings.show_floating_btn %}
  <div class="fixed bottom-6 right-6 md:bottom-10 md:right-10 z-50">
    <a href="{{ section.settings.floating_btn_link }}" class="flex items-center justify-center px-6 py-4 rounded-full shadow-2xl hover:scale-105 transition-transform duration-300" style="background-color: {{ section.settings.floating_btn_bg }}; color: {{ section.settings.floating_btn_color }};">
      <span class="font-bold text-sm md:text-base">{{ section.settings.floating_btn_text }}</span>
    </a>
  </div>
  {% endif %}

</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.json-shop-source').forEach(sourceContainer => {
    const blockId = sourceContainer.getAttribute('data-block-id');
    const targetContainer = document.getElementById('dynamicShopTarget-' + blockId);
    if (!targetContainer) return;
    const rawCards = sourceContainer.querySelectorAll('.raw-shop-card');

    // 日本の主要エリア判定キーワードの定義
    const kantoKeywords = ['東京', '神奈川', '埼玉', '千葉', '茨城', '栃木', '群馬', '山梨', '新宿', '横浜', '立川', '大宮', '池袋', '千葉', '上野', '吉祥寺', '渋谷'];
    const kansaiKeywords = ['大阪', '京都', '兵庫', '滋賀', '奈良', '和歌山', '梅田', '心斎橋', 'なんば', '三宮', '河原町'];

    const kantoFeatured = [];
    const kantoSimple = [];
    const kansaiFeatured = [];
    const kansaiSimple = [];
    const otherFeatured = [];
    const otherSimple = [];
    // すべての生データを1件ずつスキャンして地域ごとにメモリ内へ格納
    rawCards.forEach(card => {
      const badgeText = card.getAttribute('data-badge') || '';
      const type = card.getAttribute('data-type');
      const htmlContent = card.innerHTML;

      let area = 'other';
      if (kantoKeywords.some(kw => badgeText.includes(kw))) {
        area = 'kanto';
      } else if (kansaiKeywords.some(kw => badgeText.includes(kw))) {
        area = 'kansai';
      }

      if (area === 'kanto') {
        if (type === 'featured') kantoFeatured.push(htmlContent);
        else kantoSimple.push(htmlContent);
      } else if (area === 'kansai') {
        if (type === 'featured') kansaiFeatured.push(htmlContent);
        else kansaiSimple.push(htmlContent);
      } else {
        if (type === 'featured') otherFeatured.push(htmlContent);
        else otherSimple.push(htmlContent);
      }
    });
    // 各エリアセクションを美しく組み立てるレンダラー関数
    function generateAreaSectionHtml(areaTitle, featuredArray, simpleArray) {
      if (featuredArray.length === 0 && simpleArray.length === 0) return '';
      let html = `<div class="shop-area-block mb-14 last:mb-0">
        <div class="flex items-center gap-4 mb-8">
          <span class="font-serif text-sm tracking-[0.2em] text-gold font-bold uppercase shrink-0">${areaTitle}</span>
          <div class="h-[1px] bg-gray-200 flex-1"></div>
        </div>`;
      // 画像あり店舗が存在する場合
      if (featuredArray.length > 0) {
        html += `<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">`;
        featuredArray.forEach(cardHtml => { html += cardHtml; });
        html += `</div>`;
      }

      // 上段と下段の間に自然な区切り線を挿入
      if (featuredArray.length > 0 && simpleArray.length > 0) {
        html += `<div class="h-[1px] bg-gray-100 my-6"></div>`;
      }

      // 画像なし店舗が存在する場合
      if (simpleArray.length > 0) {
        html += `<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-6">`;
        simpleArray.forEach(cardHtml => { html += cardHtml; });
        html += `</div>`;
      }

      html += `</div>`;
      return html;
    }

    // 各地域セクションを結合
    let finalShopHtml = '';
    finalShopHtml += generateAreaSectionHtml('関東エリア', kantoFeatured, kantoSimple);
    finalShopHtml += generateAreaSectionHtml('関西エリア', kansaiFeatured, kansaiSimple);
    finalShopHtml += generateAreaSectionHtml('その他エリア', otherFeatured, otherSimple);
    // データが1件もない場合の例外処理
    if (finalShopHtml === '') {
      finalShopHtml = `<div class="text-center py-10 text-gray-400 text-sm">現在、登録されている店舗はございません。</div>`;
    }

    // 構築した完璧なHTMLコンポーネントを一気に出力先へ反映
    targetContainer.innerHTML = finalShopHtml;
  });
});
</script>

{% schema %}
{
  "name": "カスタムLPビルダー",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "全体の背景色",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "フローティング（追従）ボタン"
    },
    {
      "type": "checkbox",
      "id": "show_floating_btn",
      "label": "フローティングボタンを表示する",
      "default": true
    },
    {
      "type": "text",
      "id": "floating_btn_text",
      "label": "ボタンテキスト",
      "default": "✨ ドレス診断をする"
    },
    {
      "type": "url",
      "id": "floating_btn_link",
      "label": "ボタンのリンク先"
    },
    {
      "type": "color",
      "id": "floating_btn_bg",
      "label": "ボタン背景色",
      "default": "#B8860B"
    },
    {
      "type": "color",
      "id": "floating_btn_color",
      "label": "ボタン文字色",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "hero",
      "name": "ヒーロー画像",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "背景画像" },
        { "type": "select", "id": "image_position", "label": "画像の焦点", "options": [
            { "value": "center", "label": "中央" }, { "value": "top", "label": "上部" }, { "value": "bottom", "label": "下部" }, { "value": "left", "label": "左寄せ" }, { "value": "right", "label": "右寄せ" }
          ], "default": "center" },
        { "type": "range", "id": "overlay_opacity", "min": 0, "max": 100, "step": 10, "label": "暗さ", "default": 40 },
        { "type": "color", "id": "text_color", "label": "文字色", "default": "#ffffff" },
        { "type": "text", "id": "subtitle", "label": "サブタイトル", "default": "NEW COLLECTION" },
