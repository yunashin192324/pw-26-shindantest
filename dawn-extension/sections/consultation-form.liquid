{%- comment -%}
  consultation-form — オンライン相談ページ本体。
  ----------------------------------------------------------------
  Shopify標準のcontact formを使うため、アプリや外部サーバーの追加実装は
  不要(送信内容はストアの管理者メールアドレスに届く)。

  見出し・説明文・各入力欄のラベル・注意書き・ボタン文言はすべてテーマ
  エディタのセクション設定から変更できる(コードを触らずに文言を差し替え可能)。

  「ご希望の方面」欄は撮影地(Destination)metaobjectの一覧から自動生成される。
  都市を追加すればここにも自動で反映される。

  consultation-chat.liquidやcampaign-banner.liquidの「オンライン相談
  はこちら」のリンク先に、このセクションを使ったページのURLを設定する。
{%- endcomment -%}
<script>
  if (!document.getElementById('tw-config')) {
    var twConfig = document.createElement('script');
    twConfig.id = 'tw-config';
    twConfig.innerHTML = "tailwind.config = { theme: { extend: { colors: { ivory: '#FAF8F5', gold: '#B8860B', 'gold-light': '#D4A843', dark: '#1a1a1a' }, fontFamily: { serif: ['var(--font-heading-family, serif)', 'serif'], sans: ['var(--font-body-family, sans-serif)', 'sans-serif'] } } } };";
    document.head.appendChild(twConfig);
  }
  if (!document.getElementById('tw-cdn')) {
    var twScript = document.createElement('script');
    twScript.id = 'tw-cdn';
    twScript.src = '{{ "tailwind-3.4.17.js" | asset_url }}';
    document.head.appendChild(twScript);
  }
</script>

<div class="w-full" style="background:#FAF8F5;">
  <section class="py-16 md:py-24 px-4">
    <div class="max-w-xl mx-auto bg-white rounded-lg shadow-sm p-8 md:p-12">
      <div class="text-center mb-10">
        {%- if section.settings.eyebrow != blank -%}
          <p class="font-serif italic tracking-widest uppercase mb-3 text-sm" style="color:#B8860B;">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h1 class="font-medium mb-4" style="font-size: calc(var(--font-heading-scale, 1) * 30px);">{{ section.settings.heading }}</h1>
        <div class="divider-gold" style="width:48px;height:2px;background:#B8860B;margin:0 auto 20px;"></div>
        {%- if section.settings.description != blank -%}
          <p class="text-sm text-gray-600 leading-relaxed">{{ section.settings.description | newline_to_br }}</p>
        {%- endif -%}
      </div>

      {%- assign consultation_form_id = 'consultation-form-' | append: section.id -%}
      {%- form 'contact', id: consultation_form_id -%}
        <input type="hidden" name="contact[お問い合わせ種別]" value="{{ section.settings.inquiry_type_label | default: 'オンライン相談' }}">

        {%- if form.posted_successfully? -%}
          <div class="text-center py-10">
            <p class="text-base font-medium mb-2" style="color:#B8860B;">{{ section.settings.success_message | default: 'お問い合わせありがとうございます。担当より折り返しご連絡いたします。' }}</p>
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="mb-6 text-sm" style="color:#c0392b;">
              <p>{{ form.errors.translated_default.name }}</p>
            </div>
          {%- endif -%}

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
            <div>
              <label class="block text-xs font-medium mb-2 text-gray-700">{{ section.settings.name_label | default: 'お名前' }} <span style="color:#B8860B;">*</span></label>
              <input type="text" name="contact[name]" required
                placeholder="{{ section.settings.name_placeholder | default: '例：山田太郎' }}"
                value="{% if customer %}{{ customer.name }}{% endif %}"
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
            </div>
            <div>
              <label class="block text-xs font-medium mb-2 text-gray-700">{{ section.settings.furigana_label | default: 'ふりがな' }}</label>
              <input type="text" name="contact[ふりがな]"
                placeholder="{{ section.settings.furigana_placeholder | default: '例：やまだたろう' }}"
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
            <div>
              <label class="block text-xs font-medium mb-2 text-gray-700">{{ section.settings.email_label | default: 'メールアドレス' }} <span style="color:#B8860B;">*</span></label>
              <input type="email" name="contact[email]" required
                placeholder="{{ section.settings.email_placeholder | default: '例：info@example.com' }}"
                value="{% if customer %}{{ customer.email }}{% endif %}"
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
            </div>
            <div>
              <label class="block text-xs font-medium mb-2 text-gray-700">{{ section.settings.phone_label | default: '電話番号' }}</label>
              <input type="tel" name="contact[電話番号]"
                placeholder="{{ section.settings.phone_placeholder | default: '例：090-1234-5678' }}"
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
            </div>
          </div>

          <div class="mb-5">
            <label class="block text-xs font-medium mb-2 text-gray-700">{{ section.settings.desired_date_label | default: 'ご相談希望日' }}</label>
            {%- if section.settings.desired_date_note != blank -%}
              <p class="text-xs text-gray-400 mb-2">{{ section.settings.desired_date_note }}</p>
            {%- endif -%}
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
              <div>
                <label class="block text-[11px] text-gray-500 mb-1">第一希望</label>
                <input type="date" name="contact[ご相談希望日（第一希望）]" class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
              </div>
              <div>
                <label class="block text-[11px] text-gray-500 mb-1">第二希望</label>
                <input type="date" name="contact[ご相談希望日（第二希望）]" class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
              </div>
              <div>
                <label class="block text-[11px] text-gray-500 mb-1">第三希望</label>
                <input type="date" name="contact[ご相談希望日（第三希望）]" class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
              </div>
            </div>
          </div>

          {%- if section.settings.show_time_preference -%}
          <div class="mb-5">
            <label class="block text-xs font-medium mb-2 text-gray-700">{{ section.settings.time_preference_label | default: 'ご希望の時間帯' }}</label>
            <select name="contact[ご希望の時間帯]" class="w-full border border-gray-300 rounded px-3 py-2 text-sm bg-white">
              <option value="">選択してください</option>
              <option value="{{ section.settings.time_preference_option_am | default: '午前' }}">{{ section.settings.time_preference_option_am | default: '午前' }}</option>
              <option value="{{ section.settings.time_preference_option_pm | default: '午後' }}">{{ section.settings.time_preference_option_pm | default: '午後' }}</option>
              <option value="{{ section.settings.time_preference_option_either | default: 'どちらでも' }}">{{ section.settings.time_preference_option_either | default: 'どちらでも' }}</option>
            </select>
          </div>
          {%- endif -%}

          <div class="mb-5">
            <label class="block text-xs font-medium mb-2 text-gray-700">{{ section.settings.schedule_label | default: 'ご結婚式・撮影のご予定時期' }}</label>
            <div class="grid grid-cols-2 gap-3">
              <select name="contact[予定時期（年）]" class="w-full border border-gray-300 rounded px-3 py-2 text-sm bg-white">
                <option value="">年を選択</option>
                {%- assign schedule_year_start = 'now' | date: '%Y' | plus: 0 -%}
                {%- for i in (0..5) -%}
                  {%- assign schedule_year = schedule_year_start | plus: i -%}
                  <option value="{{ schedule_year }}年">{{ schedule_year }}年</option>
                {%- endfor -%}
                <option value="未定">未定</option>
              </select>
              <select name="contact[予定時期（月）]" class="w-full border border-gray-300 rounded px-3 py-2 text-sm bg-white">
                <option value="">月を選択</option>
                {%- for m in (1..12) -%}
                  <option value="{{ m }}月">{{ m }}月</option>
                {%- endfor -%}
                <option value="未定">未定</option>
              </select>
            </div>
          </div>

          <div class="mb-5">
            <label class="block text-xs font-medium mb-2 text-gray-700">{{ section.settings.region_label | default: 'ご希望の方面' }}</label>
            <select name="contact[ご希望の方面]" class="w-full border border-gray-300 rounded px-3 py-2 text-sm bg-white">
              <option value="">{{ section.settings.region_placeholder | default: '選択してください' }}</option>
              {%- assign region_destinations = shop.metaobjects.destination.values -%}
              {%- for d in region_destinations -%}
                <option value="{{ d.name_ja.value }}">{{ d.name_ja.value }}</option>
              {%- endfor -%}
              <option value="{{ section.settings.region_undecided_label | default: '未定・相談したい' }}">{{ section.settings.region_undecided_label | default: '未定・相談したい' }}</option>
            </select>
          </div>

          <div class="mb-6">
            <label class="block text-xs font-medium mb-2 text-gray-700">{{ section.settings.remarks_label | default: '備考' }}</label>
            <textarea name="contact[body]" rows="6"
              placeholder="{{ section.settings.remarks_placeholder | default: 'ご質問・ご要望などをご入力ください。' }}"
              class="w-full border border-gray-300 rounded px-3 py-2 text-sm"></textarea>
          </div>

          {%- if section.settings.disclaimer_text != blank -%}
            <div class="text-xs text-gray-500 leading-relaxed mb-8 pt-6" style="border-top:1px solid #eee;">
              {{ section.settings.disclaimer_text | newline_to_br }}
              {%- if section.settings.privacy_policy_url != blank -%}
                <br>
                <a href="{{ section.settings.privacy_policy_url }}" class="underline" style="color:#B8860B;">{{ section.settings.privacy_policy_label | default: 'プライバシーポリシー' }}</a>
              {%- endif -%}
            </div>
          {%- endif -%}

          <div class="text-center">
            <button type="submit" class="inline-block px-12 py-3 rounded-full font-medium text-sm text-white transition hover:opacity-80" style="background-color:#B8860B;">
              {{ section.settings.submit_label | default: '送信する' }}
            </button>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "オンライン相談フォーム",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "英字見出し", "default": "Contact" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "オンライン相談" },
    { "type": "textarea", "id": "description", "label": "説明文", "default": "撮影地選びやプランについて、専門スタッフがオンラインでご相談に応じます。まずはお気軽にお問い合わせください。" },
    { "type": "text", "id": "inquiry_type_label", "label": "お問い合わせ種別(管理画面の受信メールで見分けるためのラベル)", "default": "オンライン相談" },
    { "type": "header", "content": "入力欄の文言" },
    { "type": "text", "id": "name_label", "label": "お名前 ラベル", "default": "お名前" },
    { "type": "text", "id": "name_placeholder", "label": "お名前 プレースホルダー", "default": "例：山田太郎" },
    { "type": "text", "id": "furigana_label", "label": "ふりがな ラベル", "default": "ふりがな" },
    { "type": "text", "id": "furigana_placeholder", "label": "ふりがな プレースホルダー", "default": "例：やまだたろう" },
    { "type": "text", "id": "email_label", "label": "メールアドレス ラベル", "default": "メールアドレス" },
    { "type": "text", "id": "email_placeholder", "label": "メールアドレス プレースホルダー", "default": "例：info@example.com" },
    { "type": "text", "id": "phone_label", "label": "電話番号 ラベル", "default": "電話番号" },
    { "type": "text", "id": "phone_placeholder", "label": "電話番号 プレースホルダー", "default": "例：090-1234-5678" },
    { "type": "text", "id": "desired_date_label", "label": "ご相談希望日 ラベル", "default": "ご相談希望日" },
    { "type": "text", "id": "desired_date_note", "label": "ご相談希望日 補足文", "default": "第一希望のみのご入力でも構いません。" },
    { "type": "header", "content": "ご希望の時間帯" },
    { "type": "checkbox", "id": "show_time_preference", "label": "ご希望の時間帯欄を表示する", "default": true },
    { "type": "text", "id": "time_preference_label", "label": "ご希望の時間帯 ラベル", "default": "ご希望の時間帯" },
    { "type": "text", "id": "time_preference_option_am", "label": "選択肢1", "default": "午前" },
    { "type": "text", "id": "time_preference_option_pm", "label": "選択肢2", "default": "午後" },
    { "type": "text", "id": "time_preference_option_either", "label": "選択肢3", "default": "どちらでも" },
    { "type": "header", "content": "ご予定時期・ご希望の方面" },
    { "type": "text", "id": "schedule_label", "label": "ご予定時期 ラベル", "default": "ご結婚式・撮影のご予定時期" },
    { "type": "text", "id": "region_label", "label": "ご希望の方面 ラベル", "default": "ご希望の方面" },
    { "type": "text", "id": "region_placeholder", "label": "ご希望の方面 未選択時の表示文言", "default": "選択してください" },
    { "type": "text", "id": "region_undecided_label", "label": "ご希望の方面 「未定」の選択肢文言", "default": "未定・相談したい", "info": "撮影地(Destination)の一覧はmetaobjectから自動で読み込まれます。都市を追加すればここにも自動で反映されます。" },
    { "type": "header", "content": "備考" },
    { "type": "text", "id": "remarks_label", "label": "備考 ラベル", "default": "備考" },
    { "type": "text", "id": "remarks_placeholder", "label": "備考 プレースホルダー", "default": "ご質問・ご要望などをご入力ください。" },
    { "type": "header", "content": "注意書き・送信ボタン" },
    { "type": "textarea", "id": "disclaimer_text", "label": "注意書き",
      "default": "お客様のご対応は、原則としてお申込みまたはお問い合わせ順とさせていただきます。\nご返信には数日お時間をいただく場合がございます。あらかじめご了承ください。" },
    { "type": "text", "id": "privacy_policy_label", "label": "プライバシーポリシー リンク文言", "default": "プライバシーポリシー" },
    { "type": "url", "id": "privacy_policy_url", "label": "プライバシーポリシー リンク先" },
    { "type": "text", "id": "submit_label", "label": "送信ボタン文言", "default": "送信する" },
    { "type": "textarea", "id": "success_message", "label": "送信完了メッセージ", "default": "お問い合わせありがとうございます。担当より折り返しご連絡いたします。" }
  ],
  "presets": [{ "name": "オンライン相談フォーム" }]
}
{% endschema %}
