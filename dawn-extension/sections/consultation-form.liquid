{%- comment -%}
  consultation-form — オンライン相談ページ本体。
  ----------------------------------------------------------------
  Shopify標準のcontact formを使うため、アプリや外部サーバーの追加実装は
  不要(送信内容はストアの管理者メールアドレスに届く)。

  各入力欄は「表示/非表示」「必須/任意」「ラベル文言」をすべてテーマ
  エディタのセクション設定から変更できる(コードを触らずに調整可能)。
  ※お名前・メールアドレス・電話番号・備考の4項目はShopify側で特別に
  認識される予約キー(name/email/phone/body)のため、送信データの
  キー名は固定。それ以外の項目はラベル文言をそのまま送信データの
  キー名としても使うため、ラベルを変えると通知メール上の項目名も
  連動して変わる。

  「ご希望の方面」欄は撮影地(Destination)metaobjectの一覧から自動生成
  される。都市を追加すればここにも自動で反映される。

  consultation-chat.liquidやcampaign-banner.liquidの「オンライン相談
  はこちら」のリンク先に、このセクションを使ったページのURLを設定する。
{%- endcomment -%}
<script>
  if (!document.getElementById('tw-config')) {
    var twConfig = document.createElement('script');
    twConfig.id = 'tw-config';
    twConfig.innerHTML = "tailwind.config = { theme: { extend: { colors: { ivory: '#FAF8F5', gold: '#B8860B', 'gold-light': '#D4A843', dark: '#1a1a1a' }, fontFamily: { serif: ['var(--font-heading-family, serif)', 'serif'], sans: ['var(--font-body-family, sans-serif)', 'sans-serif'] } } } };";
    document.head.appendChild(twConfig);
  }
  if (!document.getElementById('tw-cdn')) {
    var twScript = document.createElement('script');
    twScript.id = 'tw-cdn';
    twScript.src = '{{ "tailwind-3.4.17.js" | asset_url }}';
    document.head.appendChild(twScript);
  }
</script>

{%- assign name_label = section.settings.name_label | default: 'お名前' -%}
{%- assign furigana_label = section.settings.furigana_label | default: 'ふりがな' -%}
{%- assign email_label = section.settings.email_label | default: 'メールアドレス' -%}
{%- assign phone_label = section.settings.phone_label | default: '電話番号' -%}
{%- assign desired_date_label = section.settings.desired_date_label | default: 'ご相談希望日' -%}
{%- assign desired_date_option1_label = section.settings.desired_date_option1_label | default: '第一希望' -%}
{%- assign desired_date_option2_label = section.settings.desired_date_option2_label | default: '第二希望' -%}
{%- assign desired_date_option3_label = section.settings.desired_date_option3_label | default: '第三希望' -%}
{%- assign time_preference_label = section.settings.time_preference_label | default: 'ご希望の時間帯' -%}
{%- assign schedule_label = section.settings.schedule_label | default: 'ご結婚式・撮影のご予定時期' -%}
{%- assign region_label = section.settings.region_label | default: 'ご希望の方面' -%}
{%- assign remarks_label = section.settings.remarks_label | default: '備考' -%}

<div class="w-full" style="background:#FAF8F5;">
  <section class="py-16 md:py-24 px-4">
    <div class="max-w-xl mx-auto bg-white rounded-lg shadow-sm p-8 md:p-12">
      <div class="text-center mb-10">
        {%- if section.settings.eyebrow != blank -%}
          <p class="font-serif italic tracking-widest uppercase mb-3 text-sm" style="color:#B8860B;">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h1 class="font-medium mb-4" style="font-size: calc(var(--font-heading-scale, 1) * 30px);">{{ section.settings.heading }}</h1>
        <div class="divider-gold" style="width:48px;height:2px;background:#B8860B;margin:0 auto 20px;"></div>
        {%- if section.settings.description != blank -%}
          <p class="text-sm text-gray-600 leading-relaxed">{{ section.settings.description | newline_to_br }}</p>
        {%- endif -%}
      </div>

      {%- assign consultation_form_id = 'consultation-form-' | append: section.id -%}
      {%- form 'contact', id: consultation_form_id -%}
        <input type="hidden" name="contact[お問い合わせ種別]" value="{{ section.settings.inquiry_type_label | default: 'オンライン相談' }}">

        {%- if form.posted_successfully? -%}
          <div class="text-center py-10">
            <p class="text-base font-medium mb-2" style="color:#B8860B;">{{ section.settings.success_message | default: 'お問い合わせありがとうございます。担当より折り返しご連絡いたします。' }}</p>
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="mb-6 text-sm" style="color:#c0392b;">
              <p>{{ form.errors.translated_default.name }}</p>
            </div>
          {%- endif -%}

          {%- if section.settings.show_name or section.settings.show_furigana -%}
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
            {%- if section.settings.show_name -%}
            <div>
              <label class="block text-xs font-medium mb-2 text-gray-700">{{ name_label }} {%- if section.settings.require_name %} <span style="color:#B8860B;">*</span>{% endif %}</label>
              <input type="text" name="contact[name]" {% if section.settings.require_name %}required{% endif %}
                placeholder="{{ section.settings.name_placeholder | default: '例：山田太郎' }}"
                value="{% if customer %}{{ customer.name }}{% endif %}"
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
            </div>
            {%- endif -%}
            {%- if section.settings.show_furigana -%}
            <div>
              <label class="block text-xs font-medium mb-2 text-gray-700">{{ furigana_label }} {%- if section.settings.require_furigana %} <span style="color:#B8860B;">*</span>{% endif %}</label>
              <input type="text" name="contact[{{ furigana_label }}]" {% if section.settings.require_furigana %}required{% endif %}
                placeholder="{{ section.settings.furigana_placeholder | default: '例：やまだたろう' }}"
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
            </div>
            {%- endif -%}
          </div>
          {%- endif -%}

          {%- if section.settings.show_email or section.settings.show_phone -%}
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
            {%- if section.settings.show_email -%}
            <div>
              <label class="block text-xs font-medium mb-2 text-gray-700">{{ email_label }} {%- if section.settings.require_email %} <span style="color:#B8860B;">*</span>{% endif %}</label>
              <input type="email" name="contact[email]" {% if section.settings.require_email %}required{% endif %}
                placeholder="{{ section.settings.email_placeholder | default: '例：info@example.com' }}"
                value="{% if customer %}{{ customer.email }}{% endif %}"
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
            </div>
            {%- endif -%}
            {%- if section.settings.show_phone -%}
            <div>
              <label class="block text-xs font-medium mb-2 text-gray-700">{{ phone_label }} {%- if section.settings.require_phone %} <span style="color:#B8860B;">*</span>{% endif %}</label>
              <input type="tel" name="contact[phone]" {% if section.settings.require_phone %}required{% endif %}
                placeholder="{{ section.settings.phone_placeholder | default: '例：090-1234-5678' }}"
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
            </div>
            {%- endif -%}
          </div>
          {%- endif -%}

          {%- if section.settings.show_desired_date -%}
          <div class="mb-5">
            <label class="block text-xs font-medium mb-2 text-gray-700">{{ desired_date_label }} {%- if section.settings.require_desired_date %} <span style="color:#B8860B;">*</span>{% endif %}</label>
            {%- if section.settings.desired_date_note != blank -%}
              <p class="text-xs text-gray-400 mb-2">{{ section.settings.desired_date_note }}</p>
            {%- endif -%}
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
              <div>
                <label class="block text-[11px] text-gray-500 mb-1">{{ desired_date_option1_label }}</label>
                <input type="date" name="contact[{{ desired_date_label }}（{{ desired_date_option1_label }}）]" {% if section.settings.require_desired_date %}required{% endif %} class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
              </div>
              <div>
                <label class="block text-[11px] text-gray-500 mb-1">{{ desired_date_option2_label }}</label>
                <input type="date" name="contact[{{ desired_date_label }}（{{ desired_date_option2_label }}）]" class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
              </div>
              <div>
                <label class="block text-[11px] text-gray-500 mb-1">{{ desired_date_option3_label }}</label>
                <input type="date" name="contact[{{ desired_date_label }}（{{ desired_date_option3_label }}）]" class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
              </div>
            </div>
          </div>
          {%- endif -%}

          {%- if section.settings.show_time_preference -%}
          <div class="mb-5">
            <label class="block text-xs font-medium mb-2 text-gray-700">{{ time_preference_label }} {%- if section.settings.require_time_preference %} <span style="color:#B8860B;">*</span>{% endif %}</label>
            <select name="contact[{{ time_preference_label }}]" {% if section.settings.require_time_preference %}required{% endif %} class="w-full border border-gray-300 rounded px-3 py-2 text-sm bg-white">
              <option value="">選択してください</option>
              <option value="{{ section.settings.time_preference_option_am | default: '午前' }}">{{ section.settings.time_preference_option_am | default: '午前' }}</option>
              <option value="{{ section.settings.time_preference_option_pm | default: '午後' }}">{{ section.settings.time_preference_option_pm | default: '午後' }}</option>
              <option value="{{ section.settings.time_preference_option_either | default: 'どちらでも' }}">{{ section.settings.time_preference_option_either | default: 'どちらでも' }}</option>
            </select>
          </div>
          {%- endif -%}

          {%- if section.settings.show_schedule -%}
          <div class="mb-5">
            <label class="block text-xs font-medium mb-2 text-gray-700">{{ schedule_label }} {%- if section.settings.require_schedule %} <span style="color:#B8860B;">*</span>{% endif %}</label>
            <div class="grid grid-cols-2 gap-3">
              <select name="contact[{{ schedule_label }}（年）]" {% if section.settings.require_schedule %}required{% endif %} class="w-full border border-gray-300 rounded px-3 py-2 text-sm bg-white">
                <option value="">{{ section.settings.schedule_year_prompt | default: '年を選択' }}</option>
                {%- assign schedule_year_start = 'now' | date: '%Y' | plus: 0 -%}
                {%- for i in (0..5) -%}
                  {%- assign schedule_year = schedule_year_start | plus: i -%}
                  <option value="{{ schedule_year }}年">{{ schedule_year }}年</option>
                {%- endfor -%}
                <option value="未定">未定</option>
              </select>
              <select name="contact[{{ schedule_label }}（月）]" {% if section.settings.require_schedule %}required{% endif %} class="w-full border border-gray-300 rounded px-3 py-2 text-sm bg-white">
                <option value="">{{ section.settings.schedule_month_prompt | default: '月を選択' }}</option>
                {%- for m in (1..12) -%}
                  <option value="{{ m }}月">{{ m }}月</option>
                {%- endfor -%}
                <option value="未定">未定</option>
              </select>
            </div>
          </div>
          {%- endif -%}

          {%- if section.settings.show_region -%}
          <div class="mb-5">
            <label class="block text-xs font-medium mb-2 text-gray-700">{{ region_label }} {%- if section.settings.require_region %} <span style="color:#B8860B;">*</span>{% endif %}</label>
            <select name="contact[{{ region_label }}]" {% if section.settings.require_region %}required{% endif %} class="w-full border border-gray-300 rounded px-3 py-2 text-sm bg-white">
              <option value="">{{ section.settings.region_placeholder | default: '選択してください' }}</option>
              {%- assign region_destinations = shop.metaobjects.destination.values -%}
              {%- for d in region_destinations -%}
                <option value="{{ d.name_ja.value }}">{{ d.name_ja.value }}</option>
              {%- endfor -%}
              <option value="{{ section.settings.region_undecided_label | default: '未定・相談したい' }}">{{ section.settings.region_undecided_label | default: '未定・相談したい' }}</option>
            </select>
          </div>
          {%- endif -%}

          {%- if section.settings.show_remarks -%}
          <div class="mb-6">
            <label class="block text-xs font-medium mb-2 text-gray-700">{{ remarks_label }} {%- if section.settings.require_remarks %} <span style="color:#B8860B;">*</span>{% endif %}</label>
            <textarea name="contact[body]" {% if section.settings.require_remarks %}required{% endif %} rows="6"
              placeholder="{{ section.settings.remarks_placeholder | default: 'ご質問・ご要望などをご入力ください。' }}"
              class="w-full border border-gray-300 rounded px-3 py-2 text-sm"></textarea>
          </div>
          {%- endif -%}

          {%- if section.settings.disclaimer_text != blank -%}
            <div class="text-xs text-gray-500 leading-relaxed mb-8 pt-6" style="border-top:1px solid #eee;">
              {{ section.settings.disclaimer_text | newline_to_br }}
              {%- if section.settings.privacy_policy_url != blank -%}
                <br>
                <a href="{{ section.settings.privacy_policy_url }}" class="underline" style="color:#B8860B;">{{ section.settings.privacy_policy_label | default: 'プライバシーポリシー' }}</a>
              {%- endif -%}
            </div>
          {%- endif -%}

          <div class="text-center">
            <button type="submit" class="inline-block px-12 py-3 rounded-full font-medium text-sm text-white transition hover:opacity-80" style="background-color:#B8860B;">
              {{ section.settings.submit_label | default: '送信する' }}
            </button>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "オンライン相談フォーム",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "英字見出し", "default": "Contact" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "オンライン相談" },
    { "type": "textarea", "id": "description", "label": "説明文", "default": "撮影地選びやプランについて、専門スタッフがオンラインでご相談に応じます。まずはお気軽にお問い合わせください。" },
    { "type": "text", "id": "inquiry_type_label", "label": "お問い合わせ種別(管理画面の受信メールで見分けるためのラベル)", "default": "オンライン相談" },

    { "type": "header", "content": "お名前" },
    { "type": "checkbox", "id": "show_name", "label": "表示する", "default": true },
    { "type": "checkbox", "id": "require_name", "label": "必須にする", "default": true },
    { "type": "text", "id": "name_label", "label": "項目名", "default": "お名前" },
    { "type": "text", "id": "name_placeholder", "label": "プレースホルダー", "default": "例：山田太郎" },

    { "type": "header", "content": "ふりがな" },
    { "type": "checkbox", "id": "show_furigana", "label": "表示する", "default": true },
    { "type": "checkbox", "id": "require_furigana", "label": "必須にする", "default": false },
    { "type": "text", "id": "furigana_label", "label": "項目名", "default": "ふりがな" },
    { "type": "text", "id": "furigana_placeholder", "label": "プレースホルダー", "default": "例：やまだたろう" },

    { "type": "header", "content": "メールアドレス" },
    { "type": "checkbox", "id": "show_email", "label": "表示する", "default": true },
    { "type": "checkbox", "id": "require_email", "label": "必須にする", "default": true },
    { "type": "text", "id": "email_label", "label": "項目名", "default": "メールアドレス" },
    { "type": "text", "id": "email_placeholder", "label": "プレースホルダー", "default": "例：info@example.com" },

    { "type": "header", "content": "電話番号" },
    { "type": "checkbox", "id": "show_phone", "label": "表示する", "default": true },
    { "type": "checkbox", "id": "require_phone", "label": "必須にする", "default": false },
    { "type": "text", "id": "phone_label", "label": "項目名", "default": "電話番号" },
    { "type": "text", "id": "phone_placeholder", "label": "プレースホルダー", "default": "例：090-1234-5678" },

    { "type": "header", "content": "ご相談希望日" },
    { "type": "checkbox", "id": "show_desired_date", "label": "表示する", "default": true },
    { "type": "checkbox", "id": "require_desired_date", "label": "必須にする(第一希望のみ必須になります)", "default": false },
    { "type": "text", "id": "desired_date_label", "label": "項目名", "default": "ご相談希望日" },
    { "type": "text", "id": "desired_date_note", "label": "補足文", "default": "第一希望のみのご入力でも構いません。" },
    { "type": "text", "id": "desired_date_option1_label", "label": "1つ目の欄の名前", "default": "第一希望" },
    { "type": "text", "id": "desired_date_option2_label", "label": "2つ目の欄の名前", "default": "第二希望" },
    { "type": "text", "id": "desired_date_option3_label", "label": "3つ目の欄の名前", "default": "第三希望" },

    { "type": "header", "content": "ご希望の時間帯" },
    { "type": "checkbox", "id": "show_time_preference", "label": "表示する", "default": true },
    { "type": "checkbox", "id": "require_time_preference", "label": "必須にする", "default": false },
    { "type": "text", "id": "time_preference_label", "label": "項目名", "default": "ご希望の時間帯" },
    { "type": "text", "id": "time_preference_option_am", "label": "選択肢1", "default": "午前" },
    { "type": "text", "id": "time_preference_option_pm", "label": "選択肢2", "default": "午後" },
    { "type": "text", "id": "time_preference_option_either", "label": "選択肢3", "default": "どちらでも" },

    { "type": "header", "content": "ご予定時期" },
    { "type": "checkbox", "id": "show_schedule", "label": "表示する", "default": true },
    { "type": "checkbox", "id": "require_schedule", "label": "必須にする", "default": false },
    { "type": "text", "id": "schedule_label", "label": "項目名", "default": "ご結婚式・撮影のご予定時期" },
    { "type": "text", "id": "schedule_year_prompt", "label": "年プルダウンの未選択時の文言", "default": "年を選択" },
    { "type": "text", "id": "schedule_month_prompt", "label": "月プルダウンの未選択時の文言", "default": "月を選択" },

    { "type": "header", "content": "ご希望の方面" },
    { "type": "checkbox", "id": "show_region", "label": "表示する", "default": true },
    { "type": "checkbox", "id": "require_region", "label": "必須にする", "default": false },
    { "type": "text", "id": "region_label", "label": "項目名", "default": "ご希望の方面" },
    { "type": "text", "id": "region_placeholder", "label": "未選択時の文言", "default": "選択してください" },
    { "type": "text", "id": "region_undecided_label", "label": "「未定」の選択肢文言", "default": "未定・相談したい", "info": "撮影地(Destination)の一覧はmetaobjectから自動で読み込まれます。都市を追加すればここにも自動で反映されます。" },

    { "type": "header", "content": "備考" },
    { "type": "checkbox", "id": "show_remarks", "label": "表示する", "default": true },
    { "type": "checkbox", "id": "require_remarks", "label": "必須にする", "default": false },
    { "type": "text", "id": "remarks_label", "label": "項目名", "default": "備考" },
    { "type": "text", "id": "remarks_placeholder", "label": "プレースホルダー", "default": "ご質問・ご要望などをご入力ください。" },

    { "type": "header", "content": "注意書き・送信ボタン" },
    { "type": "textarea", "id": "disclaimer_text", "label": "注意書き",
      "default": "お客様のご対応は、原則としてお申込みまたはお問い合わせ順とさせていただきます。\nご返信には数日お時間をいただく場合がございます。あらかじめご了承ください。" },
    { "type": "text", "id": "privacy_policy_label", "label": "プライバシーポリシー リンク文言", "default": "プライバシーポリシー" },
    { "type": "url", "id": "privacy_policy_url", "label": "プライバシーポリシー リンク先" },
    { "type": "text", "id": "submit_label", "label": "送信ボタン文言", "default": "送信する" },
    { "type": "textarea", "id": "success_message", "label": "送信完了メッセージ", "default": "お問い合わせありがとうございます。担当より折り返しご連絡いたします。" }
  ],
  "presets": [{ "name": "オンライン相談フォーム" }]
}
{% endschema %}
