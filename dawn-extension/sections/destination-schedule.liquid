{%- comment -%}
  destination-schedule — モデルスケジュール。Destination metaobjectの
  `schedule`は「Schedule Item」metaobjectへの参照リスト型。各項目は
  time(単一行テキスト)/body(複数行テキスト)を持つ独立した
  metaobjectエントリーで、都市エントリーの編集画面のまま
  「新規作成」→時刻と内容をそれぞれの欄に入力、という流れで
  追加できる(｜区切りのテキストを手書きする必要がない)。
  未入力の間はセクションごと非表示になる。
{%- endcomment -%}
{%- comment -%}
  where: 'slug.value', page.handle はこの環境ではネストしたプロパティの
  絞り込みが効かないことがあるため、確実に動く明示的なfor+ifに置き換え。
{%- endcomment -%}
{%- assign all_destination_entries = shop.metaobjects.destination.values -%}
{%- assign destination = blank -%}
{%- for d in all_destination_entries -%}
  {%- if d.slug.value == page.handle -%}{%- assign destination = d -%}{%- endif -%}
{%- endfor -%}
{%- assign schedule_items = destination.schedule.value -%}

{%- if destination and schedule_items.size > 0 -%}
<section{% if section.settings.bg_ivory %} class="dst-bg-ivory"{% endif %}>
  <div class="dst-container" style="max-width:760px;">
    <div class="dst-section-head dst-reveal">
      <p class="dst-eyebrow" style="color:{{ section.settings.eyebrow_color }};">{{ section.settings.eyebrow }}</p>
      <h2 style="color:{{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
      <hr class="dst-divider">
    </div>
    <div class="dst-schedule-list">
      {%- for item in schedule_items -%}
        <div class="dst-schedule-item dst-reveal">
          <p class="dst-schedule-time">{{ item.time.value }}</p>
          <p class="dst-schedule-desc">{{ item.body.value }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "都市 モデルスケジュール",
  "settings": [
    { "type": "checkbox", "id": "bg_ivory", "label": "背景をアイボリーにする", "default": true },
    { "type": "text", "id": "eyebrow", "label": "英字見出し", "default": "Schedule" },
    { "type": "color", "id": "eyebrow_color", "label": "英字見出し色", "default": "#c9a96e" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "モデルスケジュール" },
    { "type": "color", "id": "heading_color", "label": "見出し色", "default": "#1a1a1a" }
  ]
}
{% endschema %}
