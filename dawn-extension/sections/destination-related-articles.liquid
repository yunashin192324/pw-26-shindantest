{%- comment -%}
  destination-related-articles — 都市ページに関連JOURNAL記事を自動表示。
  ----------------------------------------------------------------
  JOURNAL記事に、都市の日本語名(name_ja)と完全一致するタグを付けると、
  その都市ページに自動的に表示される(例：「ハワイ」というタグを付けた
  記事は、ハワイの都市ページに出る)。該当記事が1件も無い都市では
  セクションごと非表示になるので、タグ付けが済んでいない間は何も
  表示されず安全。

  対象ブログはsection.settings.blog_handleで指定(既定値: journal)。
{%- endcomment -%}
{%- assign all_destination_entries = shop.metaobjects.destination.values -%}
{%- assign destination = blank -%}
{%- for d in all_destination_entries -%}
  {%- if d.slug.value == page.handle -%}{%- assign destination = d -%}{%- endif -%}
{%- endfor -%}

{%- assign target_blog = blogs[section.settings.blog_handle] -%}
{%- assign related_count = 0 -%}
{%- capture related_html -%}
  {%- if destination and target_blog -%}
    {%- for article in target_blog.articles -%}
      {%- if related_count < 3 and article.tags contains destination.name_ja.value -%}
        <a href="{{ article.url }}" class="dst-article-card dst-reveal">
          {%- if article.image -%}
            <div class="dst-article-media">
              <img
                src="{{ article.image | image_url: width: 600 }}"
                srcset="{{ article.image | image_url: width: 400 }} 400w, {{ article.image | image_url: width: 600 }} 600w"
                sizes="(min-width: 760px) 33vw, 90vw"
                alt="{{ article.image.alt | default: article.title | escape }}"
                loading="lazy"
              >
            </div>
          {%- endif -%}
          <p class="dst-article-title">{{ article.title }}</p>
        </a>
        {%- assign related_count = related_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- if related_count > 0 -%}
<section{% if section.settings.bg_ivory %} class="dst-bg-ivory"{% endif %}>
  <div class="dst-container">
    <div class="dst-section-head dst-reveal">
      <p class="dst-eyebrow" style="color:{{ section.settings.eyebrow_color }};">{{ section.settings.eyebrow }}</p>
      <h2 style="color:{{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
      <hr class="dst-divider">
    </div>
    <div class="dst-region-grid">
      {{ related_html }}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "都市 関連記事",
  "settings": [
    { "type": "checkbox", "id": "bg_ivory", "label": "背景をアイボリーにする", "default": false },
    { "type": "text", "id": "blog_handle", "label": "対象ブログのハンドル", "default": "journal" },
    { "type": "text", "id": "eyebrow", "label": "英字見出し", "default": "JOURNAL" },
    { "type": "color", "id": "eyebrow_color", "label": "英字見出し色", "default": "#c9a96e" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "関連記事" },
    { "type": "color", "id": "heading_color", "label": "見出し色", "default": "#1a1a1a" }
  ],
  "presets": [{ "name": "都市 関連記事" }]
}
{% endschema %}
