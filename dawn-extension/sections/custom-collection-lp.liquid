{% comment %}
  Shopify プロ仕様 コレクションLPビルダー（テーマ完全連動型）
{% endcomment %}

<script src="{{ 'tailwindcss-3.4.17.js' | asset_url }}" defer></script>
<script>
/* Tailwind CSSのフォント設定をShopifyテーマの共通変数に連動させる */
tailwind.config = {
  theme: {
    extend: {
      colors: {
        'gold': '#B8860B',
        'light-gray': '#F9F9F9',
        'dark-gray': '#333333'
      },
      fontFamily: {
        /* Shopifyテーマのフォント設定を自動取得 */
        serif: ['var(--font-heading-family)', 'serif'],
        sans: ['var(--font-body-family)', 'sans-serif']
      }
    }
  }
}
</script>

<style>
  /* Shopifyテーマの基準サイズとフォントを適用 */
  .lp-container {
    font-family: var(--font-body-family), sans-serif;
    font-size: calc(var(--font-body-scale) * 100%);
    color: #333333;
  }
  .lp-container .font-serif {
    font-family: var(--font-heading-family), serif;
  }
  /* 小物セクションのドット背景用 */
  .dot-bg {
    background-image: radial-gradient(#d1d5db 1.5px, transparent 1.5px);
    background-size: 24px 24px;
  }
</style>

<div class="lp-container w-full min-h-screen bg-white relative pb-24" style="background-color: {{ section.settings.bg_color }};">
  <div class="max-w-6xl mx-auto px-6 pt-12 md:pt-16">

    {% for block in section.blocks %}
      {% case block.type %}

        {% comment %} --- 1. ヘッダーテキスト --- {% endcomment %}
        {% when 'header' %}
        <section class="mb-12" {{ block.shopify_attributes }}>
          <h1 class="text-2xl md:text-3xl font-serif tracking-widest mb-6" style="color: {{ block.settings.title_color }};">
            {{ block.settings.title }}
          </h1>
          {% if block.settings.sub_text != blank %}
            <p class="text-sm md:text-base leading-relaxed mb-2" style="color: {{ block.settings.text_color }};">
              {{ block.settings.sub_text | newline_to_br }}
            </p>
          {% endif %}
          {% if block.settings.note_text != blank %}
            <p class="text-xs" style="color: {{ block.settings.note_color }};">
              {{ block.settings.note_text }}
            </p>
          {% endif %}
        </section>

        {% comment %}
          --- 2. 商品ギャラリー（コレクション連携） ---
          写真(サムネイル)をクリックしたら商品詳細ページへ移動するのではなく、
          その場でライトボックス（拡大表示のギャラリー）を開き、矢印や
          キーボードの左右キーで他のドレスの写真も連続して見られるようにする。
          1商品に複数枚の画像が登録されていれば、そのドレスの中でも
          次の写真→さらに次の写真、と進んでから次のドレスへ移る
          （現時点では各商品に1枚しか画像が無いため、実質「次のドレスへ進む」
          動きに見えるが、後で商品に画像を追加すれば自動的にそのドレス内の
          複数写真も順番に見られるようになる）。
        {% endcomment %}
        {% when 'gallery_grid' %}
        <section class="mb-20" {{ block.shopify_attributes }}>
          {% assign collection = collections[block.settings.collection] %}
          {% assign limit = block.settings.limit %}

          {% paginate collection.products by limit %}
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
              {% for product in collection.products %}
                {%- capture product_images_json -%}
                  [{%- for image in product.images -%}"{{ image | image_url: width: 1400 }}"{% unless forloop.last %},{% endunless %}{%- endfor -%}]
                {%- endcapture -%}
                <button type="button"
                  class="group block w-full text-left cursor-pointer dress-gallery-item"
                  data-images="{{ product_images_json | strip_newlines | strip | escape }}"
                  data-title="{{ product.title | escape }}">
                  <div class="w-full relative aspect-[3/4] overflow-hidden mb-3 bg-gray-100">
                    {{ product.featured_image | image_url: width: 600 | image_tag: alt: product.title, class: 'absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105' }}
                  </div>
                  <h3 class="text-sm text-gray-800 transition-colors group-hover:text-gold">{{ product.title }}</h3>
                </button>
              {% else %}
                {% comment %} コレクション未選択時のプレースホルダー {% endcomment %}
                {% for i in (1..12) %}
                  <div class="group block">
                    <div class="w-full relative aspect-[3/4] overflow-hidden mb-3 bg-gray-100 flex items-center justify-center text-gray-400">
                      画像 {{ i }}
                    </div>
                    <h3 class="text-sm text-gray-800">ドレス名 サンプル</h3>
                  </div>
                {% endfor %}
              {% endfor %}
            </div>

            {% comment %} ページネーション {% endcomment %}
            {% if paginate.pages > 1 %}
              <div class="flex justify-center items-center mt-12 gap-6 text-sm font-serif text-gray-600">
                {{ paginate | default_pagination: next: '>', previous: '<' }}
              </div>
            {% else %}
              {% if collection == blank %}
                <div class="flex justify-center items-center mt-12 gap-6 text-sm font-serif text-gray-600">
                  <span class="border-b border-gray-800 text-gray-900 pb-1 px-1">1</span>
                  <span class="px-1">2</span>
                  <span class="px-1">3</span>
                  <span class="px-1">&gt;</span>
                </div>
              {% endif %}
            {% endif %}
          {% endpaginate %}
        </section>

        {% comment %} --- 3. 基本衣裳小物 (画像1枚に変更) --- {% endcomment %}
        {% when 'accessories' %}
        <section class="mb-20" {{ block.shopify_attributes }}>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-stretch dot-bg p-6 md:p-10 rounded-sm">

            {% comment %} 画像エリア (左側) {% endcomment %}
            <div class="w-full h-full bg-gray-200">
              {% if block.settings.image %}
                {{ block.settings.image | image_url: width: 800 | image_tag: class: 'w-full h-full object-cover' }}
              {% endif %}
            </div>

            {% comment %} テキストエリア (右側) {% endcomment %}
            <div class="bg-white/95 p-8 flex flex-col justify-center">
              <h2 class="text-xl font-serif mb-6 tracking-widest">{{ block.settings.title }}</h2>
              <div class="text-sm leading-loose text-gray-700">
                {{ block.settings.description | newline_to_br }}
              </div>
            </div>

          </div>
        </section>

        {% comment %} --- 4. 注意事項・情報ボックス --- {% endcomment %}
        {% when 'info_box' %}
        <section class="mb-12" {{ block.shopify_attributes }}>
          <h2 class="text-lg font-serif mb-4 tracking-widest">{{ block.settings.title }}</h2>
          <div class="p-6 text-sm leading-relaxed" style="background-color: {{ block.settings.box_bg }}; color: {{ block.settings.box_text_color }};">
            {{ block.settings.content | newline_to_br }}
          </div>
        </section>

      {% endcase %}
    {% endfor %}

  </div>

  {% comment %} --- 衣装ギャラリー用ライトボックス（拡大表示） --- {% endcomment %}
  <div id="dress-lightbox" class="fixed inset-0 z-[999] hidden items-center justify-center bg-black/90" aria-hidden="true">
    <button type="button" id="dress-lightbox-close" class="absolute top-4 right-4 md:top-8 md:right-8 text-white text-3xl leading-none w-10 h-10 flex items-center justify-center" aria-label="閉じる">&times;</button>

    <button type="button" id="dress-lightbox-prev" class="absolute left-2 md:left-6 top-1/2 -translate-y-1/2 text-white text-4xl w-12 h-12 flex items-center justify-center" aria-label="前の写真">&#8249;</button>

    <div class="max-w-3xl w-full px-4 md:px-16 flex flex-col items-center">
      <img id="dress-lightbox-image" src="" alt="" class="w-full h-auto object-contain mx-auto" style="max-height: 80vh;">
      <div class="mt-4 text-center text-white">
        <div id="dress-lightbox-title" class="text-base md:text-lg font-serif tracking-wide"></div>
        <div id="dress-lightbox-counter" class="text-xs text-gray-300 mt-1"></div>
      </div>
    </div>

    <button type="button" id="dress-lightbox-next" class="absolute right-2 md:right-6 top-1/2 -translate-y-1/2 text-white text-4xl w-12 h-12 flex items-center justify-center" aria-label="次の写真">&#8250;</button>
  </div>
</div>

<script>
(function() {
  var items = Array.prototype.slice.call(document.querySelectorAll('.dress-gallery-item'));
  if (!items.length) return;

  // 全ドレスの写真を1本のリストにする。1商品に複数枚あればその分だけ連続で入る。
  var slides = [];
  var itemStartIndex = [];
  items.forEach(function(item) {
    var images = [];
    try { images = JSON.parse(item.getAttribute('data-images') || '[]'); } catch (e) { images = []; }
    var title = item.getAttribute('data-title') || '';
    itemStartIndex.push(images.length ? slides.length : -1);
    images.forEach(function(url) { slides.push({ title: title, url: url }); });
  });
  if (!slides.length) return;

  var lightbox = document.getElementById('dress-lightbox');
  var imgEl = document.getElementById('dress-lightbox-image');
  var titleEl = document.getElementById('dress-lightbox-title');
  var counterEl = document.getElementById('dress-lightbox-counter');
  var closeBtn = document.getElementById('dress-lightbox-close');
  var prevBtn = document.getElementById('dress-lightbox-prev');
  var nextBtn = document.getElementById('dress-lightbox-next');
  var currentIndex = 0;

  function render() {
    var slide = slides[currentIndex];
    imgEl.src = slide.url;
    imgEl.alt = slide.title;
    titleEl.textContent = slide.title;
    counterEl.textContent = (currentIndex + 1) + ' / ' + slides.length;
  }

  function open(index) {
    currentIndex = index;
    render();
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  function showNext() {
    currentIndex = (currentIndex + 1) % slides.length;
    render();
  }

  function showPrev() {
    currentIndex = (currentIndex - 1 + slides.length) % slides.length;
    render();
  }

  items.forEach(function(item, i) {
    if (itemStartIndex[i] === -1) return;
    item.addEventListener('click', function() { open(itemStartIndex[i]); });
  });

  closeBtn.addEventListener('click', close);
  nextBtn.addEventListener('click', showNext);
  prevBtn.addEventListener('click', showPrev);
  lightbox.addEventListener('click', function(e) {
    if (e.target === lightbox) close();
  });
  document.addEventListener('keydown', function(e) {
    if (lightbox.classList.contains('hidden')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowRight') showNext();
    if (e.key === 'ArrowLeft') showPrev();
  });
})();
</script>

{% schema %}
{
  "name": "コレクションLPセクション",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "全体の背景色",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "header",
      "name": "ページ見出し",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "タイトル", "default": "ウェディングドレス＆タキシード" },
        { "type": "color", "id": "title_color", "label": "タイトル色", "default": "#333333" },
        { "type": "textarea", "id": "sub_text", "label": "サブテキスト", "default": "豊富なデザインのウェディングドレス＆タキシードをご用意" },
        { "type": "color", "id": "text_color", "label": "テキスト色", "default": "#666666" },
        { "type": "text", "id": "note_text", "label": "注釈テキスト", "default": "※画像は全てアップグレード衣裳（一例）" },
        { "type": "color", "id": "note_color", "label": "注釈テキスト色", "default": "#005a9c" }
      ]
    },
    {
      "type": "gallery_grid",
      "name": "商品ギャラリー(自動表示)",
      "limit": 1,
      "settings": [
        { "type": "collection", "id": "collection", "label": "表示するコレクション" },
        { "type": "range", "id": "limit", "min": 4, "max": 48, "step": 4, "label": "1ページの表示件数", "default": 12 }
      ]
    },
    {
      "type": "accessories",
      "name": "基本衣裳小物",
      "settings": [
        { "type": "text", "id": "title", "label": "タイトル", "default": "基本衣裳小物" },
        { "type": "textarea", "id": "description", "label": "説明文（改行可）", "default": "【新婦基本小物】ショートパールネックレス、一粒パールイヤリング、スパンショートグローブ、ショートベール（チュール）、ミュール（パンプス）※ベールは一部対象外\n\n【新郎基本小物】ポケットチーフ、サスペンダー、アームバンド、グローブ、カフスボタン、靴（新郎靴下はご持参）" },
        { "type": "image_picker", "id": "image", "label": "画像" }
      ]
    },
    {
      "type": "info_box",
      "name": "情報ボックス(延長料など)",
      "settings": [
        { "type": "text", "id": "title", "label": "見出し", "default": "延長料" },
        { "type": "textarea", "id": "content", "label": "テキスト（改行可）", "default": "衣裳・小物の貸出期間は、貸出日より9日間とさせていただきます。期間内にご返却いただけない場合は、延長料金が発生いたしますのでご了承ください。\n・9日目以降1日につき 衣裳・小物代金の10％" },
        { "type": "color", "id": "box_bg", "label": "ボックス背景色", "default": "#F7F7F7" },
        { "type": "color", "id": "box_text_color", "label": "テキスト色", "default": "#333333" }
      ]
    }
  ],
  "presets": [
    {
      "name": "コレクションLPセクション",
      "blocks": [
        { "type": "header" },
        { "type": "gallery_grid" },
        { "type": "accessories" },
        {
          "type": "info_box",
          "settings": {
            "title": "延長料",
            "content": "衣裳・小物の貸出期間は、貸出日より9日間とさせていただきます。期間内にご返却いただけない場合は、延長料金が発生いたしますのでご了承ください。\n・9日目以降1日につき 衣裳・小物代金の10%"
          }
        },
        {
          "type": "info_box",
          "settings": {
            "title": "注意事項",
            "content": "※空き状況・サイズ・お選びの時期等によってはご希望の衣裳がご用意できない場合もございます。あらかじめご了承ください。\n※お選びいただく衣裳・サイズにより追加代金が発生する場合がございます。"
          }
        }
      ]
    }
  ]
}
{% endschema %}
