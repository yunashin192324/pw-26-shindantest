{% comment %}
  his-wedding-intro
  --------------------------------------------------------------
  HIS WEDDING紹介ページ（新規の独立ページ）。他社のフォトウェディング
  紹介LPの「構成」だけを参考に、文言・素材はHIS WEDDING向けに新規作成。
  既存のdress-lp/custom-collection-lpと同じ作法（Tailwind CDN読み込み、
  テーマのフォント変数連動）を踏襲。

  【使い方】
  1. 管理画面→オンラインストア→ページ→新しいページを作成
     （URL/ハンドルは任意。例: about, concept など）
  2. 右側の「テーマテンプレート」で「page.about」を選択
  3. テーマエディタでこのセクションのブロック内容（達成実績の数字、
     お客様の声など）を実際の値に差し替える
  --------------------------------------------------------------
  【要差し替え】
    - 実績人数（stat_number）：仮の数字を入れているので実数に変更
    - お客様の声（testimonialブロック）：仮の文章なので実際の声に差し替え
{% endcomment %}

<script>
  if (!document.getElementById('tw-config')) {
    var twConfig = document.createElement('script');
    twConfig.id = 'tw-config';
    twConfig.innerHTML = "tailwind.config = { theme: { extend: { colors: { ivory: '#FAF8F5', gold: '#B8860B', 'gold-light': '#D4A843', dark: '#1a1a1a' }, fontFamily: { serif: ['var(--font-heading-family, serif)', 'serif'], sans: ['var(--font-body-family, sans-serif)', 'sans-serif'] } } } };";
    document.head.appendChild(twConfig);
  }
  if (!document.getElementById('tw-cdn')) {
    var twScript = document.createElement('script');
    twScript.id = 'tw-cdn';
    twScript.src = '{{ "tailwindcss-3.4.17.js" | asset_url }}';
    document.head.appendChild(twScript);
  }
</script>

<style>
  #his-wedding-intro-{{ section.id }} {
    font-family: var(--font-body-family, sans-serif);
    font-size: calc(var(--font-body-scale, 1) * 100%);
    color: #333333;
  }
  #his-wedding-intro-{{ section.id }} .font-serif { font-family: var(--font-heading-family, serif); }
  #his-wedding-intro-{{ section.id }} .divider-gold { width: 48px; height: 2px; background: #B8860B; margin: 16px auto; }
  #his-wedding-intro-{{ section.id }} .hwi-carousel-track::-webkit-scrollbar { display: none; }
  #his-wedding-intro-{{ section.id }} .hwi-carousel-track { scrollbar-width: none; -ms-overflow-style: none; scroll-snap-type: x mandatory; }
  #his-wedding-intro-{{ section.id }} .hwi-carousel-item { scroll-snap-align: start; }
</style>

<div id="his-wedding-intro-{{ section.id }}" class="w-full bg-white">

  {% comment %} --- 1. ヒーロー --- {% endcomment %}
  <section class="relative w-full flex flex-col justify-center items-center text-center" style="height: 70vh;">
    {% if section.settings.hero_image != blank %}
      {{ section.settings.hero_image | image_url: width: 2000 | image_tag: class: 'absolute inset-0 w-full h-full object-cover', alt: section.settings.hero_title }}
    {% else %}
      <div class="absolute inset-0 w-full h-full bg-gray-200"></div>
    {% endif %}
    <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.75), rgba(0,0,0,0.35) 55%, rgba(0,0,0,0.15));"></div>
    <div class="relative z-10 px-6 w-full max-w-3xl" style="color:#ffffff;">
      <p class="font-serif tracking-widest uppercase mb-4 text-sm">{{ section.settings.hero_eyebrow }}</p>
      <h1 class="font-serif font-light leading-tight mb-4" style="font-size: calc(var(--font-heading-scale, 1) * 40px);">{{ section.settings.hero_title | newline_to_br }}</h1>
      <p class="font-light" style="font-size: calc(var(--font-body-scale, 1) * 16px);">{{ section.settings.hero_lede }}</p>
      {% if section.settings.hero_button_text != blank %}
        <a href="{{ section.settings.hero_button_url }}" class="inline-block mt-8 px-10 py-4 rounded-full font-medium text-sm text-white transition hover:opacity-80" style="background-color:#B8860B;">{{ section.settings.hero_button_text }}</a>
      {% endif %}
    </div>
  </section>

  {% comment %} --- 2. どんなサービス？（特徴3つ） --- {% endcomment %}
  <section class="py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <p class="font-serif tracking-widest uppercase mb-2 text-sm" style="color:#B8860B;">{{ section.settings.features_eyebrow | default: 'HOW IT WORKS' }}</p>
        <h2 class="font-medium" style="font-size: calc(var(--font-heading-scale, 1) * 28px);">{{ section.settings.features_title | default: 'HIS WEDDINGってどんなサービス？' }}</h2>
        <div class="divider-gold"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 text-center">
        {% assign feature_blocks = section.blocks | where: 'type', 'feature' %}
        {% for block in feature_blocks %}
          <div {{ block.shopify_attributes }}>
            <div class="w-16 h-16 mx-auto mb-6 rounded-full flex items-center justify-center" style="background-color:#FAF8F5;color:#B8860B;">
              <span class="font-serif text-xl">{{ forloop.index }}</span>
            </div>
            <h3 class="font-bold mb-3" style="font-size: calc(var(--font-heading-scale, 1) * 18px);">{{ block.settings.title }}</h3>
            <p class="text-gray-600 leading-relaxed text-sm">{{ block.settings.desc }}</p>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  {% comment %} --- 3. 実績バナー --- {% endcomment %}
  <section class="py-14 text-center text-white" style="background-color:#1a1a1a;">
    <div class="max-w-3xl mx-auto px-6">
      <p class="font-serif tracking-widest uppercase mb-3 text-xs" style="color:#D4A843;">{{ section.settings.stat_eyebrow | default: 'TRACK RECORD' }}</p>
      <p class="font-serif" style="font-size: calc(var(--font-heading-scale, 1) * 44px);">
        {{ section.settings.stat_number | default: '500' }}<span style="font-size:0.5em;">{{ section.settings.stat_suffix | default: '組以上' }}</span>
      </p>
      <p class="text-sm text-gray-300 mt-2">{{ section.settings.stat_label | default: 'のカップルにご利用いただいています（要実数差し替え）' }}</p>
    </div>
  </section>

  {% comment %}
    --- 4. 撮影地プランのカルーセル ---
    Destinationメタオブジェクトから自動取得（撮影地一覧ページと同じデータ源）。
    表示件数はcarousel_limit設定で調整可能。
  {% endcomment %}
  {%- assign hwi_all_destinations = shop.metaobjects.destination.values -%}
  {%- assign hwi_carousel_limit = section.settings.carousel_limit | default: 8 -%}
  {% if hwi_all_destinations.size > 0 %}
  <section class="py-16 md:py-24" style="background-color:#FAF8F5;">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <p class="font-serif tracking-widest uppercase mb-2 text-sm" style="color:#B8860B;">{{ section.settings.carousel_eyebrow | default: 'DESTINATIONS' }}</p>
        <h2 class="font-medium" style="font-size: calc(var(--font-heading-scale, 1) * 28px);">{{ section.settings.carousel_title | default: '世界中から選べる撮影地' }}</h2>
        <div class="divider-gold"></div>
      </div>
      <div class="relative">
        <button type="button" class="hwi-carousel-prev absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 z-10 w-10 h-10 rounded-full bg-white shadow flex items-center justify-center" aria-label="前へ" style="color:#1a1a1a;">&#8249;</button>
        <div class="hwi-carousel-track flex gap-5 overflow-x-auto px-2" style="scroll-behavior:smooth;">
          {% assign hwi_count = 0 %}
          {% for d in hwi_all_destinations %}
            {% if hwi_count < hwi_carousel_limit %}
              <a href="{{ routes.root_url }}pages/{{ d.slug.value }}" class="hwi-carousel-item shrink-0 w-56 block group">
                <div class="w-full relative aspect-[3/4] overflow-hidden rounded-lg mb-3 bg-gray-200">
                  {% if d.hero_image.value != blank %}
                    {{ d.hero_image.value | image_url: width: 600 | image_tag: alt: d.name_ja.value, class: 'absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105' }}
                  {% endif %}
                </div>
                <p class="font-serif text-lg text-center" style="color:#1a1a1a;">{{ d.name_ja.value }}</p>
              </a>
              {% assign hwi_count = hwi_count | plus: 1 %}
            {% endif %}
          {% endfor %}
        </div>
        <button type="button" class="hwi-carousel-next absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 z-10 w-10 h-10 rounded-full bg-white shadow flex items-center justify-center" aria-label="次へ" style="color:#1a1a1a;">&#8250;</button>
      </div>
      {% if section.settings.carousel_button_text != blank %}
        <div class="text-center mt-12">
          <a href="{{ section.settings.carousel_button_url | default: routes.root_url | append: 'pages/destinations' }}" class="inline-block px-8 py-3 rounded-full font-medium text-sm transition hover:opacity-80" style="background-color:#B8860B;color:#ffffff;">{{ section.settings.carousel_button_text }}</a>
        </div>
      {% endif %}
    </div>
  </section>
  <script>
    (function () {
      var root = document.getElementById('his-wedding-intro-{{ section.id }}');
      if (!root) return;
      var track = root.querySelector('.hwi-carousel-track');
      var prev = root.querySelector('.hwi-carousel-prev');
      var next = root.querySelector('.hwi-carousel-next');
      if (!track || !prev || !next) return;
      function scrollByCard(dir) {
        var card = track.querySelector('.hwi-carousel-item');
        var amount = card ? card.getBoundingClientRect().width + 20 : 240;
        track.scrollBy({ left: dir * amount, behavior: 'smooth' });
      }
      prev.addEventListener('click', function () { scrollByCard(-1); });
      next.addEventListener('click', function () { scrollByCard(1); });
    })();
  </script>
  {% endif %}

  {% comment %} --- 5. お申込みから当日までの流れ --- {% endcomment %}
  {% assign flow_blocks = section.blocks | where: 'type', 'flow_step' %}
  {% if flow_blocks.size > 0 %}
  <section class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-16">
        <p class="font-serif tracking-widest uppercase mb-2 text-sm" style="color:#B8860B;">{{ section.settings.flow_eyebrow | default: 'FLOW' }}</p>
        <h2 class="font-medium" style="font-size: calc(var(--font-heading-scale, 1) * 28px);">{{ section.settings.flow_title | default: 'お申込みから当日までの流れ' }}</h2>
        <div class="divider-gold"></div>
      </div>
      <div class="space-y-8">
        {% for block in flow_blocks %}
          <div class="flex gap-6 items-start" {{ block.shopify_attributes }}>
            <div class="w-10 h-10 shrink-0 rounded-full text-white flex items-center justify-center font-serif" style="background-color:#B8860B;">{{ forloop.index }}</div>
            <div>
              <h4 class="font-bold mb-1" style="font-size: calc(var(--font-heading-scale, 1) * 16px);">{{ block.settings.title }}</h4>
              <p class="text-sm text-gray-600 leading-relaxed">{{ block.settings.desc }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% comment %} --- 6. 先輩カップルの声 --- {% endcomment %}
  {% assign testimonial_blocks = section.blocks | where: 'type', 'testimonial' %}
  {% if testimonial_blocks.size > 0 %}
  <section class="py-16 md:py-24" style="background-color:#FAF8F5;">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <p class="font-serif tracking-widest uppercase mb-2 text-sm" style="color:#B8860B;">{{ section.settings.testimonial_eyebrow | default: 'VOICE' }}</p>
        <h2 class="font-medium" style="font-size: calc(var(--font-heading-scale, 1) * 28px);">{{ section.settings.testimonial_title | default: '先輩カップルの声' }}</h2>
        <div class="divider-gold"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {% for block in testimonial_blocks %}
          <div class="bg-white rounded-lg p-8 shadow-sm" {{ block.shopify_attributes }}>
            <p class="text-sm text-gray-700 leading-relaxed mb-6">{{ block.settings.quote }}</p>
            <p class="text-xs font-bold" style="color:#B8860B;">{{ block.settings.name }}</p>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% comment %} --- 7. プラン別CTA（2枚） --- {% endcomment %}
  <section class="py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-6">
      {% assign cta_blocks = section.blocks | where: 'type', 'cta_card' %}
      {% for block in cta_blocks %}
        <div class="relative rounded-lg overflow-hidden" style="aspect-ratio: 4/3;" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 900 | image_tag: class: 'absolute inset-0 w-full h-full object-cover', alt: block.settings.title }}
          {% else %}
            <div class="absolute inset-0 bg-gray-200"></div>
          {% endif %}
          <div class="absolute inset-0" style="background:linear-gradient(to top, rgba(0,0,0,0.7), rgba(0,0,0,0.1));"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
            <h3 class="font-serif mb-3" style="font-size: calc(var(--font-heading-scale, 1) * 22px);">{{ block.settings.title }}</h3>
            {% if block.settings.button_text != blank %}
              <a href="{{ block.settings.button_url }}" class="inline-block px-6 py-2.5 rounded-full text-xs font-medium transition hover:opacity-80" style="background-color:#B8860B;color:#ffffff;">{{ block.settings.button_text }}</a>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </section>

  {% comment %} --- 8. よくある質問（抜粋） --- {% endcomment %}
  {% assign faq_blocks = section.blocks | where: 'type', 'faq' %}
  {% if faq_blocks.size > 0 %}
  <section class="py-16 md:py-24" style="background-color:#FAF8F5;">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-center mb-16">
        <p class="font-serif tracking-widest uppercase mb-2 text-sm" style="color:#B8860B;">{{ section.settings.faq_eyebrow | default: 'FAQ' }}</p>
        <h2 class="font-medium" style="font-size: calc(var(--font-heading-scale, 1) * 28px);">{{ section.settings.faq_title | default: 'よくあるご質問' }}</h2>
        <div class="divider-gold"></div>
      </div>
      <div>
        {% for block in faq_blocks %}
          <details class="border-b border-gray-200 py-4" {{ block.shopify_attributes }}>
            <summary class="cursor-pointer font-medium text-sm flex justify-between items-center">{{ block.settings.question }}<span style="color:#B8860B;">＋</span></summary>
            <p class="text-sm text-gray-600 mt-3 leading-relaxed">{{ block.settings.answer }}</p>
          </details>
        {% endfor %}
      </div>
      {% if section.settings.faq_button_text != blank %}
        <div class="text-center mt-12">
          <a href="{{ section.settings.faq_button_url }}" class="inline-block px-8 py-3 rounded-full font-medium text-sm border transition hover:opacity-70" style="border-color:#1a1a1a;color:#1a1a1a;">{{ section.settings.faq_button_text }}</a>
        </div>
      {% endif %}
    </div>
  </section>
  {% endif %}

</div>

{% schema %}
{
  "name": "HIS WEDDING紹介ページ",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "ヒーロー背景画像" },
    { "type": "text", "id": "hero_eyebrow", "label": "ヒーロー英字見出し", "default": "HIS WEDDING" },
    { "type": "textarea", "id": "hero_title", "label": "ヒーロー メインタイトル（改行可）", "default": "海外フォトウェディングを、\nもっと身近に。" },
    { "type": "textarea", "id": "hero_lede", "label": "ヒーロー リード文", "default": "国内で衣裳を試着して、海外の絶景で撮影するだけ。準備の負担を最小限に、一生に一度の1枚を残すためのフォトウェディングサービスです。" },
    { "type": "text", "id": "hero_button_text", "label": "ヒーロー ボタン文言", "default": "撮影地から選ぶ" },
    { "type": "url", "id": "hero_button_url", "label": "ヒーロー ボタンリンク先" },

    { "type": "header", "content": "実績バナー" },
    { "type": "text", "id": "stat_eyebrow", "label": "英字見出し", "default": "TRACK RECORD" },
    { "type": "text", "id": "stat_number", "label": "実績の数字（要実数差し替え）", "default": "500" },
    { "type": "text", "id": "stat_suffix", "label": "数字の単位", "default": "組以上" },
    { "type": "text", "id": "stat_label", "label": "説明文", "default": "のカップルにご利用いただいています" },

    { "type": "header", "content": "特徴セクション" },
    { "type": "text", "id": "features_eyebrow", "label": "英字見出し", "default": "HOW IT WORKS" },
    { "type": "text", "id": "features_title", "label": "見出し", "default": "HIS WEDDINGってどんなサービス？" },

    { "type": "header", "content": "撮影地カルーセル" },
    { "type": "text", "id": "carousel_eyebrow", "label": "英字見出し", "default": "DESTINATIONS" },
    { "type": "text", "id": "carousel_title", "label": "見出し", "default": "世界中から選べる撮影地" },
    { "type": "range", "id": "carousel_limit", "min": 4, "max": 16, "step": 1, "label": "表示件数", "default": 8 },
    { "type": "text", "id": "carousel_button_text", "label": "ボタン文言", "default": "撮影地一覧をもっと見る" },
    { "type": "url", "id": "carousel_button_url", "label": "ボタンリンク先" },

    { "type": "header", "content": "流れセクション" },
    { "type": "text", "id": "flow_eyebrow", "label": "英字見出し", "default": "FLOW" },
    { "type": "text", "id": "flow_title", "label": "見出し", "default": "お申込みから当日までの流れ" },

    { "type": "header", "content": "お客様の声セクション" },
    { "type": "text", "id": "testimonial_eyebrow", "label": "英字見出し", "default": "VOICE" },
    { "type": "text", "id": "testimonial_title", "label": "見出し", "default": "先輩カップルの声" },

    { "type": "header", "content": "FAQセクション" },
    { "type": "text", "id": "faq_eyebrow", "label": "英字見出し", "default": "FAQ" },
    { "type": "text", "id": "faq_title", "label": "見出し", "default": "よくあるご質問" },
    { "type": "text", "id": "faq_button_text", "label": "ボタン文言", "default": "よくある質問をもっと見る" },
    { "type": "url", "id": "faq_button_url", "label": "ボタンリンク先" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "特徴（1項目）",
      "settings": [
        { "type": "text", "id": "title", "label": "タイトル", "default": "来店不要、オンラインで完結" },
        { "type": "textarea", "id": "desc", "label": "説明文", "default": "プランのご相談からお申し込みまで、オンラインで完結。忙しいおふたりでも、すきま時間で準備を進められます。" }
      ]
    },
    {
      "type": "flow_step",
      "name": "流れ（1ステップ）",
      "settings": [
        { "type": "text", "id": "title", "label": "タイトル", "default": "お問い合わせ" },
        { "type": "textarea", "id": "desc", "label": "説明文", "default": "オンラインフォームより、気になる撮影地やプランをご相談ください。" }
      ]
    },
    {
      "type": "testimonial",
      "name": "お客様の声（1件・要差し替え）",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "コメント（仮の文章。実際の声に差し替えてください）", "default": "国内で試着してから現地に持って行けたので、サイズの不安もなく安心して撮影に臨めました。" },
        { "type": "text", "id": "name", "label": "お名前・年代など", "default": "◯◯様（20代）" }
      ]
    },
    {
      "type": "cta_card",
      "name": "プランCTAカード",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "画像" },
        { "type": "text", "id": "title", "label": "タイトル", "default": "撮影地から選ぶ" },
        { "type": "text", "id": "button_text", "label": "ボタン文言", "default": "撮影地一覧を見る" },
        { "type": "url", "id": "button_url", "label": "ボタンリンク先" }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ（1項目）",
      "settings": [
        { "type": "text", "id": "question", "label": "質問", "default": "質問文をここに入力" },
        { "type": "textarea", "id": "answer", "label": "回答" }
      ]
    }
  ],
  "presets": [
    {
      "name": "HIS WEDDING紹介ページ",
      "blocks": [
        { "type": "feature" },
        { "type": "feature", "settings": { "title": "衣裳・撮影・データ、まとめてワンプライス", "desc": "ウェディングドレス＆タキシードのレンタル、現地カメラマンによる撮影、データ納品までを含んだオールインワンプラン。追加費用の心配がありません。" } },
        { "type": "feature", "settings": { "title": "当日は身ひとつでOK", "desc": "衣裳は日本国内の提携サロンで試着したものを事前にお渡し。現地では着替えと撮影に集中するだけです。" } },
