{%- comment -%}
  spots-map — 撮影スポットMAP。
  ----------------------------------------------------------------
  全都市のPhoto Spot(緯度・経度が入力済みのもの)を1つの地図にまとめて
  表示し、カテゴリ(教会/海/ホテル等)で絞り込める。
  Leaflet + OpenStreetMapを使用(完全無料、APIキー・請求先アカウント
  登録不要)。Leaflet本体はこのテーマでは自己ホストできていないため
  (Tailwind/Lucideと違いCDN経由、docs/spots-map-setup.md参照)、
  jsDelivr経由で読み込む。

  Photo Spot側に以下の新規フィールドが必要(未入力のスポットは単に
  地図に出ないだけで、エラーにはならない):
    latitude / longitude — 数値(小数)
    category — 「Spot Category」metaobjectへの参照
  詳細はdocs/spots-map-setup.mdを参照。
{%- endcomment -%}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css">
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js" defer></script>

{%- assign all_destinations = shop.metaobjects.destination.values -%}
<script type="application/json" id="spots-map-data-{{ section.id }}">
[
  {%- assign spot_count = 0 -%}
  {%- for d in all_destinations -%}
    {%- assign spots = d.photo_spots.value -%}
    {%- for spot in spots -%}
      {%- if spot.latitude.value != blank and spot.longitude.value != blank -%}
        {%- if spot_count > 0 -%},{%- endif -%}
        {
          "title": {{ spot.title.value | json }},
          "lat": {{ spot.latitude.value | times: 1.0 | json }},
          "lng": {{ spot.longitude.value | times: 1.0 | json }},
          "category": {{ spot.category.value.label.value | default: 'その他' | json }},
          "image": {{ spot.image.value | image_url: width: 400 | json }},
          "destination": {{ d.name_ja.value | json }},
          "url": {{ '/pages/' | append: d.slug.value | json }}
        }
        {%- assign spot_count = spot_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
]
</script>

<section>
  <div class="dst-container">
    <div class="dst-section-head dst-reveal">
      <p class="dst-eyebrow">{{ section.settings.eyebrow | default: 'MAP' }}</p>
      <h2>{{ section.settings.heading | default: '撮影スポットMAP' }}</h2>
      {%- if section.settings.description != blank -%}
        <p class="dst-lede">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    {%- if spot_count > 0 -%}
      <div class="dst-filter-chips" id="spots-map-chips-{{ section.id }}" style="margin-bottom:20px;justify-content:center;"></div>
      <div id="spots-map-canvas-{{ section.id }}" class="dst-map-canvas"></div>
    {%- else -%}
      <p class="dst-text-center dst-text-muted" style="padding:40px 0;">
        緯度・経度が設定された撮影スポットがまだありません。各撮影スポットに緯度・経度を入力すると、ここに自動で表示されます。
      </p>
    {%- endif -%}
  </div>
</section>

{%- if spot_count > 0 -%}
<script>
  (function () {
    function init() {
      var dataEl = document.getElementById('spots-map-data-{{ section.id }}');
      var canvas = document.getElementById('spots-map-canvas-{{ section.id }}');
      if (!dataEl || !canvas || typeof L === 'undefined') return;
      var spotsData = JSON.parse(dataEl.textContent || '[]');

      var CATEGORY_COLORS = {
        '教会': '#8f6a08',
        '海': '#2b7a9e',
        'ホテル': '#B8860B',
        '自然': '#4c7a3f',
        '街並み': '#7a5c3e',
        'その他': '#666666'
      };

      var map = L.map(canvas).setView([20, 100], 3);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>',
        maxZoom: 18
      }).addTo(map);

      var markers = [];
      var categoriesPresent = [];

      spotsData.forEach(function (spot) {
        if (typeof spot.lat !== 'number' || typeof spot.lng !== 'number') return;
        var color = CATEGORY_COLORS[spot.category] || '#666666';
        var icon = L.divIcon({
          className: 'dst-spot-marker',
          html: '<span style="background:' + color + ';"></span>',
          iconSize: [16, 16]
        });
        var marker = L.marker([spot.lat, spot.lng], { icon: icon });
        var popupHtml = '<div class="dst-map-popup">'
          + (spot.image ? '<img src="' + spot.image + '" alt="">' : '')
          + '<strong>' + spot.title + '</strong>'
          + '<span>' + spot.destination + '</span>'
          + '<a href="' + spot.url + '">撮影地ページを見る ＞</a>'
          + '</div>';
        marker.bindPopup(popupHtml);
        marker.spotCategory = spot.category;
        marker.addTo(map);
        markers.push(marker);
        if (categoriesPresent.indexOf(spot.category) === -1) categoriesPresent.push(spot.category);
      });

      if (markers.length > 0) {
        var group = L.featureGroup(markers);
        map.fitBounds(group.getBounds().pad(0.3));
      }

      function applyFilter(category) {
        markers.forEach(function (m) {
          var show = !category || m.spotCategory === category;
          if (show) {
            if (!map.hasLayer(m)) m.addTo(map);
          } else {
            if (map.hasLayer(m)) map.removeLayer(m);
          }
        });
      }

      var chipsWrap = document.getElementById('spots-map-chips-{{ section.id }}');
      function buildChip(label, category, active) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'dst-filter-chip' + (active ? ' is-active' : '');
        btn.textContent = label;
        btn.addEventListener('click', function () {
          Array.prototype.forEach.call(chipsWrap.querySelectorAll('.dst-filter-chip'), function (c) {
            c.classList.remove('is-active');
          });
          btn.classList.add('is-active');
          applyFilter(category);
        });
        return btn;
      }
      if (chipsWrap) {
        chipsWrap.appendChild(buildChip('すべて', null, true));
        categoriesPresent.forEach(function (cat) {
          chipsWrap.appendChild(buildChip(cat, cat, false));
        });
      }
    }

    if (typeof L !== 'undefined') {
      init();
    } else {
      window.addEventListener('load', init);
    }
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "撮影スポットMAP",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "英字見出し", "default": "MAP" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "撮影スポットMAP" },
    { "type": "textarea", "id": "description", "label": "説明文" }
  ],
  "presets": [{ "name": "撮影スポットMAP" }]
}
{% endschema %}
