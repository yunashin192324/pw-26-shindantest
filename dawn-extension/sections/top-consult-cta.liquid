{%- comment -%}
  top-consult-cta — TOPページ用「オンライン相談」CTA。HISスタッフによる
  オンライン相談受付が始まるまでは「表示する」をオフにしておけば、
  セクションごと非表示になる(準備ができたらチェックを入れるだけで
  公開できる)。ボタンのリンク先は、別途作成中の問い合わせフォームの
  URLを設定する想定。
  Theme Editorの「セクションを追加」からTOPページの好きな位置
  (バナーとして途中に挟む、もしくは一番下など)に配置できる、
  独立したセクション。
{%- endcomment -%}
{%- if section.settings.show -%}
<section class="py-20 px-6 text-center" style="background-color:{{ section.settings.bg_color }};">
  <div class="max-w-3xl mx-auto fade-in">
    {%- if section.settings.eyebrow != blank -%}
      <p class="font-serif-display tracking-widest-custom mb-4" style="color:{{ section.settings.eyebrow_color }};">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="text-2xl md:text-3xl tracking-widest-custom mb-6 leading-relaxed" style="color:{{ section.settings.heading_color }};">{{ section.settings.heading | newline_to_br }}</h2>
    {%- if section.settings.description != blank -%}
      <p class="text-sm md:text-base mb-10 leading-relaxed" style="color:{{ section.settings.desc_color }};">{{ section.settings.description | newline_to_br }}</p>
    {%- endif -%}
    <a href="{{ section.settings.button_url | default: '#' }}" class="btn btn-gold inline-block px-10 py-4 text-sm tracking-widest-custom" style="background-color:{{ section.settings.button_color | default: '#B8860B' }};color:#ffffff;">{{ section.settings.button_label }}</a>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "TOP オンライン相談CTA",
  "settings": [
    { "type": "checkbox", "id": "show", "label": "表示する", "default": false, "info": "オンライン相談の受付準備ができるまではオフにしておいてください。オフの間はこのセクション自体が非表示になります。" },
    { "type": "color", "id": "bg_color", "label": "背景色", "default": "#FAF8F5" },
    { "type": "text", "id": "eyebrow", "label": "英字見出し", "default": "Online Consultation" },
    { "type": "color", "id": "eyebrow_color", "label": "英字見出し色", "default": "#B8860B" },
    { "type": "textarea", "id": "heading", "label": "見出し", "default": "スタッフによるオンライン相談" },
    { "type": "color", "id": "heading_color", "label": "見出し色", "default": "#1a1a1a" },
    { "type": "textarea", "id": "description", "label": "説明文", "default": "撮影地選びやプランについて、専門スタッフがオンラインでご相談に応じます。まずはお気軽にお問い合わせください。" },
    { "type": "color", "id": "desc_color", "label": "説明文の色", "default": "#4b5563" },
    { "type": "text", "id": "button_label", "label": "ボタン文言", "default": "オンライン相談はこちら" },
    { "type": "url", "id": "button_url", "label": "ボタンリンク先", "info": "別途作成中の問い合わせフォームのURLを設定してください。" },
    { "type": "color", "id": "button_color", "label": "ボタン色", "default": "#B8860B" }
  ],
  "presets": [{ "name": "TOP オンライン相談CTA" }]
}
{% endschema %}
