{%- comment -%}
  destination-spots — 撮影スポット。Destination metaobjectの
  `photo_spots`は「Photo Spot」metaobjectへの参照リスト型。
  各スポットはtitle(単一行テキスト)/description(複数行テキスト)/
  image(ファイル・画像)を持つ独立したmetaobjectエントリーで、
  管理画面上でその場で新規作成＆画像アップロードができる
  (JSONを手書きしたりファイル管理ページを往復したりする必要がない)。
{%- endcomment -%}
{%- comment -%}
  where: 'slug.value', page.handle はこの環境ではネストしたプロパティの
  絞り込みが効かないことがあるため、確実に動く明示的なfor+ifに置き換え。
{%- endcomment -%}
{%- assign all_destination_entries = shop.metaobjects.destination.values -%}
{%- assign destination = blank -%}
{%- for d in all_destination_entries -%}
  {%- if d.slug.value == page.handle -%}{%- assign destination = d -%}{%- endif -%}
{%- endfor -%}
{%- assign spots = destination.photo_spots.value -%}

{%- if destination and spots.size > 0 -%}
<section{% if section.settings.bg_ivory %} class="dst-bg-ivory"{% endif %}>
  <div class="dst-container">
    <div class="dst-section-head dst-reveal">
      <p class="dst-eyebrow" style="color:{{ section.settings.eyebrow_color }};">{{ section.settings.eyebrow }}</p>
      <h2 style="color:{{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
      <hr class="dst-divider">
    </div>
    <div class="dst-spots-grid">
      {%- for spot in spots -%}
        {%- comment -%}
          spotはPhoto Spot metaobjectエントリーそのものなので、各項目は
          JSONの時と違い .value まで付けて取り出す。
        {%- endcomment -%}
        {%- assign spot_title = spot.title.value -%}
        <div class="dst-spot-card dst-reveal">
          {%- if spot.image.value != blank -%}
            <div class="dst-spot-media">
              <img
                src="{{ spot.image.value | image_url: width: 700 }}"
                srcset="{{ spot.image.value | image_url: width: 500 }} 500w, {{ spot.image.value | image_url: width: 700 }} 700w, {{ spot.image.value | image_url: width: 1000 }} 1000w"
                sizes="(min-width: 760px) 33vw, 90vw"
                alt="{{ spot_title | escape }}"
                loading="lazy"
                width="700" height="875"
                style="object-position: {{ section.settings.img_position }};"
              >
            </div>
          {%- endif -%}
          {%- if spot_title != blank -%}<h3 class="dst-spot-title">{% render 'safe-linebreak', text: spot_title %}</h3>{%- endif -%}
          {%- if spot.description.value != blank -%}<p class="dst-spot-desc">{{ spot.description.value }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "都市 撮影スポット",
  "settings": [
    { "type": "checkbox", "id": "bg_ivory", "label": "背景をアイボリーにする", "default": false },
    { "type": "text", "id": "eyebrow", "label": "英字見出し", "default": "Spots" },
    { "type": "color", "id": "eyebrow_color", "label": "英字見出し色", "default": "#c9a96e" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "撮影スポット" },
    { "type": "color", "id": "heading_color", "label": "見出し色", "default": "#1a1a1a" },
    { "type": "select", "id": "img_position", "label": "画像トリミング位置", "default": "center",
      "options": [
        { "value": "top", "label": "上" },
        { "value": "center", "label": "中央" },
        { "value": "bottom", "label": "下" }
      ]
    }
  ],
  "presets": [{ "name": "都市 撮影スポット" }]
}
{% endschema %}
