            <li><a href="#dress" class="text-xs text-gray-300 hover:text-white transition">ドレス</a></li>
            <li><a href="{{ section.settings.diagnosis_link | default: '#' }}" class="text-xs text-gray-300 hover:text-white transition">診断</a></li>
            <li><a href="{{ section.settings.faq_link | default: '#' }}" class="text-xs text-gray-300 hover:text-white transition">FAQ</a></li>
            <li><a href="{{ section.settings.footer_company_link | default: '#' }}" class="text-xs text-gray-300 hover:text-white transition">{{ section.settings.footer_company_text }}</a></li>
