        <a href="{{ section.settings.floating_diagnosis_url | default: '#' }}" class="flex items-center justify-center px-6 py-4 rounded-full shadow-2xl hover:scale-105 transition-transform duration-300" style="background-color: {{ section.settings.floating_diagnosis_bg | default: '#B8860B' }}; color: {{ section.settings.floating_diagnosis_color | default: '#ffffff' }};">
