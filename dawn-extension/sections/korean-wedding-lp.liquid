            <li><a href="{{ section.settings.footer_danang_link | default: '#' }}" class="text-xs text-gray-300 hover:text-white transition">{{ section.settings.footer_danang_text }}</a></li>
            <li><a href="{{ section.settings.footer_london_link | default: '#' }}" class="text-xs text-gray-300 hover:text-white transition">{{ section.settings.footer_london_text }}</a></li>
