</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    lucide.createIcons();

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
        }
      });
    }, { threshold: 0.1, rootMargin: "0px 0px -50px 0px" });
    document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));

    document.querySelectorAll('.qa-toggle').forEach(btn => {
      btn.addEventListener('click', function() {
        const answer = this.nextElementSibling;
        const icon = this.querySelector('[data-lucide]');

        if (answer.style.maxHeight) {
          answer.style.maxHeight = null;
          icon.style.transform = 'rotate(0deg)';
        } else {
          answer.style.maxHeight = answer.scrollHeight + "px";
          icon.style.transform = 'rotate(45deg)';
        }
      });
    });

    // スムーズスクロールズレの完全補正
    const handleSmoothScroll = (targetSelector) => {
      const targetElement = document.querySelector(targetSelector);
      if (targetElement) {
        const headerOffset = 80;
        // 固定ヘッダーの高さ
        const elementPosition = targetElement.getBoundingClientRect().top;
        const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

        window.scrollTo({
          top: offsetPosition,
          behavior: 'smooth'
        });
      }
    };

    // ナビゲーションメニューとページ内リンクのルーティング監視
    document.addEventListener('click', (e) => {
      const anchor = e.target.closest('a');
      if (!anchor) return;

      const href = anchor.getAttribute('href');
      if (!href) return;

      // 「/」から始まるURLに対応（別ページ遷移対策）
      const cleanHref = href.replace(/^.*?#/, '#');

      if (cleanHref === '#destinations' || cleanHref === '#plan' || cleanHref === '#plans') {
        e.preventDefault();
        handleSmoothScroll('#destinations');
      } else if (cleanHref.startsWith('#') && cleanHref.length > 1) {
        e.preventDefault();
        handleSmoothScroll(cleanHref);
      }
    });

    // 別ページからリンク付き（例: /#destinations）でトップに戻ってきた時の読み込み時処理
    if (window.location.hash) {
      setTimeout(() => {
        let hash = window.location.hash;
        if (hash === '#plan' || hash === '#plans') hash = '#destinations';
        handleSmoothScroll(hash);
      }, 300);
    }
  });
</script>

