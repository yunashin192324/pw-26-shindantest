{% comment %}
  HIS World Wedding LP セクション - フルカスタマイズ完全版（テーマ連動型）
{% endcomment %}

<script src="{{ 'tailwind-3.4.17.js' | asset_url }}" defer></script>
<script src="{{ 'lucide-0.263.0.min.js' | asset_url }}" defer></script>

<script>
  /* Tailwind CSSのフォント設定をShopifyテーマの共通変数に連動させる */
  tailwind.config = {
    theme: {
      extend: {
        fontFamily: {
          'serif-display': ['var(--font-heading-family)', 'serif'],
          sans: ['var(--font-body-family)', 'sans-serif']
        }
      }
    }
  }
</script>

<style>
  :root {
    --gold: #C9A96E;
    --dark: #1a1a1a;
    --dark-brown: #2d2419;
    --offwhite: #f8f6f2;
    --ivory: #faf9f6;
  }

  /* テーマの枠制限を突破して全画面幅にする強制リセット */
  .lp-container {
    width: 100vw !important;
    max-width: 100vw !important;
    margin-left: calc(50% - 50vw) !important;
    overflow-x: hidden;
    /* Shopifyテーマの本文フォントと基準サイズスケールを適用 */
    font-family: var(--font-body-family), sans-serif;
    font-size: calc(var(--font-body-scale) * 100%);
    color: #333;
  }

  .lp-container .font-serif-display {
    /* Shopifyテーマの見出しフォントを適用 */
    font-family: var(--font-heading-family), serif;
  }

  .lp-container .text-gold { color: var(--gold); }
  .lp-container .bg-gold { background-color: var(--gold); }
  .lp-container .bg-ivory { background-color: var(--ivory); }
  .lp-container .border-gold { border-color: var(--gold); }
  .lp-container .tracking-widest-custom { letter-spacing: 0.15em; }
  .lp-container .fade-in {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }
  .lp-container .fade-in.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .lp-container .gold-line {
    border-color: var(--gold);
    opacity: 0.4;
    margin-top: 1rem;
    margin-bottom: 2rem;
  }

  /* ボタン共通スタイル */
  .lp-container .btn {
    padding: 12px 32px;
    letter-spacing: 0.1em;
    font-size: 14px;
    transition: all 0.3s;
    text-align: center;
    display: inline-block;
    cursor: pointer;
    min-width: 180px;
  }
  .lp-container .btn-gold {
    background: var(--gold);
    color: #fff;
    border: 1px solid var(--gold);
  }
  .lp-container .btn-gold:hover {
    background: #b5955a;
    border-color: #b5955a;
  }
  .lp-container .btn-outline-light {
    border: 1px solid #fff;
    color: #fff;
  }
  .lp-container .btn-outline-light:hover {
    background: #fff;
    color: var(--dark);
  }
  .lp-container .btn-outline-dark {
    border: 1px solid var(--dark);
    color: var(--dark);
  }
  .lp-container .btn-outline-dark:hover {
    background: var(--dark);
    color: #fff;
  }

  /* アコーディオン */
  .qa-answer {
    transition: max-height 0.3s ease-out;
  }

  /* ==========================================================================
     【追加箇所】写真の爽快感を邪魔しない、文字をクッキリ読ませる強力な多層文字シャドウ
     ========================================================================== */
  .hero-perfect-shadow h1,
  .hero-perfect-shadow p {
    text-shadow: 0 4px 16px rgba(0, 0, 0, 0.60), 0 1px 4px rgba(0, 0, 0, 0.45);
  }

  /* ==========================================================================
     【修正】見出しフォント(--font-heading-family)は半角数字の字形が
     極端に小さく・沈んで見える(オールドスタイル数字)ため、position/
     line-heightでの位置調整では直らなかった。数字だけ本文用フォント
     (--font-body-family)に切り替えて描画することで解決する。
     ========================================================================== */
  .lp-container .num-fix {
    font-family: var(--font-body-family), sans-serif;
    font-variant-numeric: lining-nums;
  }
</style>

<div class="lp-container w-full">

  <header class="relative w-full h-screen">
    <div class="absolute inset-0">
      {% if section.settings.hero_image %}
        {% assign hero_img_class = 'w-full h-full object-cover ' | append: section.settings.hero_image_position %}
        {{ section.settings.hero_image | image_url: width: 2000 | image_tag: class: hero_img_class, loading: 'eager', alt: section.settings.hero_title }}
      {% else %}
        <div class="w-full h-full bg-gray-600"></div>
      {% endif %}
      <div class="absolute inset-0 bg-black" style="opacity: {{ section.settings.hero_overlay_opacity | divided_by: 100.0 }};"></div>
    </div>

    <div class="relative z-10 absolute inset-0 flex flex-col items-center justify-center text-center px-6 pt-20 h-full bg-gradient-to-b from-black/15 via-black/5 to-black/20">
      <div class="hero-perfect-shadow">
        <p class="font-serif-display tracking-widest-custom mb-4 font-bold" style="color: {{ section.settings.hero_eyebrow_color }};">{{ section.settings.hero_eyebrow }}</p>
        <h1 class="font-serif-display text-4xl md:text-6xl tracking-widest-custom mb-6 leading-tight font-medium" style="color: {{ section.settings.hero_title_color }};">{{ section.settings.hero_title | newline_to_br }}</h1>
        <p class="text-sm md:text-base leading-loose max-w-2xl mx-auto mb-10 opacity-95" style="color: {{ section.settings.hero_desc_color }};">{{ section.settings.hero_desc | newline_to_br }}</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          {% if section.settings.show_diagnosis %}
            <a href="{{ section.settings.diagnosis_link | default: '#' }}" class="btn btn-gold">{{ section.settings.hero_btn_2_text }}</a>
          {% endif %}
        </div>
      </div>
    </div>
  </header>

  <main>
    <section id="plans" class="py-24 px-6">
      <div class="max-w-6xl mx-auto">

        <div class="text-center mb-16 fade-in">
          <p class="font-serif-display tracking-widest-custom mb-2 font-bold" style="color: {{ section.settings.plan_eyebrow_color }};">Popular Plans</p>
          <h2 class="text-2xl md:text-3xl tracking-widest-custom mb-4 font-medium" style="color: {{ section.settings.plan_heading_color }};">{{ section.settings.plan_title }}</h2>
          <hr class="gold-line max-w-[60px] mx-auto" style="border-color: {{ section.settings.plan_eyebrow_color }};">
          <p class="text-sm" style="color: {{ section.settings.plan_desc_color }};">{{ section.settings.plan_desc }}</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {% assign plan_blocks = section.blocks | where: "type", "plan" %}
          {% for block in plan_blocks %}
            {%- comment -%}
              商品を選択している場合は、名称・価格・画像・URL・即予約バッジを
              商品から自動取得する（プランページ側のarea-lp.liquid/
              destination-plans.liquidと同じ考え方）。選択していなければ
              従来通りの手入力フィールドを使う。
            {%- endcomment -%}
            {%- assign linked_product = block.settings.product -%}
            {%- assign plan_variant = linked_product.selected_or_first_available_variant -%}
            {%- assign plan_is_instant = false -%}
            {%- if linked_product.tags contains '即予約' -%}{%- assign plan_is_instant = true -%}{%- endif -%}
            {%- if linked_product -%}
              {%- assign plan_name_source = linked_product.title -%}
              {%- assign plan_region_source = linked_product.metafields.custom.plan_area_name.value -%}
              {%- assign plan_desc_source = linked_product.description | strip_html -%}
              {%- assign plan_url_source = linked_product.url -%}
              {%- assign plan_price_source = plan_variant.price | money_without_currency | prepend: '¥' -%}
            {%- else -%}
              {%- assign plan_name_source = block.settings.plan_name -%}
              {%- assign plan_region_source = block.settings.plan_region -%}
              {%- assign plan_desc_source = block.settings.plan_detail -%}
              {%- assign plan_url_source = block.settings.plan_url | default: '#' -%}
              {%- assign plan_price_source = block.settings.plan_price -%}
            {%- endif -%}
            {% assign plan_name_display = plan_name_source
              | replace: '0', '<span class="num-fix">0</span>'
              | replace: '1', '<span class="num-fix">1</span>'
              | replace: '2', '<span class="num-fix">2</span>'
              | replace: '3', '<span class="num-fix">3</span>'
              | replace: '4', '<span class="num-fix">4</span>'
              | replace: '5', '<span class="num-fix">5</span>'
              | replace: '6', '<span class="num-fix">6</span>'
              | replace: '7', '<span class="num-fix">7</span>'
              | replace: '8', '<span class="num-fix">8</span>'
              | replace: '9', '<span class="num-fix">9</span>'
            %}
            <a href="{{ plan_url_source }}" class="group block border border-gray-200 bg-white hover:shadow-xl transition-shadow duration-300 fade-in" {{ block.shopify_attributes }}>
              <div class="relative aspect-[4/3] overflow-hidden">
                {% if block.settings.is_popular %}
                  <span class="absolute top-4 left-4 z-10 text-white text-xs font-bold px-3 py-1 tracking-wider" style="background-color: {{ block.settings.plan_badge_color | default: 'var(--gold)' }};">{{ block.settings.badge }}</span>
                {% endif %}
                {% if linked_product.featured_image %}
                  {% assign plan_img_class = 'w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ' | append: block.settings.image_position %}
                  {{ linked_product.featured_image | image_url: width: 800 | image_tag: class: plan_img_class, loading: 'lazy', alt: plan_name_source }}
                {% elsif block.settings.plan_img %}
                  {% assign plan_img_class = 'w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ' | append: block.settings.image_position %}
                  {{ block.settings.plan_img | image_url: width: 800 | image_tag: class: plan_img_class, loading: 'lazy', alt: plan_name_source }}
                {% else %}
                  <div class="w-full h-full bg-gray-200"></div>
                {% endif %}
              </div>
              <div class="p-6">
                <p class="font-serif-display text-sm tracking-widest-custom mb-1 font-bold" style="color: {{ block.settings.plan_title_color }};">{{ plan_region_source }}</p>
                <h3 class="text-lg font-bold mb-3" style="color: {{ block.settings.plan_title_color }};">{{ plan_name_display }}</h3>
                <p class="text-sm mb-4 h-10 line-clamp-2" style="color: {{ block.settings.plan_desc_color }};">{{ plan_desc_source }}</p>

                <div class="mb-6">
                  {% if linked_product %}
                    {% if plan_is_instant %}
                      <span class="inline-block border border-green-600 text-green-600 text-[10px] px-2 py-1 font-bold bg-green-50">即予約できます</span>
                    {% else %}
                      <span class="inline-block border border-gray-500 text-gray-600 text-[10px] px-2 py-1 font-bold bg-amber-50">現地確認後ご回答</span>
                    {% endif %}
                  {% else %}
                    {% if block.settings.availability == 'instant' %}
                      <span class="inline-block border border-green-600 text-green-600 text-[10px] px-2 py-1 font-bold bg-green-50">即予約できます</span>
                    {% else %}
                      <span class="inline-block border border-gray-500 text-gray-600 text-[10px] px-2 py-1 font-bold bg-amber-50">現地確認後ご回答</span>
                    {% endif %}
                  {% endif %}
                </div>

                <div class="flex justify-between items-end border-t border-gray-100 pt-4">
                  <div>
                    <span class="text-xl font-bold" style="color: {{ block.settings.plan_price_color }};">{{ plan_price_source }}</span>
                    <span class="text-xs text-gray-500 ml-1">
                      {% if block.settings.show_tax_label %}税込 / {% else %}/ {% endif %}2名
                    </span>
                  </div>
                  <span class="text-xs font-bold group-hover:underline" style="color: {{ block.settings.plan_price_color }};">詳細を見る ＞</span>
                </div>
              </div>
            </a>
          {% endfor %}
        </div>
      </div>
    </section>

    <section id="destinations" class="py-24 px-6 bg-ivory">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16 fade-in">
          <p class="font-serif-display tracking-widest-custom mb-2 font-bold" style="color: {{ section.settings.dest_eyebrow_color }};">Destinations</p>
          <h2 class="text-2xl md:text-3xl tracking-widest-custom mb-4 font-medium" style="color: {{ section.settings.dest_heading_color }};">{{ section.settings.dest_title }}</h2>
          <hr class="gold-line max-w-[60px] mx-auto" style="border-color: {{ section.settings.dest_eyebrow_color }};">
          <p class="text-sm" style="color: {{ section.settings.dest_desc_color }};">{{ section.settings.dest_desc }}</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {% assign dest_blocks = section.blocks | where: "type", "destination" %}
          {% for block in dest_blocks %}
            <a href="{{ block.settings.dest_url | default: '#' }}" class="group relative aspect-[4/5] overflow-hidden fade-in block" {{ block.shopify_attributes }}>
              {% if block.settings.dest_img %}
                {% assign dest_img_class = 'absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ' | append: block.settings.image_position %}
                {{ block.settings.dest_img | image_url: width: 800 | image_tag: class: dest_img_class, loading: 'lazy', alt: block.settings.dest_name }}
              {% else %}
                <div class="absolute inset-0 w-full h-full bg-gray-300"></div>
              {% endif %}

              <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black/90 via-black/40 to-transparent pointer-events-none"></div>
              <div class="absolute bottom-0 left-0 w-full p-8 z-10" style="text-shadow: 0px 4px 10px rgba(0,0,0,0.8);">
                <p class="font-serif-display tracking-widest-custom text-sm mb-1 font-bold" style="color: {{ block.settings.dest_country_color | default: 'var(--gold)' }};">{{ block.settings.dest_country }}</p>
                <h3 class="text-3xl tracking-widest-custom mb-2 font-bold" style="color: {{ block.settings.dest_name_color | default: '#ffffff' }};">{{ block.settings.dest_name }}</h3>
                {% assign dest_meta_display = block.settings.dest_meta
                  | replace: '0', '<span class="num-fix">0</span>'
                  | replace: '1', '<span class="num-fix">1</span>'
                  | replace: '2', '<span class="num-fix">2</span>'
                  | replace: '3', '<span class="num-fix">3</span>'
                  | replace: '4', '<span class="num-fix">4</span>'
                  | replace: '5', '<span class="num-fix">5</span>'
                  | replace: '6', '<span class="num-fix">6</span>'
                  | replace: '7', '<span class="num-fix">7</span>'
                  | replace: '8', '<span class="num-fix">8</span>'
                  | replace: '9', '<span class="num-fix">9</span>'
                %}
                <p class="text-xs font-medium" style="color: {{ block.settings.dest_meta_color | default: '#e5e7eb' }};">{{ dest_meta_display }}</p>
              </div>
            </a>
          {% endfor %}
        </div>

        {% if section.settings.show_dest_more %}
          <div class="text-center mt-12 fade-in">
            <a href="{{ section.settings.dest_more_link | default: '#' }}" class="btn btn-outline-dark">{{ section.settings.dest_more_text }}</a>
          </div>
        {% endif %}

      </div>
    </section>

    <section class="py-24 px-6">
      <div class="max-w-5xl mx-auto">
        {%- comment -%}
          見出し・本文中の半角数字（例:「3つの安心」「39店舗」）だけ
          ベースラインが沈んで見える不具合を、「人気プラン」のプラン名で
          既に使っていたnum-fixの仕組みをここにも適用して補正。
        {%- endcomment -%}
        {% assign trust_heading_display = section.settings.trust_heading
          | replace: '0', '<span class="num-fix">0</span>'
          | replace: '1', '<span class="num-fix">1</span>'
          | replace: '2', '<span class="num-fix">2</span>'
          | replace: '3', '<span class="num-fix">3</span>'
          | replace: '4', '<span class="num-fix">4</span>'
          | replace: '5', '<span class="num-fix">5</span>'
          | replace: '6', '<span class="num-fix">6</span>'
          | replace: '7', '<span class="num-fix">7</span>'
          | replace: '8', '<span class="num-fix">8</span>'
          | replace: '9', '<span class="num-fix">9</span>'
        %}
        <div class="text-center mb-16 fade-in">
          <p class="font-serif-display tracking-widest-custom mb-2 font-bold" style="color: {{ section.settings.trust_eyebrow_color }};">Peace of Mind</p>
          <h2 class="text-2xl md:text-3xl tracking-widest-custom mb-4 font-medium" style="color: {{ section.settings.trust_heading_color }};">{{ trust_heading_display }}</h2>
          <hr class="gold-line max-w-[60px] mx-auto" style="border-color: {{ section.settings.trust_eyebrow_color }};">
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center">
          {% for i in (1..6) %}
            {% assign show_key = 'trust_' | append: i | append: '_show' %}
            {% assign icon_key = 'trust_' | append: i | append: '_icon' %}
            {% assign title_key = 'trust_' | append: i | append: '_title' %}
            {% assign desc_key = 'trust_' | append: i | append: '_desc' %}

            {% if section.settings[show_key] %}
              {% assign trust_title_display = section.settings[title_key]
                | replace: '0', '<span class="num-fix">0</span>'
                | replace: '1', '<span class="num-fix">1</span>'
                | replace: '2', '<span class="num-fix">2</span>'
                | replace: '3', '<span class="num-fix">3</span>'
                | replace: '4', '<span class="num-fix">4</span>'
                | replace: '5', '<span class="num-fix">5</span>'
                | replace: '6', '<span class="num-fix">6</span>'
                | replace: '7', '<span class="num-fix">7</span>'
                | replace: '8', '<span class="num-fix">8</span>'
                | replace: '9', '<span class="num-fix">9</span>'
              %}
              {% assign trust_desc_display = section.settings[desc_key] | newline_to_br
                | replace: '0', '<span class="num-fix">0</span>'
                | replace: '1', '<span class="num-fix">1</span>'
                | replace: '2', '<span class="num-fix">2</span>'
                | replace: '3', '<span class="num-fix">3</span>'
                | replace: '4', '<span class="num-fix">4</span>'
                | replace: '5', '<span class="num-fix">5</span>'
                | replace: '6', '<span class="num-fix">6</span>'
                | replace: '7', '<span class="num-fix">7</span>'
                | replace: '8', '<span class="num-fix">8</span>'
                | replace: '9', '<span class="num-fix">9</span>'
              %}
              <div class="fade-in" style="transition-delay: {{ forloop.index0 | times: 100 }}ms;">
                <div class="w-16 h-16 mx-auto bg-ivory rounded-full flex items-center justify-center mb-6" style="color: {{ section.settings.trust_icon_color }};">
                  <i data-lucide="{{ section.settings[icon_key] }}" class="w-8 h-8"></i>
                </div>
                <h3 class="text-lg font-bold tracking-widest-custom mb-4" style="color: {{ section.settings.trust_title_color }};">{{ trust_title_display }}</h3>
                <p class="text-sm leading-relaxed" style="color: {{ section.settings.trust_desc_color }};">{{ trust_desc_display }}</p>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
    <section id="dress" class="py-24 px-6 bg-ivory">
      <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div class="aspect-[3/4] overflow-hidden fade-in">
          {% if section.settings.dress_image %}
            {% assign dress_img_class = 'w-full h-full object-cover ' | append: section.settings.dress_image_position %}
            {{ section.settings.dress_image | image_url: width: 1000 | image_tag: class: dress_img_class, loading: 'lazy', alt: section.settings.dress_title }}
          {% else %}
            <div class="w-full h-full bg-gray-300"></div>
          {% endif %}
        </div>
        <div class="fade-in">
          <p class="font-serif-display tracking-widest-custom mb-2 font-bold" style="color: {{ section.settings.dress_eyebrow_color }};">Dress</p>
          <h2 class="text-2xl md:text-2xl tracking-widest-custom mb-6 leading-tight font-medium" style="color: {{ section.settings.dress_heading_color }}; word-break: keep-all; overflow-wrap: break-word;">{{ section.settings.dress_title | newline_to_br }}</h2>
          <hr class="gold-line max-w-[60px] ml-0" style="border-color: {{ section.settings.dress_eyebrow_color }};">
          <p class="text-sm border-gold leading-loose mb-8" style="color: {{ section.settings.dress_desc_color }};">{{ section.settings.dress_desc | newline_to_br }}</p>
          <a href="{{ section.settings.dress_link | default: '#' }}" class="btn btn-outline-dark">{{ section.settings.dress_btn }}</a>
        </div>
      </div>
    </section>

    <section id="flow" class="py-24 px-6 bg-[#1a1a1a] text-white">
      <div class="max-w-6xl mx-auto text-center mb-16 fade-in">
        <p class="font-serif-display tracking-widest-custom mb-2 font-bold" style="color: {{ section.settings.flow_eyebrow_color }};">Flow</p>
        <h2 class="text-2xl md:text-3xl tracking-widest-custom font-medium" style="color: {{ section.settings.flow_heading_color }};">{{ section.settings.flow_heading }}</h2>
        <hr class="border-t opacity-40 max-w-[60px] mx-auto mt-6" style="border-color: {{ section.settings.flow_eyebrow_color }};">
      </div>

      <div class="max-w-6xl mx-auto">
        <div class="flex flex-col md:flex-row items-start justify-between gap-6 md:gap-2">
          {% assign flow_blocks = section.blocks | where: "type", "flow" %}
          {% for block in flow_blocks %}
            <div class="text-center w-full md:flex-1 fade-in" style="transition-delay: {{ forloop.index0 | times: 100 }}ms;" {{ block.shopify_attributes }}>
              <div class="font-serif-display text-3xl mb-3" style="color: {{ section.settings.flow_eyebrow_color }};">0{{ forloop.index }}</div>
              <h4 class="text-base font-bold tracking-widest-custom mb-3" style="color: {{ block.settings.step_title_color }};">{{ block.settings.step_title }}</h4>
              <p class="text-xs leading-relaxed text-center px-2" style="color: {{ block.settings.step_desc_color }};">{{ block.settings.step_desc }}</p>
            </div>

            {% unless forloop.last %}
              <div class="hidden md:flex fade-in items-center mt-4" style="transition-delay: {{ forloop.index0 | times: 100 }}ms; color: {{ section.settings.flow_eyebrow_color }};">
                <i data-lucide="arrow-right" class="w-5 h-5"></i>
              </div>
              <div class="flex md:hidden justify-center w-full fade-in" style="transition-delay: {{ forloop.index0 | times: 100 }}ms; color: {{ section.settings.flow_eyebrow_color }};">
                <i data-lucide="arrow-down" class="w-5 h-5"></i>
              </div>
            {% endunless %}
          {% endfor %}
        </div>
      </div>
    </section>

    <section id="faq" class="py-24 px-6">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-16 fade-in">
          <p class="font-serif-display tracking-widest-custom mb-2 font-bold" style="color: {{ section.settings.faq_eyebrow_color }};">FAQ</p>
          <h2 class="text-2xl md:text-3xl tracking-widest-custom mb-4 font-medium" style="color: {{ section.settings.faq_heading_color }};">よくあるご質問</h2>
          <hr class="gold-line max-w-[60px] mx-auto" style="border-color: {{ section.settings.faq_eyebrow_color }};">
        </div>

        <div class="space-y-4 fade-in">
          {% assign faq_blocks = section.blocks | where: "type", "faq" %}
          {% for block in faq_blocks %}
