          {% if section.settings.dd_subtitle != blank %}
            <p class="font-serif-display tracking-widest-custom mb-3" style="color:{{ section.settings.dd_sub_color | default: '#B8860B' }};">{{ section.settings.dd_subtitle }}</p>
