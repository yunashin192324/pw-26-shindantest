              <button class="qa-toggle w-full text-left flex justify-between items-center py-4 focus:outline-none">
                <span class="text-sm font-bold tracking-wider pr-4" style="color: {{ block.settings.faq_q_color }};">Q. {{ block.settings.question }}</span>
                <i data-lucide="plus" class="w-5 h-5 flex-shrink-0 transition-transform duration-300" style="color: {{ section.settings.faq_eyebrow_color }};"></i>
              </button>
              <div class="qa-answer max-h-0 overflow-hidden">
                <p class="text-sm leading-loose pt-2 pb-4" style="color: {{ block.settings.faq_a_color }};">A. {{ block.settings.answer | newline_to_br }}</p>
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="text-center mt-12 fade-in">
          <a href="{{ section.settings.faq_link | default: '#' }}" class="btn btn-outline-dark">FAQをもっと見る</a>
        </div>
      </div>
    </section>

    {% if section.settings.show_bottom_cta %}
