{%- comment -%}
  destination-intro — 都市の概要文。Destination metaobjectの
  `description`（都市一覧カード・ヒーローのリード文と共通のフィールド）を
  省略せずフルで表示する。文字色・背景色はセクション設定から変更可能。
{%- endcomment -%}
{%- assign destination = shop.metaobjects.destination.values | where: 'slug.value', page.handle | first -%}

{%- if destination and destination.description.value != blank -%}
<section{% if section.settings.bg_ivory %} class="dst-bg-ivory"{% endif %}>
  <div class="dst-container" style="max-width:760px;">
    <div class="dst-section-head dst-reveal">
      <p class="dst-eyebrow" style="color:{{ section.settings.eyebrow_color }};">{{ section.settings.eyebrow }}</p>
      <h2 style="color:{{ section.settings.heading_color }};">{% render 'safe-linebreak', text: section.settings.heading %}</h2>
      <hr class="dst-divider">
    </div>
    <div class="dst-reveal" style="font-size:0.95rem;line-height:1.9;white-space:pre-line;color:{{ section.settings.body_color }};">
      {{ destination.description.value | strip_html }}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "都市 概要",
  "settings": [
    { "type": "checkbox", "id": "bg_ivory", "label": "背景をアイボリーにする", "default": false },
    { "type": "text", "id": "eyebrow", "label": "英字見出し", "default": "About" },
    { "type": "color", "id": "eyebrow_color", "label": "英字見出し色", "default": "#c9a96e" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "この街で撮る理由" },
    { "type": "color", "id": "heading_color", "label": "見出し色", "default": "#1a1a1a" },
    { "type": "color", "id": "body_color", "label": "本文色", "default": "#4b5563" }
  ],
  "presets": [{ "name": "都市 概要" }]
}
{% endschema %}
