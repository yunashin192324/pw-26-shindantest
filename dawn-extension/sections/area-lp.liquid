{% comment %}
  ファイル名: sections/area-lp.liquid
  役割: 撮影地の詳細ページ（例: page.area-2.json＝ダナン）。
  いただいたpage.area-2.jsonの設定・ブロック構造（reason / location /
  schedule / gallery / faq / plan）を完全にそのまま踏襲して再構築した
  もの。**設定・ブロックのIDは1つも変えていないため、今すでに入って
  いるダナンのデータ（page.area-2.json）はそのまま流用できます。**

  変更したのは「plan」ブロックだけです。今までは価格・バッジ・
  リンク先（shopify://products/...）を全部手入力していましたが、
  「商品」欄でShopify Productを直接選ぶと、価格・在庫・バッジは商品の
  実データから自動反映されるようにしました（商品を選ばなければ、
  今までどおり手入力の値がそのまま使われるので、既存の
  plan_CezWBX / plan_grNwE7 の表示は変わりません）。
{% endcomment %}

<script>
  if (!document.getElementById('tw-config')) {
    var twConfig = document.createElement('script');
    twConfig.id = 'tw-config';
    twConfig.innerHTML = "tailwind.config = { theme: { extend: { colors: { ivory: '#FAF8F5', gold: '#B8860B', 'gold-light': '#D4A843', dark: '#1a1a1a' }, fontFamily: { serif: ['var(--font-heading-family, serif)', 'serif'], sans: ['var(--font-body-family, sans-serif)', 'sans-serif'] } } } };";
    document.head.appendChild(twConfig);
  }
  if (!document.getElementById('tw-cdn')) {
    var twScript = document.createElement('script');
    twScript.id = 'tw-cdn';
    twScript.src = 'https://cdn.tailwindcss.com/3.4.17';
    document.head.appendChild(twScript);
  }
</script>

<style>
  #area-lp-{{ section.id }} .divider-gold { width: 40px; height: 2px; background: #B8860B; }
  #area-lp-{{ section.id }} .accordion-panel { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  #area-lp-{{ section.id }} .accordion-panel.open { max-height: 400px; }
</style>

{%- assign reason_blocks = section.blocks | where: 'type', 'reason' -%}
{%- assign location_blocks = section.blocks | where: 'type', 'location' -%}
{%- assign schedule_blocks = section.blocks | where: 'type', 'schedule' -%}
{%- assign gallery_blocks = section.blocks | where: 'type', 'gallery' -%}
{%- assign faq_blocks = section.blocks | where: 'type', 'faq' -%}
{%- assign plan_blocks = section.blocks | where: 'type', 'plan' -%}

<div id="area-lp-{{ section.id }}" class="w-full bg-white" style="font-family: var(--font-body-family, sans-serif); font-size: calc(var(--font-body-scale, 1) * 100%);">

  {% comment %} --- HERO --- {% endcomment %}
  <section class="relative w-full h-[70vh] overflow-hidden">
    {% if section.settings.hero_image != blank %}
      {% assign hero_class = 'w-full h-full object-cover ' | append: section.settings.hero_image_position %}
      {{ section.settings.hero_image | image_url: width: 2000 | image_tag: class: hero_class, loading: 'eager' }}
    {% else %}
      <div class="w-full h-full bg-gray-200"></div>
    {% endif %}
    <div class="absolute inset-0 bg-black/35 flex items-end">
      <div class="max-w-7xl mx-auto w-full px-6 pb-12">
        <p class="font-serif text-sm tracking-[0.2em] uppercase mb-2" style="color:{{ section.settings.hero_eyebrow_color | default: '#ffffff' }};">{{ section.settings.hero_eyebrow }}</p>
        <h1 class="font-serif font-light mb-3 text-[{{ section.settings.hero_heading_size_sp | default: 24 }}px] md:text-[{{ section.settings.hero_heading_size | default: 40 }}px]" style="color:{{ section.settings.hero_heading_color | default: '#ffffff' }};">{{ section.settings.hero_heading | newline_to_br }}</h1>
        <p class="text-[{{ section.settings.hero_lede_size_sp | default: 13 }}px] md:text-[{{ section.settings.hero_lede_size | default: 15 }}px]" style="color:{{ section.settings.hero_lede_color | default: '#ffffff' }};">{{ section.settings.hero_lede }}</p>
      </div>
    </div>
  </section>

  {% comment %} --- パンくず --- {% endcomment %}
  <div class="max-w-7xl mx-auto px-4 py-3 text-xs text-gray-500">
    {% if section.settings.breadcrumb_1_text != blank %}
      {% if section.settings.breadcrumb_1_url != blank %}<a href="{{ section.settings.breadcrumb_1_url }}" class="hover:text-gold">{{ section.settings.breadcrumb_1_text }}</a>{% else %}<span>{{ section.settings.breadcrumb_1_text }}</span>{% endif %}
    {% endif %}
    {% if section.settings.breadcrumb_2_text != blank %}
      <span class="mx-1">/</span>
      {% if section.settings.breadcrumb_2_url != blank %}<a href="{{ section.settings.breadcrumb_2_url }}" class="hover:text-gold">{{ section.settings.breadcrumb_2_text }}</a>{% else %}<span>{{ section.settings.breadcrumb_2_text }}</span>{% endif %}
    {% endif %}
    {% if section.settings.breadcrumb_3_text != blank %}<span class="mx-1">/</span><span>{{ section.settings.breadcrumb_3_text }}</span>{% endif %}
  </div>

  {% comment %} --- 選ばれる理由 --- {% endcomment %}
  {% if reason_blocks.size > 0 %}
  <section class="py-16">
    <div class="max-w-5xl mx-auto px-4">
      <div class="text-center mb-12">
        <p class="font-serif text-sm tracking-[0.15em] uppercase mb-2" style="color:{{ section.settings.features_eyebrow_color | default: '#B8860B' }};">{{ section.settings.features_eyebrow }}</p>
        <h2 class="text-2xl font-light" style="color:{{ section.settings.features_heading_color }};">{{ section.settings.features_heading }}</h2>
        <div class="divider-gold mx-auto mt-3"></div>
        {% if section.settings.features_desc != blank %}
          <p class="text-sm mt-4 max-w-2xl mx-auto text-[{{ section.settings.features_desc_size_sp | default: 13 }}px] md:text-[{{ section.settings.features_desc_size | default: 14 }}px]" style="color:{{ section.settings.features_desc_color | default: '#4b5563' }};">{{ section.settings.features_desc }}</p>
        {% endif %}
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        {% for block in reason_blocks %}
          <div {{ block.shopify_attributes }}>
            <h3 class="font-medium mb-2 text-[{{ block.settings.title_size_sp | default: 15 }}px] md:text-[{{ block.settings.title_size | default: 16 }}px]" style="color:{{ block.settings.title_color | default: '#1a1a1a' }};">{{ block.settings.title }}</h3>
            <p class="leading-relaxed text-[{{ block.settings.desc_size_sp | default: 13 }}px] md:text-[{{ block.settings.desc_size | default: 14 }}px]" style="color:{{ block.settings.desc_color | default: '#4b5563' }};">{{ block.settings.desc | newline_to_br }}</p>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% comment %} --- 撮影スポット --- {% endcomment %}
  {% if location_blocks.size > 0 %}
  <section class="py-16 bg-ivory">
    <div class="max-w-5xl mx-auto px-4">
      <div class="text-center mb-12">
        <p class="font-serif text-sm tracking-[0.15em] uppercase mb-2" style="color:{{ section.settings.location_eyebrow_color | default: '#B8860B' }};">{{ section.settings.location_eyebrow }}</p>
        <h2 class="text-2xl font-light" style="color:{{ section.settings.location_heading_color }};">{{ section.settings.location_heading }}</h2>
        <div class="divider-gold mx-auto mt-3"></div>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {% for block in location_blocks %}
          <div {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {% assign loc_class = 'w-full h-full object-cover rounded-lg ' | append: block.settings.image_position %}
              <div style="height:{{ block.settings.img_height_sp | default: 200 }}px;" class="md:!h-[{{ block.settings.img_height_pc | default: 225 }}px]">
                {{ block.settings.image | image_url: width: 700 | image_tag: class: loc_class, loading: 'lazy' }}
              </div>
            {% endif %}
            <h3 class="mt-4 font-medium text-[{{ block.settings.title_size_sp | default: 14 }}px] md:text-[{{ block.settings.title_size | default: 24 }}px]{% if block.settings.title_is_serif %} font-serif{% endif %}" style="color:{{ block.settings.title_color | default: '#1a1a1a' }};">{{ block.settings.title }}</h3>
            <p class="mt-2 text-[{{ block.settings.desc_size_sp | default: 11 }}px] md:text-[{{ block.settings.desc_size | default: 14 }}px]{% if block.settings.desc_is_serif %} font-serif{% endif %}" style="color:{{ block.settings.desc_color | default: '#4b5563' }};">{{ block.settings.desc }}</p>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% comment %} --- モデルスケジュール --- {% endcomment %}
  {% if schedule_blocks.size > 0 %}
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-4">
      <div class="text-center mb-12">
        <p class="font-serif text-sm tracking-[0.15em] uppercase mb-2" style="color:{{ section.settings.schedule_eyebrow_color | default: '#B8860B' }};">{{ section.settings.schedule_eyebrow }}</p>
        <h2 class="text-2xl font-light" style="color:{{ section.settings.schedule_heading_color }};">{{ section.settings.schedule_heading }}</h2>
        <div class="divider-gold mx-auto mt-3"></div>
      </div>
      {% for block in schedule_blocks %}
        <div class="flex gap-6 border-b border-gray-200 py-4" {{ block.shopify_attributes }}>
          <span class="w-16 shrink-0 font-serif text-[{{ block.settings.time_size_sp | default: 15 }}px] md:text-[{{ block.settings.time_size | default: 18 }}px]" style="color:{{ block.settings.time_color | default: '#B8860B' }};">{{ block.settings.time }}</span>
          <div class="text-[{{ block.settings.desc_size_sp | default: 13 }}px] md:text-[{{ block.settings.desc_size | default: 14 }}px]" style="color:{{ block.settings.content_color | default: '#4b5563' }};">{{ block.settings.desc }}</div>
        </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% comment %} --- フォトギャラリー --- {% endcomment %}
  {%- assign gallery_product = section.settings.gallery_product -%}
  {% if gallery_product and gallery_product.images.size > 0 or gallery_blocks.size > 0 %}
  <section class="py-16" style="background-color:#1a1a1a;">
    <div class="text-center mb-12 px-4">
      <p class="font-serif text-sm tracking-[0.15em] uppercase mb-2" style="color:{{ section.settings.gallery_eyebrow_color | default: '#D4A843' }};">{{ section.settings.gallery_eyebrow }}</p>
      <h2 class="text-2xl font-light" style="color:{{ section.settings.gallery_heading_color | default: '#ffffff' }};">{{ section.settings.gallery_heading }}</h2>
      <div class="divider-gold mx-auto mt-3"></div>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 px-4 max-w-6xl mx-auto" id="area-gallery-{{ section.id }}">
      {% if gallery_product %}
        {% for image in gallery_product.images %}
          <div class="w-full relative area-gallery-item cursor-pointer" style="padding-top:125%;" data-full="{{ image | image_url: width: 1800 }}" data-index="{{ forloop.index0 }}">
            {{ image | image_url: width: 700 | image_tag: class: 'absolute inset-0 w-full h-full object-cover object-center', loading: 'lazy' }}
          </div>
        {% endfor %}
      {% else %}
        {% for block in gallery_blocks %}
          {% if block.settings.image != blank %}
            <div class="w-full relative area-gallery-item cursor-pointer" style="padding-top:125%;" data-full="{{ block.settings.image | image_url: width: 1800 }}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              {% assign gal_class = 'absolute inset-0 w-full h-full object-cover ' | append: block.settings.image_position %}
              {{ block.settings.image | image_url: width: 700 | image_tag: class: gal_class, loading: 'lazy' }}
            </div>
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  </section>

  {% comment %}
    ギャラリーのライトボックス。タップで拡大表示、左右スワイプ/矢印で
    前後の画像に切り替え。
  {% endcomment %}
  <div id="area-lightbox-{{ section.id }}" class="fixed inset-0 z-50 hidden" style="background:rgba(0,0,0,0.92);">
    <button type="button" class="area-lightbox-close absolute top-4 right-4 text-white text-3xl leading-none w-10 h-10 flex items-center justify-center" aria-label="閉じる">×</button>
    <button type="button" class="area-lightbox-prev absolute left-2 md:left-6 top-1/2 -translate-y-1/2 text-white text-4xl leading-none w-12 h-12 flex items-center justify-center" aria-label="前の画像">‹</button>
    <button type="button" class="area-lightbox-next absolute right-2 md:right-6 top-1/2 -translate-y-1/2 text-white text-4xl leading-none w-12 h-12 flex items-center justify-center" aria-label="次の画像">›</button>
    <div class="w-full h-full flex items-center justify-center px-12">
      <img class="area-lightbox-img" src="" alt="" style="max-width:100%;max-height:90vh;object-fit:contain;">
    </div>
  </div>
  <script>
    (function () {
      var root = document.getElementById('area-gallery-{{ section.id }}');
      var lightbox = document.getElementById('area-lightbox-{{ section.id }}');
      if (!root || !lightbox) return;
      var img = lightbox.querySelector('.area-lightbox-img');
      var items = Array.prototype.slice.call(root.querySelectorAll('.area-gallery-item'));
      var current = 0;
      var touchStartX = null;

      function show(i) {
        if (items.length === 0) return;
        current = (i + items.length) % items.length;
        img.src = items[current].getAttribute('data-full');
      }
      function open(i) {
        show(i);
        lightbox.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
      function close() {
        lightbox.classList.add('hidden');
        document.body.style.overflow = '';
      }

      items.forEach(function (el, i) {
        el.addEventListener('click', function () { open(i); });
      });
      lightbox.querySelector('.area-lightbox-close').addEventListener('click', close);
      lightbox.querySelector('.area-lightbox-prev').addEventListener('click', function () { show(current - 1); });
      lightbox.querySelector('.area-lightbox-next').addEventListener('click', function () { show(current + 1); });
      lightbox.addEventListener('click', function (e) {
        if (e.target === lightbox) close();
      });
      document.addEventListener('keydown', function (e) {
        if (lightbox.classList.contains('hidden')) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') show(current - 1);
        if (e.key === 'ArrowRight') show(current + 1);
      });
      lightbox.addEventListener('touchstart', function (e) {
        touchStartX = e.changedTouches[0].clientX;
      }, { passive: true });
      lightbox.addEventListener('touchend', function (e) {
        if (touchStartX === null) return;
        var dx = e.changedTouches[0].clientX - touchStartX;
        if (Math.abs(dx) > 40) {
          if (dx < 0) { show(current + 1); } else { show(current - 1); }
        }
        touchStartX = null;
      }, { passive: true });
    })();
  </script>
  {% endif %}

  {% comment %} --- プラン一覧 --- {% endcomment %}
  {% if plan_blocks.size > 0 %}
  <section class="py-16 bg-ivory">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <p class="font-serif text-sm tracking-[0.15em] uppercase mb-2" style="color:{{ section.settings.plans_eyebrow_color | default: '#B8860B' }};">{{ section.settings.plans_eyebrow }}</p>
        <h2 class="text-2xl font-light" style="color:{{ section.settings.plans_heading_color }};">{{ section.settings.plans_heading }}</h2>
        <div class="divider-gold mx-auto mt-3"></div>
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        {% for block in plan_blocks %}
          {%- assign linked_product = block.settings.product -%}
          <a href="{% if linked_product %}{{ linked_product.url }}{% else %}{{ block.settings.plan_url }}{% endif %}" class="group block rounded-lg overflow-hidden border border-gray-200 bg-white" {{ block.shopify_attributes }}>
            <div class="w-full relative" style="padding-top:60%;">
              {% if linked_product and linked_product.featured_image %}
                {{ linked_product.featured_image | image_url: width: 900 | image_tag: class: 'absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105', loading: 'lazy' }}
              {% elsif block.settings.plan_image != blank %}
                {% assign plan_img_class = 'absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 ' | append: block.settings.image_position %}
                {{ block.settings.plan_image | image_url: width: 900 | image_tag: class: plan_img_class, loading: 'lazy' }}
              {% endif %}
              {%- assign show_badge = block.settings.badge -%}
              {%- if linked_product and linked_product.tags contains '人気' -%}{%- assign show_badge = '人気No.1' -%}{%- endif -%}
              {% if show_badge != blank %}
                <span class="absolute top-3 left-3 px-3 py-1 text-[11px] font-bold text-white rounded-sm" style="background-color:{{ block.settings.plan_badge_color | default: '#c9a96e' }};">{{ show_badge }}</span>
              {% endif %}
            </div>
            <div class="p-6">
              <p class="text-xs uppercase tracking-wider text-gray-400">{{ block.settings.region }}</p>
              <h3 class="font-medium text-base mt-1" style="color:{{ block.settings.plan_title_color | default: '#1a1a1a' }};">{% if linked_product %}{{ linked_product.title }}{% else %}{{ block.settings.title }}{% endif %}</h3>
              <p class="text-sm mt-2" style="color:{{ block.settings.plan_desc_color | default: '#4b5563' }};">
                {% if linked_product and linked_product.description != blank %}{{ linked_product.description | strip_html | truncate: 50 }}{% else %}{{ block.settings.desc }}{% endif %}
              </p>
              <div class="flex items-center justify-between mt-4">
                {%- assign is_instant = false -%}
                {%- if block.settings.availability == 'instant' -%}{%- assign is_instant = true -%}{%- endif -%}
                {%- if linked_product -%}
                  {%- assign is_instant = false -%}
                  {%- if linked_product.tags contains '即予約' -%}{%- assign is_instant = true -%}{%- endif -%}
                {%- endif -%}
                {% if is_instant %}
                  <span class="text-xs px-3 py-1 rounded-full" style="background:#eef4ec;color:#4b7a52;">即予約できます</span>
                {% else %}
                  <span class="text-xs px-3 py-1 rounded-full" style="background:#f6efe2;color:#8f6a08;">現地確認後ご回答</span>
                {% endif %}
                <span class="font-serif" style="color:{{ block.settings.plan_price_color | default: '#c9a96e' }};font-size: calc(var(--font-heading-scale, 1) * 18px);">
                  {% if linked_product %}{{ linked_product.price | money }}{% else %}{{ block.settings.price }}{% if block.settings.show_tax %}<span class="text-xs">（税込）</span>{% endif %}{% endif %}
                </span>
              </div>
            </div>
          </a>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% comment %} --- FAQ --- {% endcomment %}
  {% if faq_blocks.size > 0 %}
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-4">
      <div class="text-center mb-12">
        <p class="font-serif text-sm tracking-[0.15em] uppercase mb-2" style="color:{{ section.settings.faq_eyebrow_color | default: '#B8860B' }};">{{ section.settings.faq_eyebrow | default: 'FAQ' }}</p>
        <h2 class="text-2xl font-light" style="color:{{ section.settings.faq_heading_color }};">{{ section.settings.faq_heading | default: 'よくあるご質問' }}</h2>
        <div class="divider-gold mx-auto mt-3"></div>
      </div>
      <div class="space-y-3">
        {% for block in faq_blocks %}
          <div class="border border-gray-200 rounded-lg overflow-hidden" {{ block.shopify_attributes }}>
            <button class="area-lp-accordion-btn w-full text-left px-5 py-4 flex justify-between items-center text-sm font-medium" style="color:{{ block.settings.faq_q_color | default: '#1a1a1a' }};">
              <span>{{ block.settings.question }}</span>
              <span style="color:#B8860B;">+</span>
            </button>
            <div class="accordion-panel px-5">
              <p class="text-sm pb-4" style="color:{{ block.settings.faq_a_color | default: '#4b5563' }};">{{ block.settings.answer | newline_to_br }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% comment %} --- Sticky CTA --- {% endcomment %}
  {% if section.settings.sticky_btn_1_text != blank or section.settings.sticky_btn_2_text != blank %}
  <div class="fixed bottom-0 left-0 right-0 z-40 flex gap-2 p-3 bg-white/95 border-t border-gray-200 md:hidden">
    {% if section.settings.sticky_btn_1_text != blank %}
      <a href="{{ section.settings.sticky_btn_1_url }}" class="flex-1 text-center py-3 rounded text-sm font-medium border border-dark">{{ section.settings.sticky_btn_1_text }}</a>
    {% endif %}
    {% if section.settings.sticky_btn_2_text != blank %}
      <a href="{{ section.settings.sticky_btn_2_url }}" class="flex-1 text-center py-3 rounded text-sm font-medium text-white" style="background-color:#B8860B;">{{ section.settings.sticky_btn_2_text }}</a>
    {% endif %}
  </div>
  {% endif %}
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('#area-lp-{{ section.id }} .area-lp-accordion-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var panel = btn.nextElementSibling;
      var icon = btn.querySelector('span:last-child');
      panel.classList.toggle('open');
      icon.textContent = panel.classList.contains('open') ? '−' : '+';
    });
  });
});
</script>

{% schema %}
{
  "name": "撮影地エリアLP",
  "settings": [
    { "type": "header", "content": "パンくずリスト" },
    { "type": "text", "id": "breadcrumb_1_text", "label": "1階層目 テキスト", "default": "TOP" },
    { "type": "url", "id": "breadcrumb_1_url", "label": "1階層目 リンク" },
    { "type": "text", "id": "breadcrumb_2_text", "label": "2階層目 テキスト", "default": "撮影地一覧" },
    { "type": "url", "id": "breadcrumb_2_url", "label": "2階層目 リンク" },
    { "type": "text", "id": "breadcrumb_3_text", "label": "3階層目 テキスト（現在地）" },

    { "type": "header", "content": "ヒーロー" },
    { "type": "image_picker", "id": "hero_image", "label": "画像" },
    { "type": "select", "id": "hero_image_position", "label": "トリミング位置", "options": [
        { "value": "object-center", "label": "中央" }, { "value": "object-top", "label": "上部" },
        { "value": "object-bottom", "label": "下部" }, { "value": "object-left", "label": "左側" }, { "value": "object-right", "label": "右側" }
      ], "default": "object-center" },
    { "type": "text", "id": "hero_eyebrow", "label": "サブタイトル" },
    { "type": "color", "id": "hero_eyebrow_color", "label": "サブタイトル色", "default": "#ffffff" },
    { "type": "textarea", "id": "hero_heading", "label": "タイトル" },
    { "type": "color", "id": "hero_heading_color", "label": "タイトル色", "default": "#ffffff" },
