{%- comment -%}
  destinations-hero — /pages/destinations の先頭セクション。
  高さ70vh、世界観の伝わる1枚写真、見出しは固定文言だが
  サブコピー/画像/CTAはすべて編集可能。

  共通ヘッダー統一のため、このページ群は独自レイアウト
  (theme.destinations)を使わず通常のtheme.liquidで表示する。
  そのため専用CSS/JSと.destinations-scopeラッパーをここで読み込む
  （閉じタグはこのテンプレート最後のdestinations-ctaセクションで出力）。
{%- endcomment -%}
{{ 'destinations.css' | asset_url | stylesheet_tag }}
<script src="{{ 'destinations.js' | asset_url }}" defer></script>
<div class="destinations-scope">
<section class="dst-hero">
  <div class="dst-hero-media">
    {%- if section.settings.image -%}
      <img
        src="{{ section.settings.image | image_url: width: 2400 }}"
        srcset="{{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1800 }} 1800w, {{ section.settings.image | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
        loading="eager"
        fetchpriority="high"
        width="2400" height="1350"
      >
    {%- endif -%}
  </div>
  <div class="dst-hero-content">
    <p class="dst-eyebrow dst-reveal">{{ section.settings.eyebrow }}</p>
    <h1 class="dst-reveal dst-reveal-1">{{ section.settings.heading | newline_to_br }}</h1>
    <p class="dst-lede dst-reveal dst-reveal-2">{{ section.settings.description }}</p>
    <div class="dst-cta-row dst-reveal dst-reveal-3">
      {%- if section.settings.diagnosis_url != blank -%}
        <a href="{{ section.settings.diagnosis_url }}" class="dst-btn dst-btn-gold">{{ section.settings.diagnosis_label }}</a>
      {%- endif -%}
      <a href="#dst-search" class="dst-btn dst-btn-outline">{{ section.settings.search_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "撮影地一覧 ヒーロー",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "背景写真" },
    { "type": "text", "id": "eyebrow", "label": "英字見出し", "default": "DESTINATIONS" },
    { "type": "textarea", "id": "heading", "label": "メイン見出し", "default": "世界中の撮影地から\nおふたりだけの物語を。" },
    { "type": "textarea", "id": "description", "label": "サブコピー", "default": "120以上の撮影地から、おふたりらしい一枚が生まれる場所を見つけてください。" },
    { "type": "text", "id": "diagnosis_label", "label": "診断ボタン文言", "default": "30秒診断" },
    { "type": "url", "id": "diagnosis_url", "label": "診断ボタンリンク先", "info": "診断ページ公開まではリンク先を空欄にしておくとボタン自体が非表示になります。" },
    { "type": "text", "id": "search_label", "label": "検索ボタン文言", "default": "撮影地を見る" }
  ],
  "presets": [{ "name": "撮影地一覧 ヒーロー" }]
}
{% endschema %}
