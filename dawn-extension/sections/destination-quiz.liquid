    { "type": "text", "id": "heading", "label": "見出し", "default": "あなたにぴったりの撮影地診断" },
    { "type": "textarea", "id": "intro_text", "label": "説明文", "default": "簡単な質問に答えるだけで、おふたりに合う撮影地をご提案します。" },
    { "type": "image_picker", "id": "intro_image", "label": "冒頭の画像（任意）", "info": "設定すると、ページ読み込み時にゆっくり浮かび上がる演出が入ります。空欄でも問題なく動作します。" },
    { "type": "text", "id": "start_label", "label": "開始ボタン文言", "default": "診断をはじめる" },
    { "type": "text", "id": "result_heading", "label": "結果見出し", "default": "おふたりにおすすめの撮影地" },
    { "type": "text", "id": "restart_label", "label": "やり直しボタン文言", "default": "もう一度診断する" },
    { "type": "header", "content": "配色" },
    { "type": "color", "id": "bg_color", "label": "背景色", "default": "#FAF8F5" },
    { "type": "color", "id": "text_color", "label": "文字色", "default": "#161513" },
    { "type": "header", "content": "モーション設定" },
    { "type": "checkbox", "id": "enable_custom_cursor", "label": "カーソル追従の円を表示する（PCのみ）", "default": true },
    { "type": "checkbox", "id": "enable_smooth_scroll", "label": "慣性のあるスムーススクロールを有効にする", "default": true, "info": "このページ内のスクロール全体に適用されます。" }
  ],
  "presets": [{ "name": "撮影地 30秒診断" }]
}
