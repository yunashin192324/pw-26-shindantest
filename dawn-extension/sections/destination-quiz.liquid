{%- comment -%}
  destination-quiz — 撮影地 30秒診断（シネマティック・ギャラリーUI版）
  ==================================================================
  【診断ロジックは変更していません】
  質問データ(QUESTIONS)・スコアリング・結果マッチング(matchDestinations)・
  ステップ制御の条件分岐は旧版から一切変更なし。変更したのは見た目と
  モーションのみ。

  結果候補は都市名を1件もハードコードしていない。ページ読み込み時に
  Liquidが shop.metaobjects.destination.values を全件JSONに書き出し、
  診断終了後はJS側でそのJSONをスコアでソートするだけ。新しい都市を
  Metaobjectに追加してthemesタグを設定するだけで診断結果は自動反映される。

  質問文・選択肢の文言はこのファイル内のQUESTIONS配列を直接編集する
  （選択肢とテーマタグの対応関係を壊さないよう、あえてブロック化して
  いない。変更したい場合は聞いてください）。

  ------------------------------------------------------------------
  【今回のUI/UX刷新について】
  参考にしたのは taotajima.jp/works/Magic の「余白・静けさ・シネマ
  ティックな間」というデザイン思想で、コードは一切参照/複製していない
  完全新規実装。GSAP + SplitType + Lenis をCDNから読み込み、フェード
  ＋移動＋ぼかしを組み合わせた演出、単語単位のテキスト reveal、
  慣性のあるスムーススクロール、カーソル追従の小さな円、ホバー時の
  微細なチルトを実装。

  【意図的に実装していない項目とその理由】
  - ページ遷移時のシェアード・エレメント・トランジション：
    サイト全体のリンク挙動・レイアウト(theme.liquid)に手を入れる必要が
    あり、このセクション単体の範囲を超え、他ページの動作に影響する
    リスクが大きいため見送り。将来的に希望があれば別途相談。
  - スクロール連動の背景/前景パララックス：
    この診断はステップごとに1画面で完結するUI(長いスクロールページ
    ではない)なので、「スクロール量」ではなく「カーソル移動量」に
    連動した微細なパララックス(背景0.7倍・画像1.0倍・文字1.2倍相当の
    速度差)に置き換えている。タッチ端末ではカーソルが存在しないため
    自動的に無効になる(仕様書の「モバイルは半減」の代替として無効化)。

  【フォールバック】
  CDN読み込みに失敗した場合(オフライン環境やCDN障害時)でも診断機能
  自体は必ず動作するよう、GSAP/SplitType/Lenisはすべて任意強化
  (progressive enhancement)として実装。読み込めない場合はCSS
  transitionによる簡易フェードに自動的に切り替わる。
  prefers-reduced-motionが有効な場合も同様に演出を最小限にする。
{%- endcomment -%}

<script>
  if (!document.getElementById('tw-config')) {
    var twConfig = document.createElement('script');
    twConfig.id = 'tw-config';
    twConfig.innerHTML = "tailwind.config = { theme: { extend: { colors: { ivory: '#FAF8F5', gold: '#B8860B', 'gold-light': '#D4A843', dark: '#1a1a1a' }, fontFamily: { serif: ['var(--font-heading-family, serif)', 'serif'], sans: ['var(--font-body-family, sans-serif)', 'sans-serif'] } } } };";
    document.head.appendChild(twConfig);
  }
  if (!document.getElementById('tw-cdn')) {
    var twScript = document.createElement('script');
    twScript.id = 'tw-cdn';
    twScript.src = '{{ "tailwind-3.4.17.js" | asset_url }}';
    document.head.appendChild(twScript);
  }
</script>

{%- comment -%}
  演出強化ライブラリ(GSAP / SplitType / Lenis)をidempotentに読み込む。
  同じセクションが複数回描画されたり、他のセクションと共存しても
  二重読み込みしない。
{%- endcomment -%}
<script>
  (function () {
    function loadOnce(id, src) {
      if (document.getElementById(id)) return;
      var s = document.createElement('script');
      s.id = id;
      s.src = src;
      s.defer = true;
      document.head.appendChild(s);
    }
    loadOnce('dq-lib-gsap', 'https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js');
    loadOnce('dq-lib-splittype', 'https://cdn.jsdelivr.net/npm/split-type@0.3.4/dist/split-type.min.js');
    loadOnce('dq-lib-lenis', 'https://cdn.jsdelivr.net/npm/lenis@1.1.18/dist/lenis.min.js');
  })();
</script>

{%- comment -%}
  全Destinationをテーマタグ付きでJSON化。themesは選択リスト
  (単一行テキストのリスト)型なので、d.themes.valueをそのまま配列
  として使う。
{%- endcomment -%}
{%- assign all_destinations = shop.metaobjects.destination.values -%}
<script type="application/json" id="quiz-destinations-{{ section.id }}">
[
  {%- for d in all_destinations -%}
    {%- assign theme_list = d.themes.value -%}
    {
      "name": {{ d.name_ja.value | json }},
      "url": "/pages/{{ d.slug.value }}",
      "image": {{ d.hero_image.value | image_url: width: 700 | json }},
      "themes": [{% for t in theme_list %}{{ t | strip | downcase | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]
    }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
]
</script>

<style>
  #destination-quiz-{{ section.id }} {
    --dq-paper: {{ section.settings.bg_color | default: '#FAF8F5' }};
    --dq-ink: {{ section.settings.text_color | default: '#161513' }};
    --dq-muted: #85807a;
    --dq-gold: #B8860B;
    --dq-gold-light: #D4A843;
    --dq-hair: rgba(22,21,19,0.12);
    font-family: var(--font-body-family, sans-serif);
    background: var(--dq-paper);
    color: var(--dq-ink);
    position: relative;
    overflow: hidden;
  }
  #destination-quiz-{{ section.id }} * { box-sizing: border-box; }

  /* ---------- ステージ（各ステップ共通の器） ---------- */
  #destination-quiz-{{ section.id }} .dq-stage {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(64px, 10vw, 120px) clamp(20px, 6vw, 64px);
  }
  #destination-quiz-{{ section.id }} .dq-step {
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
  }
  #destination-quiz-{{ section.id }} .dq-step.is-hidden { display: none; }

  /* ---------- タイポグラフィ ---------- */
  #destination-quiz-{{ section.id }} .dq-eyebrow {
    font-family: var(--font-heading-family, serif);
    font-style: italic;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-size: 12px;
    color: var(--dq-gold);
    margin: 0 0 22px;
    text-align: center;
  }
  #destination-quiz-{{ section.id }} .dq-title {
    font-family: var(--font-heading-family, serif);
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: 0.01em;
    font-size: clamp(26px, calc(var(--font-heading-scale, 1) * 4vw), 46px);
    text-align: center;
    margin: 0 0 24px;
  }
  #destination-quiz-{{ section.id }} .dq-subtitle {
    font-size: 15px;
    line-height: 1.95;
    color: var(--dq-muted);
    text-align: center;
    max-width: 480px;
    margin: 0 auto 48px;
  }

  /* ---------- 単語分割reveal用（SplitTypeが無い場合はブロックごとfadeにフォールバック） ---------- */
  #destination-quiz-{{ section.id }} .word { display: inline-block; will-change: transform, opacity, filter; }

  /* ---------- イントロ：画像 ---------- */
  #destination-quiz-{{ section.id }} .dq-intro-media {
    width: 100%;
    max-width: 620px;
    margin: 0 auto 56px;
    aspect-ratio: 16/9;
    overflow: hidden;
    border-radius: 2px;
  }
  #destination-quiz-{{ section.id }} .dq-intro-media img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    will-change: transform, opacity, filter;
  }

  /* ---------- CTA ---------- */
  #destination-quiz-{{ section.id }} .dq-btn {
    display: block;
    margin: 0 auto;
    padding: 18px 56px;
    border-radius: 999px;
    border: 1px solid var(--dq-ink);
    background: transparent;
    color: var(--dq-ink);
    font-family: var(--font-heading-family, serif);
    font-size: 14px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.5s cubic-bezier(.22,1,.36,1), color 0.5s cubic-bezier(.22,1,.36,1), border-color 0.5s cubic-bezier(.22,1,.36,1);
  }
  #destination-quiz-{{ section.id }} .dq-btn:hover {
    background: var(--dq-ink);
    color: var(--dq-paper);
  }
  #destination-quiz-{{ section.id }} .dq-link {
    display: block;
    margin: 56px auto 0;
    background: none;
    border: none;
    padding: 0;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dq-muted);
    cursor: pointer;
    position: relative;
  }
  #destination-quiz-{{ section.id }} .dq-link::after {
    content: '';
    position: absolute; left: 0; right: 0; bottom: -4px; height: 1px;
    background: currentColor; transform: scaleX(0); transform-origin: left;
    transition: transform 0.5s cubic-bezier(.22,1,.36,1);
  }
  #destination-quiz-{{ section.id }} .dq-link:hover::after { transform: scaleX(1); }

  /* ---------- 進捗（ミニマルな行番号スタイル） ---------- */
  #destination-quiz-{{ section.id }} .dq-progress {
    display: flex; align-items: center; gap: 18px;
    max-width: 560px; margin: 0 auto 64px;
  }
  #destination-quiz-{{ section.id }} .dq-progress-index {
    font-family: var(--font-heading-family, serif);
    font-style: italic;
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--dq-muted);
    white-space: nowrap;
  }
  #destination-quiz-{{ section.id }} .dq-progress-track {
    flex: 1; height: 1px; background: var(--dq-hair); position: relative;
  }
  #destination-quiz-{{ section.id }} .dq-progress-fill {
    position: absolute; left: 0; top: -1px; height: 1px; width: 0%;
    background: var(--dq-gold);
  }

  /* ---------- 質問文 ---------- */
  #destination-quiz-{{ section.id }} .dq-question {
    font-family: var(--font-heading-family, serif);
    font-weight: 400;
    text-align: center;
    font-size: clamp(20px, calc(var(--font-heading-scale, 1) * 2.6vw), 30px);
    line-height: 1.5;
    margin: 0 0 56px;
  }

  /* ---------- 選択肢：ギャラリーの作品リストのようなミニマル行 ---------- */
  #destination-quiz-{{ section.id }} .dq-choices { max-width: 560px; margin: 0 auto; }
  #destination-quiz-{{ section.id }} .dq-choice {
    display: flex; align-items: baseline; gap: 20px;
    width: 100%; text-align: left;
    background: none; border: none; border-top: 1px solid var(--dq-hair);
    padding: 22px 4px;
    font-size: 16px; color: var(--dq-ink);
    cursor: pointer;
    position: relative;
    will-change: transform;
    transition: transform 0.5s cubic-bezier(.22,1,.36,1), color 0.5s cubic-bezier(.22,1,.36,1);
  }
  #destination-quiz-{{ section.id }} .dq-choices > button:last-child { border-bottom: 1px solid var(--dq-hair); }
  #destination-quiz-{{ section.id }} .dq-choice-index {
    font-family: var(--font-heading-family, serif);
    font-style: italic;
    font-size: 12px;
    color: var(--dq-gold);
    flex-shrink: 0;
    width: 22px;
  }
  #destination-quiz-{{ section.id }} .dq-choice-label { flex: 1; }
  #destination-quiz-{{ section.id }} .dq-choice-arrow {
    opacity: 0; transform: translateX(-6px);
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(.22,1,.36,1);
    color: var(--dq-gold); font-size: 14px;
  }
  #destination-quiz-{{ section.id }} .dq-choice:hover { transform: translateX(10px); }
  #destination-quiz-{{ section.id }} .dq-choice:hover .dq-choice-arrow { opacity: 1; transform: translateX(0); }
  #destination-quiz-{{ section.id }} .dq-choice:focus-visible { outline: 2px solid var(--dq-gold); outline-offset: 4px; }

  /* ---------- 結果ヘッダー ---------- */
  #destination-quiz-{{ section.id }} .dq-result-head { margin-bottom: 64px; }

  /* ---------- 結果グリッド：ギャラリー作品カード ---------- */
  #destination-quiz-{{ section.id }} .dq-result-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(24px, 4vw, 48px);
  }
  @media (max-width: 860px) {
    #destination-quiz-{{ section.id }} .dq-result-grid { grid-template-columns: 1fr; max-width: 420px; margin: 0 auto; }
  }
  #destination-quiz-{{ section.id }} .dq-result-card {
    display: block; text-decoration: none; color: inherit;
    transform-style: preserve-3d; will-change: transform;
  }
  #destination-quiz-{{ section.id }} .dq-result-media {
    position: relative; width: 100%; aspect-ratio: 4/5; overflow: hidden; margin-bottom: 18px; background: #eee;
  }
  #destination-quiz-{{ section.id }} .dq-result-media img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    will-change: transform, opacity, filter;
    transition: transform 0.9s cubic-bezier(.22,1,.36,1), filter 0.9s ease;
  }
  #destination-quiz-{{ section.id }} .dq-result-card:hover .dq-result-media img {
    transform: scale(1.03); filter: brightness(1.05);
  }
  #destination-quiz-{{ section.id }} .dq-result-rank {
    position: absolute; top: 14px; left: 14px;
    font-family: var(--font-heading-family, serif); font-style: italic;
    font-size: 12px; letter-spacing: 0.06em; color: #fff;
    text-shadow: 0 1px 6px rgba(0,0,0,0.5);
  }
  #destination-quiz-{{ section.id }} .dq-result-name {
    font-family: var(--font-heading-family, serif);
    font-size: 18px; margin: 0 0 4px;
  }
  #destination-quiz-{{ section.id }} .dq-result-view {
    font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dq-gold);
  }

  /* ---------- 空状態 ---------- */
  #destination-quiz-{{ section.id }} .dq-empty { text-align: center; font-size: 14px; color: var(--dq-muted); }

  /* ---------- カスタムカーソル(マウス精密ポインタのみ) ---------- */
  #destination-quiz-{{ section.id }} .dq-cursor {
    position: fixed; top: 0; left: 0; width: 10px; height: 10px; margin: -5px 0 0 -5px;
    border-radius: 50%; background: var(--dq-gold);
    pointer-events: none; z-index: 60; opacity: 0;
    transition: width 0.35s cubic-bezier(.22,1,.36,1), height 0.35s cubic-bezier(.22,1,.36,1), margin 0.35s cubic-bezier(.22,1,.36,1), opacity 0.3s ease, background 0.3s ease;
    will-change: transform;
  }
  #destination-quiz-{{ section.id }}.dq-cursor-active .dq-stage { cursor: none; }
  #destination-quiz-{{ section.id }} .dq-cursor.is-visible { opacity: 1; }
  #destination-quiz-{{ section.id }} .dq-cursor.is-hover { width: 34px; height: 34px; margin: -17px 0 0 -17px; background: transparent; border: 1px solid var(--dq-gold); }

  /* ---------- CSSフォールバック（GSAP未読込 or prefers-reduced-motion） ---------- */
  #destination-quiz-{{ section.id }} .dq-step.dq-fallback-in { animation: dqFallbackIn 0.5s ease both; }
  @keyframes dqFallbackIn { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }

  @media (prefers-reduced-motion: reduce) {
    #destination-quiz-{{ section.id }} * { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
  }
</style>

<div id="destination-quiz-{{ section.id }}">
  <section class="dq-stage" data-dq-stage>
    <span class="dq-cursor" data-dq-cursor aria-hidden="true"></span>

    {% comment %} --- イントロ --- {% endcomment %}
    <div class="dq-step" data-step="intro">
      {%- if section.settings.intro_image != blank -%}
      <div class="dq-intro-media" data-dq-parallax="0.6">
        <img data-dq-media
          src="{{ section.settings.intro_image | image_url: width: 1400 }}"
          srcset="{{ section.settings.intro_image | image_url: width: 800 }} 800w, {{ section.settings.intro_image | image_url: width: 1400 }} 1400w"
          sizes="(min-width: 768px) 620px, 90vw"
          alt=""
          loading="eager">
      </div>
      {%- endif -%}
      <div data-dq-parallax="1.2">
        <p class="dq-eyebrow" data-dq-text>{{ section.settings.eyebrow | default: '30 SECONDS' }}</p>
        <h2 class="dq-title" data-dq-text data-dq-split>{{ section.settings.heading | default: 'あなたにぴったりの撮影地診断' }}</h2>
        <p class="dq-subtitle" data-dq-text>{{ section.settings.intro_text | default: '簡単な質問に答えるだけで、おふたりに合う撮影地をご提案します。' }}</p>
        <button type="button" class="dq-btn quiz-start" data-dq-text>{{ section.settings.start_label | default: '診断をはじめる' }}</button>
      </div>
    </div>

    {% comment %} --- 質問（テンプレート、JSで複製して差し込む） --- {% endcomment %}
    <div class="dq-step is-hidden" data-step="question-template">
      <div class="dq-progress">
        <span class="dq-progress-index quiz-progress"></span>
        <span class="dq-progress-track"><span class="dq-progress-fill quiz-progress-fill"></span></span>
      </div>
      <h3 class="dq-question quiz-question-text" data-dq-split></h3>
      <div class="dq-choices quiz-choices"></div>
    </div>

    {% comment %} --- 結果 --- {% endcomment %}
    <div class="dq-step is-hidden" data-step="result">
      <div class="dq-result-head">
        <p class="dq-eyebrow">RESULT</p>
        <h2 class="dq-title" data-dq-split>{{ section.settings.result_heading | default: 'おふたりにおすすめの撮影地' }}</h2>
      </div>
      <div class="dq-result-grid quiz-results"></div>
      <button type="button" class="dq-link quiz-restart">{{ section.settings.restart_label | default: 'もう一度診断する' }}</button>
    </div>
  </section>
</div>

<script>
(function () {
  var root = document.getElementById('destination-quiz-{{ section.id }}');
  if (!root) return;
  var stage = root.querySelector('[data-dq-stage]');
  var destinationsData = JSON.parse(document.getElementById('quiz-destinations-{{ section.id }}').textContent || '[]');
  var enableCursor = {{ section.settings.enable_custom_cursor | default: true | json }};
  var enableSmoothScroll = {{ section.settings.enable_smooth_scroll | default: true | json }};

  /* ================================================================
     診断ロジック（QUESTIONS / スコア / マッチング）は旧版から不変。
     ================================================================ */
  var QUESTIONS = [
    {
      text: 'どんな景色に惹かれますか？',
      choices: [
        { label: '透き通るビーチ', themes: ['beach', 'overwater'] },
        { label: '歴史ある街並み', themes: ['streets', 'heritage'] },
        { label: '雄大な自然・絶景', themes: ['view', 'lake', 'desert'] },
        { label: '荘厳な宮殿や教会', themes: ['palace', 'church'] }
      ]
    },
    {
      text: 'ふたりらしい撮影スタイルは？',
      choices: [
        { label: '開放的なリゾート感', themes: ['resort', 'overwater', 'beach'] },
        { label: 'クラシックで上品な雰囲気', themes: ['palace', 'museum', 'church'] },
        { label: '幻想的でロマンチック', themes: ['sunset', 'lake', 'view'] },
        { label: 'アクティブで非日常的', themes: ['desert', 'balloon'] }
      ]
    },
    {
      text: 'どんな時間帯の写真を残したいですか？',
      choices: [
        { label: '眩しい真昼のビーチ', themes: ['beach', 'overwater', 'resort'] },
        { label: '幻想的な夕暮れ', themes: ['sunset', 'view'] },
        { label: '歴史的建造物の中で', themes: ['palace', 'church', 'museum', 'library'] }
      ]
    },
    {
      text: '滞在中に楽しみたいことは？',
      choices: [
        { label: 'ゆったりリゾートステイ', themes: ['resort', 'overwater'] },
        { label: '街歩き・観光', themes: ['streets', 'museum', 'library'] },
        { label: '大自然のアクティビティ', themes: ['desert', 'balloon', 'lake'] },
        { label: '世界遺産めぐり', themes: ['heritage', 'palace'] }
      ]
    }
  ];

  var scores = {};
  var currentQuestion = 0;

  var introEl = root.querySelector('[data-step="intro"]');
  var questionTemplateEl = root.querySelector('[data-step="question-template"]');
  var resultEl = root.querySelector('[data-step="result"]');
  var progressEl = questionTemplateEl.querySelector('.quiz-progress');
  var progressFillEl = questionTemplateEl.querySelector('.quiz-progress-fill');
  var questionTextEl = questionTemplateEl.querySelector('.quiz-question-text');
  var choicesEl = questionTemplateEl.querySelector('.quiz-choices');
  var resultsEl = resultEl.querySelector('.quiz-results');

  function resetScores() {
    scores = {};
    currentQuestion = 0;
  }

  function buildChoiceButton(choice, index, onPick) {
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'dq-choice';
    btn.innerHTML =
      '<span class="dq-choice-index">' + String(index + 1).padStart(2, '0') + '</span>' +
      '<span class="dq-choice-label">' + choice.label + '</span>' +
      '<span class="dq-choice-arrow">＞</span>';
    btn.addEventListener('click', function () { onPick(choice); });
    return btn;
  }

  function showQuestion(index) {
    var q = QUESTIONS[index];
    progressEl.textContent = String(index + 1).padStart(2, '0') + ' / ' + String(QUESTIONS.length).padStart(2, '0');
    animateProgress(Math.round((index / QUESTIONS.length) * 100));
    questionTextEl.textContent = q.text;
    choicesEl.innerHTML = '';
    q.choices.forEach(function (choice, i) {
      choicesEl.appendChild(buildChoiceButton(choice, i, function (picked) {
        picked.themes.forEach(function (t) { scores[t] = (scores[t] || 0) + 1; });
        currentQuestion++;
        if (currentQuestion < QUESTIONS.length) {
          transitionStep(questionTemplateEl, questionTemplateEl, function () { showQuestion(currentQuestion); });
        } else {
          showResult();
        }
      }));
    });
    revealQuestion();
  }

  function topThemes() {
    return Object.keys(scores).sort(function (a, b) { return scores[b] - scores[a]; });
  }

  function matchDestinations() {
    var ranked = destinationsData.map(function (d) {
      var overlap = (d.themes || []).filter(function (t) { return scores[t]; })
        .reduce(function (sum, t) { return sum + scores[t]; }, 0);
      return { destination: d, score: overlap };
    });
    ranked = ranked.filter(function (r) { return r.score > 0; });
    ranked.sort(function (a, b) { return b.score - a.score; });
    if (ranked.length === 0) {
      ranked = destinationsData.slice(0, 3).map(function (d) { return { destination: d, score: 0 }; });
    }
    return ranked.slice(0, 3).map(function (r) { return r.destination; });
  }

  function showResult() {
    animateProgress(100);
    var results = matchDestinations();
    resultsEl.innerHTML = '';
    if (results.length === 0) {
      resultsEl.innerHTML = '<p class="dq-empty">診断結果を表示する撮影地がまだ登録されていません。</p>';
    } else {
      results.forEach(function (d, i) {
        var a = document.createElement('a');
        a.href = d.url;
        a.className = 'dq-result-card';
        var imgHtml = d.image
          ? '<div class="dq-result-media"><span class="dq-result-rank">No. ' + String(i + 1).padStart(2, '0') + '</span><img data-dq-media src="' + d.image + '" alt="' + d.name + '" loading="lazy"></div>'
          : '<div class="dq-result-media"><span class="dq-result-rank">No. ' + String(i + 1).padStart(2, '0') + '</span></div>';
        a.innerHTML = imgHtml + '<h4 class="dq-result-name">' + d.name + '</h4><span class="dq-result-view">View destination</span>';
        resultsEl.appendChild(a);
      });
    }
    transitionStep([introEl, questionTemplateEl], resultEl, function () { attachTilt(resultsEl.querySelectorAll('.dq-result-card')); });
  }

  root.querySelector('.quiz-start').addEventListener('click', function () {
    resetScores();
    transitionStep(introEl, questionTemplateEl, function () { showQuestion(0); });
  });
  root.querySelector('.quiz-restart').addEventListener('click', function () {
    resetScores();
    animateProgress(0);
    transitionStep(resultEl, introEl, function () { playIntro(true); });
  });

  /* ================================================================
     ここから演出レイヤー。GSAP / SplitType / Lenis が読み込めなかった
     場合やprefers-reduced-motionの場合は、簡易CSSフェードに自動で
     切り替わる（診断機能自体は常に動作する）。
     ================================================================ */
  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var finePointer = window.matchMedia && window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  var isMobile = window.matchMedia && window.matchMedia('(max-width: 768px)').matches;
  var EASE = 'cubic-bezier(0.22,1,0.36,1)';

  function libsReady() {
    return !!(window.gsap);
  }

  function animateProgress(pct) {
    if (libsReady() && !reduceMotion) {
      gsap.to(progressFillEl, { width: pct + '%', duration: 0.6, ease: EASE });
    } else {
      progressFillEl.style.transition = 'width 0.4s ease';
      progressFillEl.style.width = pct + '%';
    }
  }

  function splitWords(el) {
    if (!el || !window.SplitType) return null;
    try { return new SplitType(el, { types: 'words' }); } catch (e) { return null; }
  }

  function revealBlock(el, delay) {
    if (!el) return;
    if (libsReady() && !reduceMotion) {
      gsap.fromTo(el, { opacity: 0, y: 22, filter: 'blur(8px)' }, { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.9, ease: EASE, delay: delay || 0 });
    } else {
      el.classList.add('dq-fallback-in');
    }
  }

  function revealWords(el, delay) {
    if (!el) return;
    var split = splitWords(el);
    if (libsReady() && split && !reduceMotion) {
      gsap.fromTo(split.words, { opacity: 0, y: 18, filter: 'blur(6px)' }, {
        opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.8, ease: EASE, stagger: 0.045, delay: delay || 0,
        onComplete: function () { split.revert(); }
      });
    } else {
      if (split) split.revert();
      revealBlock(el, delay);
    }
  }

  /* ---------- ページロード演出：背景→画像→タイトル→サブタイトル→UI、計約1.5秒 ---------- */
  function playIntro(isRestart) {
    var media = introEl.querySelector('[data-dq-media]');
    var texts = introEl.querySelectorAll('[data-dq-text]');
    var title = introEl.querySelector('[data-dq-split]');

    if (!libsReady() || reduceMotion) {
      introEl.classList.add('dq-fallback-in');
      return;
    }

    var tl = gsap.timeline({ defaults: { ease: EASE } });
    tl.fromTo(introEl, { opacity: 0 }, { opacity: 1, duration: 0.35 });
    if (media) {
      tl.fromTo(media, { opacity: 0, scale: 1.08, filter: 'blur(12px)' }, { opacity: 1, scale: 1, filter: 'blur(0px)', duration: 0.7 }, '-=0.1');
    }
    var titleSplit = title ? splitWords(title) : null;
    if (titleSplit) {
      tl.fromTo(titleSplit.words, { opacity: 0, y: 24, filter: 'blur(6px)' }, {
        opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.7, stagger: 0.045,
        onComplete: function () { titleSplit.revert(); }
      }, media ? '-=0.35' : '-=0.1');
    }
    texts.forEach(function (el, i) {
      if (el === title) return;
      tl.fromTo(el, { opacity: 0, y: 16, filter: 'blur(4px)' }, { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.5 }, i === 0 ? '-=0.3' : '-=0.25');
    });
  }

  /* ---------- ステップ間トランジション：フェードアウト→フェードイン ---------- */
  function transitionStep(hideTargets, showTarget, afterShow) {
    var hideEls = Array.isArray(hideTargets) ? hideTargets : [hideTargets];
    if (!libsReady() || reduceMotion) {
      hideEls.forEach(function (el) { el.classList.add('is-hidden'); });
      showTarget.classList.remove('is-hidden');
      showTarget.classList.add('dq-fallback-in');
      if (afterShow) afterShow();
      revealStepContent(showTarget);
      return;
    }
    var tl = gsap.timeline();
    hideEls.forEach(function (el) {
      tl.to(el, { opacity: 0, y: -14, filter: 'blur(6px)', duration: 0.35, ease: EASE }, 0);
    });
    tl.add(function () {
      hideEls.forEach(function (el) { el.classList.add('is-hidden'); el.style.opacity = ''; el.style.transform = ''; el.style.filter = ''; });
      showTarget.classList.remove('is-hidden');
      gsap.fromTo(showTarget, { opacity: 0, y: 14, filter: 'blur(6px)' }, { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.55, ease: EASE });
      revealStepContent(showTarget);
      if (afterShow) afterShow();
    });
  }

  function revealStepContent(stepEl) {
    if (stepEl === resultEl) {
      revealWords(resultEl.querySelector('[data-dq-split]'), 0.1);
      staggerIn(resultsEl.querySelectorAll('.dq-result-card'), 0.25);
    }
  }

  function revealQuestion() {
    revealWords(questionTextEl, 0.05);
    staggerIn(choicesEl.querySelectorAll('.dq-choice'), 0.25);
  }

  function staggerIn(nodeList, delay) {
    var items = Array.prototype.slice.call(nodeList);
    if (!items.length) return;
    if (libsReady() && !reduceMotion) {
      gsap.fromTo(items, { opacity: 0, y: 20, filter: 'blur(6px)' }, { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.6, stagger: 0.08, delay: delay || 0, ease: EASE });
    } else {
      items.forEach(function (el) { el.classList.add('dq-fallback-in'); });
    }
  }

  /* ---------- カーソル追従の小さな円（精密ポインタのみ） ---------- */
  function initCursor() {
    if (!enableCursor || !finePointer || reduceMotion) return;
    var dot = root.querySelector('[data-dq-cursor]');
    if (!dot) return;
    root.classList.add('dq-cursor-active');
    var moveX = libsReady() ? gsap.quickTo(dot, 'x', { duration: 0.35, ease: 'power3' }) : null;
    var moveY = libsReady() ? gsap.quickTo(dot, 'y', { duration: 0.35, ease: 'power3' }) : null;
    stage.addEventListener('mousemove', function (e) {
      dot.classList.add('is-visible');
      if (moveX && moveY) { moveX(e.clientX); moveY(e.clientY); }
      else { dot.style.transform = 'translate(' + e.clientX + 'px,' + e.clientY + 'px)'; }
    });
    stage.addEventListener('mouseleave', function () { dot.classList.remove('is-visible'); });
    var hoverTargets = 'button, a';
    stage.addEventListener('mouseover', function (e) {
      if (e.target.closest && e.target.closest(hoverTargets)) dot.classList.add('is-hover');
    });
    stage.addEventListener('mouseout', function (e) {
      if (e.target.closest && e.target.closest(hoverTargets)) dot.classList.remove('is-hover');
    });
  }

  /* ---------- 結果カードの微細チルト（3deg以内、精密ポインタのみ） ---------- */
  function attachTilt(cards) {
    if (!finePointer || reduceMotion || !libsReady()) return;
    Array.prototype.forEach.call(cards, function (card) {
      var rotX = gsap.quickTo(card, 'rotateX', { duration: 0.4, ease: 'power3' });
      var rotY = gsap.quickTo(card, 'rotateY', { duration: 0.4, ease: 'power3' });
      card.style.perspective = '600px';
      card.addEventListener('mousemove', function (e) {
        var r = card.getBoundingClientRect();
        var px = (e.clientX - r.left) / r.width - 0.5;
        var py = (e.clientY - r.top) / r.height - 0.5;
        rotY(px * 6);
        rotX(py * -6);
      });
      card.addEventListener('mouseleave', function () { rotX(0); rotY(0); });
    });
  }

  /* ---------- カーソル連動パララックス（スクロールではなくポインタ移動に連動） ---------- */
  function initPointerParallax() {
    if (!finePointer || reduceMotion || !libsReady() || isMobile) return;
    var layers = introEl.querySelectorAll('[data-dq-parallax]');
    if (!layers.length) return;
    stage.addEventListener('mousemove', function (e) {
      var r = stage.getBoundingClientRect();
      var px = (e.clientX - r.left) / r.width - 0.5;
      var py = (e.clientY - r.top) / r.height - 0.5;
      layers.forEach(function (layer) {
        var speed = parseFloat(layer.getAttribute('data-dq-parallax')) || 1;
        gsap.to(layer, { x: px * 10 * speed, y: py * 6 * speed, duration: 0.6, ease: 'power3' });
      });
    });
  }

  /* ---------- 慣性のあるスムーススクロール（Lenis、任意強化） ---------- */
  function initSmoothScroll() {
    if (!enableSmoothScroll || reduceMotion || !window.Lenis || window.__dqLenisInit) return;
    window.__dqLenisInit = true;
    var lenis = new window.Lenis({
      duration: isMobile ? 0.9 : 1.2,
      easing: function (t) { return Math.min(1, 1.001 - Math.pow(2, -10 * t)); },
      smoothWheel: true,
      wheelMultiplier: isMobile ? 0.8 : 1
    });
    function raf(time) { lenis.raf(time); requestAnimationFrame(raf); }
    requestAnimationFrame(raf);
  }

  /* ---------- 初期化：ライブラリの読み込みを少し待ってから開始 ---------- */
  function boot() {
    playIntro(false);
    initCursor();
    initPointerParallax();
    initSmoothScroll();
  }
  if (libsReady() || reduceMotion) {
    boot();
  } else {
    var tries = 0;
    var waitId = setInterval(function () {
      tries++;
      if (libsReady() || tries > 40) { clearInterval(waitId); boot(); }
    }, 75);
  }
})();
</script>

