<script>
(function () {
  var root = document.getElementById('destination-quiz-{{ section.id }}');
  if (!root) return;
  var destinationsData = JSON.parse(document.getElementById('quiz-destinations-{{ section.id }}').textContent || '[]');
  var photoPool = destinationsData.filter(function (d) { return !!d.image; });
  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ================================================================
     診断ロジック（QUESTIONS / スコア / マッチング）は旧版から不変。
     「section」はキッカー表示用の英字ラベル(演出のみ、採点に影響しない)。
     ================================================================ */
  var QUESTIONS = [
    {
      section: 'SCENERY',
      text: 'どんな景色に惹かれますか？',
      choices: [
        { label: '透き通るビーチ', themes: ['beach', 'overwater'] },
        { label: '歴史ある街並み', themes: ['streets', 'heritage'] },
        { label: '雄大な自然・絶景', themes: ['view', 'lake', 'desert'] },
        { label: '荘厳な宮殿や教会', themes: ['palace', 'church'] }
      ]
    },
    {
      section: 'STYLE',
      text: 'ふたりらしい撮影スタイルは？',
      choices: [
        { label: '開放的なリゾート感', themes: ['resort', 'overwater', 'beach'] },
        { label: 'クラシックで上品な雰囲気', themes: ['palace', 'museum', 'church'] },
        { label: '幻想的でロマンチック', themes: ['sunset', 'lake', 'view'] },
        { label: 'アクティブで非日常的', themes: ['desert', 'balloon'] }
      ]
    },
    {
      section: 'MOMENT',
      text: 'どんな時間帯の写真を残したいですか？',
      choices: [
        { label: '眩しい真昼のビーチ', themes: ['beach', 'overwater', 'resort'] },
        { label: '幻想的な夕暮れ', themes: ['sunset', 'view'] },
        { label: '歴史的建造物の中で', themes: ['palace', 'church', 'museum', 'library'] }
      ]
    },
    {
      section: 'ACTIVITY',
      text: '滞在中に楽しみたいことは？',
      choices: [
        { label: 'ゆったりリゾートステイ', themes: ['resort', 'overwater'] },
        { label: '街歩き・観光', themes: ['streets', 'museum', 'library'] },
        { label: '大自然のアクティビティ', themes: ['desert', 'balloon', 'lake'] },
        { label: '世界遺産めぐり', themes: ['heritage', 'palace'] }
      ]
    }
  ];

  /* destination-theme-label.liquidの日本語マッピングと同期させること */
  var THEME_LABELS = {
    beach: 'ビーチ', streets: '街並み', palace: '宮殿', heritage: '世界遺産', view: '絶景',
    lake: '湖', desert: '砂漠', balloon: '気球', church: '教会', museum: '美術館',
    library: '図書館', resort: 'リゾート', sunset: 'サンセット', overwater: '水上ヴィラ'
  };

  var scores = {};
  var currentQuestion = 0;
  var selectedThemesOrder = [];

  function resetScores() { scores = {}; currentQuestion = 0; selectedThemesOrder = []; }

  function matchDestinations() {
    var ranked = destinationsData.map(function (d) {
      var overlap = (d.themes || []).filter(function (t) { return scores[t]; })
        .reduce(function (sum, t) { return sum + scores[t]; }, 0);
      return { destination: d, score: overlap };
    });
    ranked = ranked.filter(function (r) { return r.score > 0; });
    ranked.sort(function (a, b) { return b.score - a.score; });
    if (ranked.length === 0) {
      ranked = destinationsData.slice(0, 3).map(function (d) { return { destination: d, score: 0 }; });
    }
    return ranked.slice(0, 3);
  }

  function calcMatching(destination) {
    var selected = Object.keys(scores);
    var conds = selected.map(function (t) {
      return { key: t, label: THEME_LABELS[t] || t, matched: (destination.themes || []).indexOf(t) !== -1 };
    });
    var matched = conds.filter(function (c) { return c.matched; });
    var unmatched = conds.filter(function (c) { return !c.matched; });
    var rate = conds.length > 0 ? Math.round(matched.length / conds.length * 100) : 100;
    return { rate: rate, matched: matched, unmatched: unmatched };
  }

  /* ================================================================
     演出レイヤー(GSAP等の外部ライブラリ不使用。素のCSSアニメーション
     + バニラJSのみ。参考HTMLと同じ手法)
     ================================================================ */
  function q(sel, ctx) { return (ctx || root).querySelector(sel); }
  function qa(sel, ctx) { return Array.prototype.slice.call((ctx || root).querySelectorAll(sel)); }

  function showScreen(name, anim) {
    anim = anim || 'dq-anim-right';
    qa('[data-dq-screen]').forEach(function (s) { s.classList.remove('active'); s.style.display = 'none'; });
    var el = q('[data-dq-screen="' + name + '"]');
    if (!el) return;
    el.style.display = 'block';
    el.classList.add('active');
    el.classList.remove('dq-anim-right', 'dq-anim-left', 'dq-anim-up');
    void el.offsetWidth;
    el.classList.add(anim);
    var stageTop = root.getBoundingClientRect().top + window.pageYOffset;
    window.scrollTo({ top: stageTop, behavior: reduceMotion ? 'auto' : 'smooth' });
    if (name === 'result') initResultParallax();
  }

  function maskReveal(el, html) {
    if (!el) return;
    el.innerHTML = '<span class="dq-mask-wrap"><span class="dq-reveal-word">' + html + '</span></span>';
  }

  function setSceneBg(key, src) {
    var container = q('[data-dq-bg="' + key + '"]');
    if (!container || !src) return;
    if (container.getAttribute('data-current') === src) return;
    container.setAttribute('data-current', src);
    var img = document.createElement('img');
    img.src = src; img.alt = ''; img.decoding = 'async';
    container.appendChild(img);
    requestAnimationFrame(function () { requestAnimationFrame(function () { img.classList.add('is-active'); }); });
    var olds = qa('img', container).filter(function (o) { return o !== img; });
    setTimeout(function () { olds.forEach(function (o) { o.remove(); }); }, 1700);
  }

  function createSlideshow(key, images, interval) {
    var container = q('[data-dq-bg="' + key + '"]');
    if (!container || !images.length) return;
    var layers = images.map(function (src, i) {
      var img = document.createElement('img');
      img.src = src; img.alt = ''; img.decoding = 'async'; img.loading = i === 0 ? 'eager' : 'lazy';
      if (i === 0) img.className = 'is-active';
      container.appendChild(img);
      return img;
    });
    container.setAttribute('data-current', images[0]);
    if (reduceMotion || images.length < 2) return;
    var idx = 0;
    setInterval(function () {
      layers[idx].classList.remove('is-active');
      idx = (idx + 1) % layers.length;
      layers[idx].classList.add('is-active');
    }, interval || 7000);
  }

  function scatterParticles(count) {
    var container = q('[data-dq-particles]');
    if (!container || reduceMotion) return;
    for (var i = 0; i < count; i++) {
      var p = document.createElement('span');
      p.className = 'dq-particle';
      var size = 2 + Math.random() * 4;
      p.style.width = size + 'px'; p.style.height = size + 'px';
      p.style.left = (Math.random() * 100) + '%';
      p.style.top = (20 + Math.random() * 70) + '%';
      p.style.animationDuration = (10 + Math.random() * 10) + 's';
      p.style.animationDelay = (Math.random() * 8) + 's';
      container.appendChild(p);
    }
  }

  function toast(msg) {
    var t = q('[data-dq-toast]');
    if (!t) return;
    t.textContent = msg;
    t.classList.add('is-shown');
    setTimeout(function () { t.classList.remove('is-shown'); }, 3000);
  }

  var resultParallaxBound = false;
  function initResultParallax() {
    if (resultParallaxBound || reduceMotion) return;
    resultParallaxBound = true;
    var bg = q('[data-dq-bg="result"]');
    var ticking = false;
    window.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        var sc = window.scrollY || 0;
        if (bg) bg.style.transform = 'translateY(' + (sc * 0.2) + 'px)';
        ticking = false;
      });
    }, { passive: true });
  }

  /* ---------- イントロ：スライドショー背景 + 粒子 + hero pills ---------- */
  (function initIntro() {
    var reelSetting = {{ section.settings.intro_image | image_url: width: 1600 | json }};
    if (reelSetting) {
      createSlideshow('start', [reelSetting], 7000);
    } else if (photoPool.length) {
      createSlideshow('start', photoPool.slice(0, 5).map(function (d) { return d.image; }), 7000);
    }
    if (photoPool.length) {
      createSlideshow('loading', photoPool.slice().reverse().slice(0, 5).map(function (d) { return d.image; }), 5000);
    }
    scatterParticles(16);
    var pillsEl = q('[data-dq-pills]');
    if (pillsEl) {
      var pills = [
        QUESTIONS.length + '問診断',
        '{{ section.settings.time_estimate | default: "約1分" }}',
        destinationsData.length + '以上のエリア'
      ];
      pillsEl.innerHTML = pills.map(function (p) { return '<span class="dq-hero-pill dq-serif">' + p + '</span>'; }).join('');
    }
  })();

  /* ---------- 質問画面 ---------- */
  var qEls = {
    progressFill: q('[data-dq-progress-fill]'),
    qNum: q('[data-dq-q-num]'),
    qSection: q('[data-dq-q-section]'),
    qTitle: q('[data-dq-q-title]'),
    opts: q('[data-dq-opts]'),
    back: q('[data-dq-back]')
  };

  function showQuestion(index) {
    var qData = QUESTIONS[index];
    var total = QUESTIONS.length;
    var step = index + 1;
    setSceneBg('question', questionBackgroundFor(index));
    qEls.progressFill.style.width = (step / total * 100) + '%';
    qEls.qNum.textContent = '#' + String(step).padStart(2, '0');
    qEls.qSection.textContent = qData.section || '';
    maskReveal(qEls.qTitle, qData.text);
    qEls.opts.innerHTML = '';
    qData.choices.forEach(function (choice, i) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'dq-opt';
      btn.style.animation = 'dqRevealUp .6s var(--dq-ease) ' + (i * .06) + 's both';
      btn.innerHTML = '<span class="dq-opt-inner"><span class="dq-opt-main">' + choice.label + '</span><span class="dq-opt-radio"></span></span>';
      btn.addEventListener('click', function (e) {
        var r = document.createElement('span');
        r.className = 'dq-ripple';
        var rect = btn.getBoundingClientRect();
        var sz = Math.max(rect.width, rect.height);
        r.style.width = sz + 'px'; r.style.height = sz + 'px';
        r.style.left = (e.clientX - rect.left - sz / 2) + 'px';
        r.style.top = (e.clientY - rect.top - sz / 2) + 'px';
        btn.appendChild(r);
        setTimeout(function () { r.remove(); }, 700);
        btn.classList.add('is-selected');
        choice.themes.forEach(function (t) {
          scores[t] = (scores[t] || 0) + 1;
          if (selectedThemesOrder.indexOf(t) === -1) selectedThemesOrder.push(t);
        });
        currentQuestion = index + 1;
        setTimeout(function () {
          if (currentQuestion < QUESTIONS.length) { showQuestion(currentQuestion); }
          else { showLoading(); }
        }, 320);
      });
      qEls.opts.appendChild(btn);
    });
    qEls.back.style.display = index > 0 ? 'block' : 'none';
    showScreen('question', 'dq-anim-right');
  }

  function questionBackgroundFor(index) {
    if (!photoPool.length) return '';
    return photoPool[index % photoPool.length].image;
  }

  qEls.back.addEventListener('click', function () {
    if (currentQuestion > 0) {
      currentQuestion = currentQuestion - 1;
      showQuestion(currentQuestion);
    } else {
      showScreen('start', 'dq-anim-left');
    }
  });

  q('[data-dq-start]').addEventListener('click', function () {
    resetScores();
    currentQuestion = 0;
    showQuestion(0);
  });

  /* ---------- ローディング(スロットマシン) ---------- */
  function showLoading() {
    showScreen('loading', 'dq-anim-up');
    var ranked = matchDestinations();
    var top = ranked[0] ? ranked[0].destination : null;
    var allNames = destinationsData.map(function (d) { return d.name; });
    var slot = q('[data-dq-slot]');
    var final = q('[data-dq-loading-final]');
    final.style.display = 'none';
    final.classList.remove('is-visible');
    q('.dq-loading-slot').style.display = 'block';

    if (reduceMotion || !allNames.length) {
      setTimeout(function () { renderResult(ranked); }, 400);
      return;
    }

    var items = allNames.concat(allNames.slice(0, 6), top ? top.name : allNames[0]);
    slot.innerHTML = items.map(function (n) { return '<div class="dq-loading-slot-item dq-serif">' + n + '</div>'; }).join('');
    var idx = 0, speed = 80, count = 0, max = items.length - 1;
    function spin() {
      slot.style.transform = 'translateY(-' + (idx * 56) + 'px)';
      idx++; count++;
      speed = count < max * .6 ? 80 : count < max * .85 ? 120 : 200;
      if (count < max) { setTimeout(spin, speed); }
      else {
        setTimeout(function () {
          q('.dq-loading-slot').style.display = 'none';
          final.style.display = 'block';
          final.textContent = top ? top.name : '';
          setTimeout(function () { final.classList.add('is-visible'); }, 50);
          setTimeout(function () { renderResult(ranked); }, 1100);
        }, 300);
      }
    }
    setTimeout(spin, 400);
  }

  /* ---------- 結果画面 ---------- */
  function renderResult(ranked) {
    if (!ranked.length) {
      q('[data-dq-result-name]').textContent = '診断結果を表示する撮影地がまだ登録されていません。';
      q('[data-dq-result-name-en]').textContent = '';
      showScreen('result', 'dq-anim-up');
      return;
    }
    var top = ranked[0].destination;
    var alts = ranked.slice(1, 3).map(function (r) { return r.destination; });

    setSceneBg('result', top.image);
    maskReveal(q('[data-dq-result-name]'), top.name);
    q('[data-dq-result-name-en]').textContent = top.nameEn || '';

    var summaryEl = q('[data-dq-summary]');
    var summaryTags = selectedThemesOrder.map(function (t) { return THEME_LABELS[t] || t; });
    summaryEl.innerHTML = summaryTags.map(function (t) { return '<span class="dq-summary-tag">' + t + '</span>'; }).join('');

    var mt = calcMatching(top);
    var matchedHtml = '', unmatchedHtml = '';
    if (mt.matched.length) {
      matchedHtml = '<span class="dq-chips-label dq-serif">— マッチした条件 —</span><div class="dq-chips">'
        + mt.matched.map(function (c) { return '<span class="dq-chip dq-chip-yes">✓ ' + c.label + '</span>'; }).join('') + '</div>';
    }
    if (mt.unmatched.length) {
      unmatchedHtml = '<span class="dq-chips-label dq-serif">— このエリアでは弱い条件 —</span><div class="dq-chips">'
        + mt.unmatched.map(function (c) { return '<span class="dq-chip dq-chip-no">✗ ' + c.label + '</span>'; }).join('') + '</div>';
    }
    q('[data-dq-matching]').innerHTML =
      '<div class="dq-matching-label-row"><span class="dq-matching-label-text dq-serif">MATCHING SCORE</span><span class="dq-matching-rate dq-serif">' + mt.rate + '%</span></div>'
      + '<div class="dq-matching-track"><div class="dq-matching-fill" data-dq-match-fill style="width:0%"></div></div>'
      + '<div class="dq-chips-wrap">' + matchedHtml + unmatchedHtml + '</div>';
    setTimeout(function () { var f = q('[data-dq-match-fill]'); if (f) f.style.width = mt.rate + '%'; }, 300);

    q('[data-dq-appeal]').textContent = top.description || '';
    q('[data-dq-appeal]').style.display = top.description ? 'block' : 'none';

    var tagsHtml = (top.themes || []).slice(0, 4).map(function (t) { return '<span class="dq-dest-tag">' + (THEME_LABELS[t] || t) + '</span>'; }).join('');
    q('[data-dq-main-card]').innerHTML =
      '<div class="dq-dest-card" data-dq-main-card-el>'
      + '<div class="dq-dest-card-head"><span class="dq-dest-card-head-label dq-serif">RECOMMENDED DESTINATION</span><span class="dq-dest-card-head-rank dq-serif">Best Match</span></div>'
      + (top.image ? '<div class="dq-dest-card-img-wrap"><img class="dq-dest-card-img" src="' + top.image + '" alt="' + top.name + '" loading="lazy"></div>' : '')
      + '<div class="dq-dest-card-body">'
      + '<h3 class="dq-dest-card-title">' + top.name + (top.nameEn ? '（' + top.nameEn + '）' : '') + '</h3>'
      + (top.description ? '<p class="dq-dest-card-reason">' + top.description + '</p>' : '')
      + '<div class="dq-dest-tags">' + tagsHtml + '</div>'
      + '<a href="' + top.url + '" class="dq-dest-link">この撮影地のページを見る</a>'
      + '</div></div>';

    {%- assign consult_url = section.settings.consult_url | default: '/pages/consultation' -%}
    q('[data-dq-consult]').innerHTML =
      '<div class="dq-consult-block" data-dq-consult-el>'
      + '<span class="dq-consult-label dq-serif">CONSULTATION</span>'
      + '<p class="dq-consult-title">{{ section.settings.consult_title | default: "撮影地選びやプランのこと、もっと詳しく相談しませんか？" }}</p>'
      + '<a href="{{ consult_url }}" class="dq-consult-btn dq-serif">{{ section.settings.consult_button_label | default: "オンライン相談を予約する" }}</a>'
      + '<p class="dq-consult-note">相談は無料です。診断結果を元にスタッフが詳しくご案内します。</p>'
      + '</div>';

    var altEl = q('[data-dq-alt]');
    altEl.innerHTML = alts.map(function (d) {
      var am = calcMatching(d);
      var tagStr = (d.themes || []).slice(0, 2).map(function (t) { return THEME_LABELS[t] || t; }).join('　');
      return '<a href="' + d.url + '" class="dq-alt-card">'
        + (d.image ? '<div class="dq-alt-card-img-wrap"><img class="dq-alt-card-img" src="' + d.image + '" alt="' + d.name + '" loading="lazy"></div>' : '')
        + '<div class="dq-alt-card-body">'
        + '<p class="dq-alt-card-name">' + d.name + '</p>'
        + '<div class="dq-alt-match-wrap"><div class="dq-alt-match-bar"><div class="dq-alt-match-fill" style="width:' + am.rate + '%"></div></div><span class="dq-alt-match-pct">' + am.rate + '%</span></div>'
        + '<p class="dq-alt-card-sub">' + tagStr + '</p>'
        + '</div></a>';
    }).join('');

    showScreen('result', 'dq-anim-up');

    setTimeout(function () {
      var mc = q('[data-dq-main-card-el]'); if (mc) mc.classList.add('is-visible');
      var ce = q('[data-dq-consult-el]'); if (ce) ce.classList.add('is-visible');
      qa('.dq-alt-card').forEach(function (el, i) {
        setTimeout(function () { el.classList.add('is-visible'); }, 100 + i * 90);
      });
    }, 100);

    var shareUrl = window.location.href.split('?')[0];
    var shareText = '撮影地診断で「' + top.name + '」をおすすめされました✨\n';
    q('[data-dq-insta-copy]').onclick = function () {
      var msg = '『' + top.name + '』をおすすめされました✨\n\n撮影地診断はこちら→ ' + shareUrl + '\n\n#フォトウェディング #' + top.name;
      if (navigator.clipboard) {
        navigator.clipboard.writeText(msg).then(function () { toast('コピーしました！インスタストーリーに貼りつけてシェア！'); })
          .catch(function () { toast('コピーできませんでした'); });
      }
    };
    q('[data-dq-share-x]').onclick = function () { window.open('https://twitter.com/intent/tweet?text=' + encodeURIComponent(shareText + shareUrl), '_blank'); };
    q('[data-dq-share-line]').onclick = function () { window.open('https://social-plugins.line.me/lineit/share?url=' + encodeURIComponent(shareUrl) + '&text=' + encodeURIComponent(shareText), '_blank'); };
    q('[data-dq-share-copy]').onclick = function () {
      if (navigator.clipboard) {
        navigator.clipboard.writeText(shareUrl).then(function () { toast('URLをコピーしました'); }).catch(function () { toast('コピーできませんでした'); });
      }
    };
  }

  q('[data-dq-restart]').addEventListener('click', function () {
    resetScores();
    showScreen('start', 'dq-anim-up');
  });
})();
</script>

{% schema %}
{
  "name": "撮影地 30秒診断",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "英字見出し", "default": "PHOTO WEDDING DESTINATION" },
    { "type": "textarea", "id": "heading", "label": "見出し", "default": "あなたにぴったりの、撮影地が見つかります。" },
    { "type": "textarea", "id": "intro_text", "label": "説明文", "default": "質問に答えるだけで、おふたりに合う撮影地をご提案します。" },
    { "type": "image_picker", "id": "intro_image", "label": "冒頭の画像（任意）", "info": "空欄の場合、登録済みの撮影地の写真が自動でスライドショー表示されます。" },
    { "type": "text", "id": "time_estimate", "label": "所要時間の表示文言", "default": "約1分" },
    { "type": "text", "id": "start_label", "label": "開始ボタン文言", "default": "はじめる" },
    { "type": "header", "content": "ローディング画面" },
    { "type": "textarea", "id": "loading_text", "label": "文言（改行は<br>で入力）", "default": "おふたりに最適な<br>撮影地を探しています" },
    { "type": "header", "content": "結果画面" },
    { "type": "text", "id": "result_kicker", "label": "結果 冒頭ラベル", "default": "あなたに最適な撮影地は" },
    { "type": "text", "id": "alt_heading", "label": "他の候補の見出し", "default": "他にもおすすめの撮影地" },
    { "type": "textarea", "id": "consult_title", "label": "相談ブロックの見出し文", "default": "撮影地選びやプランのこと、もっと詳しく相談しませんか？" },
    { "type": "text", "id": "consult_button_label", "label": "相談ボタン文言", "default": "オンライン相談を予約する" },
    { "type": "url", "id": "consult_url", "label": "相談ボタンのリンク先（空欄でオンライン相談ページ）" },
    { "type": "text", "id": "restart_label", "label": "やり直しボタン文言", "default": "もう一度診断する" },
    { "type": "header", "content": "配色" },
    { "type": "color", "id": "gold_color", "label": "アクセントカラー（ゴールド）", "default": "#cba876" }
  ],
  "presets": [{ "name": "撮影地 30秒診断" }]
}
{% endschema %}
