    "custom_liquid_4BLamL": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  Shopifyのメタオブジェクトからドレスデータを自動取得してJSON形式に変換します\n{% endcomment %}\n<script>\n  window.diagnosticDresses = [\n    {% for dress in shop.metaobjects.dress_diagnostic_data.values %}\n      {\n        \"id\": \"{{ dress.system.handle }}\",\n        \"name\": \"{{ dress.name | escape }}\",\n        \"size\": \"{{ dress.size | escape }}\",\n        \"desc\": \"{{ dress.desc | escape | strip_newlines }}\",\n        \"img\": \"{{ dress.img | image_url: width: 800 }}\",\n        \"traits\": {\n          \"style\": \"{{ dress.style | escape }}\",\n          \"silhouette\": \"{{ dress.silhouette | escape }}\",\n          \"neck\": \"{{ dress.neck | escape }}\",\n          \"fabric\": \"{{ dress.fabric | escape }}\"\n        }\n      }{% unless forloop.last %},{% endunless %}\n    {% endfor %}\n  ];\n</script>\n\n<style>\n    :root {\n        --primary-color: #B8860B; /* ゴールド */\n        --bg-color: #FAF8F5; /* アイボリー */\n        --text-color: #333333;\n        --card-bg: #ffffff;\n        --btn-hover: #FAF8F5;\n    }\n\n    #app-diagnostic {\n        font-family: 'Noto Sans JP', sans-serif;\n        background-color: var(--card-bg);\n        color: var(--text-color);\n        max-width: 800px;\n        width: 100%;\n        padding: 40px 20px;\n        text-align: center;\n        overflow: hidden;\n        position: relative;\n        min-height: 500px;\n        display: flex;\n        flex-direction: column;\n        justify-content: center;\n        margin: 0 auto;\n    }\n\n    #app-diagnostic h1, #app-diagnostic h2, #app-diagnostic h3 {\n        font-weight: 500;\n        color: var(--text-color);\n        margin-bottom: 20px;\n    }\n\n    #app-diagnostic h1 {\n        font-size: 26px;\n        letter-spacing: 2px;\n        margin-bottom: 30px;\n        display: block;\n    }\n\n    #app-diagnostic h1::after {\n        content: '';\n        display: block;\n        width: 48px;\n        height: 2px;\n        background: var(--primary-color);\n        margin: 20px auto 0;\n    }\n\n    #app-diagnostic p {\n        font-weight: 300;\n        line-height: 1.8;\n    }\n\n    #app-diagnostic .view-section {\n        display: none;\n        animation: fadeIn 0.5s ease forwards;\n    }\n\n    #app-diagnostic .view-section.active {\n        display: block;\n    }\n\n    @keyframes fadeIn {\n        from { opacity: 0; transform: translateY(10px); }\n        to { opacity: 1; transform: translateY(0); }\n    }\n\n    #app-diagnostic .start-btn, #app-diagnostic .retry-btn {\n        background-color: var(--primary-color);\n        color: #fff;\n        border: none;\n        padding: 16px 48px;\n        font-size: 16px;\n        font-weight: bold;\n        border-radius: 9999px;\n        cursor: pointer;\n        transition: all 0.3s ease;\n        letter-spacing: 1px;\n        margin-top: 20px;\n        box-shadow: 0 4px 6px rgba(0,0,0,0.1);\n    }\n\n    #app-diagnostic .start-btn:hover, #app-diagnostic .retry-btn:hover {\n        background-color: #D4A843;\n        transform: translateY(-2px);\n    }\n\n    #app-diagnostic .question-text {\n        font-size: 20px;\n        margin-bottom: 30px;\n    }\n\n    #app-diagnostic .options-container {\n        display: flex;\n        flex-direction: column;\n        gap: 15px;\n    }\n\n    #app-diagnostic .option-btn {\n        background-color: var(--card-bg);\n        border: 1px solid #e5e7eb;\n        color: var(--text-color);\n        padding: 15px 20px;\n        font-size: 14px;\n        border-radius: 8px;\n        cursor: pointer;\n        transition: all 0.2s ease;\n        text-align: left;\n    }\n\n    #app-diagnostic .option-btn:hover {\n        background-color: var(--btn-hover);\n        border-color: var(--primary-color);\n    }\n\n    #app-diagnostic .progress-bar {\n        width: 100%;\n        height: 4px;\n        background-color: #f3f4f6;\n        border-radius: 2px;\n        margin-bottom: 30px;\n        overflow: hidden;\n    }\n\n    #app-diagnostic .progress-fill {\n        height: 100%;\n        background-color: var(--primary-color);\n        width: 0%;\n        transition: width 0.3s ease;\n    }\n\n    #app-diagnostic .result-container {\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n    }\n\n    #app-diagnostic .result-image-wrapper {\n        width: 100%;\n        max-width: 400px;\n        height: 500px;\n        margin: 0 auto 20px auto;\n        border-radius: 8px;\n        overflow: hidden;\n        box-shadow: 0 8px 24px rgba(0,0,0,0.1);\n    }\n\n    #app-diagnostic .result-image {\n        width: 100% !important;\n        height: 100% !important;\n        object-fit: cover !important;\n        object-position: center top !important;\n    }\n\n    #app-diagnostic .result-dress-name {\n        font-size: 22px;\n        color: var(--primary-color);\n        margin-bottom: 5px;\n        font-weight: bold;\n    }\n\n    #app-diagnostic .result-size {\n        font-size: 13px;\n        background-color: #f3f4f6;\n        color: #6b7280;\n        padding: 4px 12px;\n        border-radius: 9999px;\n        margin-bottom: 20px;\n        display: inline-block;\n        font-weight: 500;\n    }\n\n    #app-diagnostic .result-desc {\n        font-size: 14px;\n        line-height: 1.8;\n        font-weight: 300;\n        margin-bottom: 30px;\n        text-align: left;\n        max-width: 500px;\n        margin-left: auto;\n        margin-right: auto;\n    }\n\n    @media (max-width: 600px) {\n        #app-diagnostic { padding: 20px 10px; }\n        #app-diagnostic .result-image-wrapper { height: 400px; }\n        #app-diagnostic .option-btn { font-size: 13px; padding: 12px 15px; }\n    }\n</style>\n\n<div id=\"app-diagnostic\">\n    <div id=\"start-view\" class=\"view-section active\">\n        <h1>フォトウェディング<br>ドレス診断</h1>\n        <p>いくつかの質問に答えるだけで、豊富なコレクションの中から<br>あなたの撮影イメージに最も映える運命のドレスをご提案します。</p>\n        <button id=\"start-btn\" class=\"start-btn\">診断をスタート</button>\n    </div>\n\n    <div id=\"question-view\" class=\"view-section\">\n        <div class=\"progress-bar\">\n            <div id=\"progress-fill\" class=\"progress-fill\"></div>\n        </div>\n        <h2 id=\"question-text\" class=\"question-text\"></h2>\n        <div id=\"options-container\" class=\"options-container\"></div>\n    </div>\n\n    <div id=\"result-view\" class=\"view-section\">\n        <h2>あなたの撮影にぴったりのドレスは…</h2>\n        <div id=\"result-content\" class=\"result-container\"></div>\n        <button id=\"retry-btn\" class=\"retry-btn\">もう一度診断する</button>\n    </div>\n</div>\n\n<script>\n    class WeddingDressDiagnostic {\n        constructor() {\n            // メタオブジェクトから取得したデータをセット\n            this.dresses = window.diagnosticDresses || [];\n\n            this.questions = [\n                {\n                    text: \"Q1. 撮影のロケーション（場所）は、どんなイメージが良いですか？\",\n                    options: [\n                        { text: \"チャペルや歴史的建造物など、クラシカルで厳かな場所\", trait: \"style\", value: \"classic\" },\n                        { text: \"海辺や森、自然豊かな公園など、ナチュラルな屋外\", trait: \"style\", value: \"natural\" },\n                        { text: \"おしゃれなスタジオや洋館、都会の街並みなど、モダンな空間\", trait: \"style\", value: \"modern\" }\n                    ]\n                },\n                {\n                    text: \"Q2. 写真全体を通して、どんなシルエットで残したいですか？\",\n                    options: [\n                        { text: \"お姫様のように華やかで可愛らしい雰囲気（ふんわりAライン、プリンセスライン）\", trait: \"silhouette\", value: \"volume\" },\n                        { text: \"スタイル良く、大人っぽく洗練された雰囲気（スッキリとしたスレンダー、マーメイド）\", trait: \"silhouette\", value: \"slender\" }\n                    ]\n                },\n                {\n                    text: \"Q3. お顔周りのアップ写真に影響する、胸元や袖の希望は？\",\n                    options: [\n                        { text: \"デコルテを出して、お顔周りをすっきり明るく見せたい\", trait: \"neck\", value: \"clear\" },\n                        { text: \"素肌に重なるレースで、上品で繊細な雰囲気を演出したい\", trait: \"neck\", value: \"sheer\" },\n                        { text: \"袖ありのデザインで、トレンド感やクラシカルさを出したい\", trait: \"neck\", value: \"sleeves\" }\n                    ]\n                },\n                {\n                    text: \"Q4. 写真の仕上がりや、ドレスの質感に対する希望は？\",\n                    options: [\n                        { text: \"細かい刺繍やレースのディテールが綺麗に写る、華やかなスタイル\", trait: \"fabric\", value: \"lace\" },\n                        { text: \"風になびくような軽やかさや、光に透ける透明感がほしい（チュール・オーガンジー等）\", trait: \"fabric\", value: \"tulle\" },\n                        { text: \"光沢感があり、陰影が美しく際立つ、重厚で高級感のあるスタイル（サテン・ミカドシルク等）\", trait: \"fabric\", value: \"satin\" }\n                    ]\n                }\n            ];\n\n            this.currentQuestionIndex = 0;\n            this.userAnswers = {};\n\n            this.views = {\n                start: document.getElementById('start-view'),\n                question: document.getElementById('question-view'),\n                result: document.getElementById('result-view')\n            };\n            this.elements = {\n                startBtn: document.getElementById('start-btn'),\n                retryBtn: document.getElementById('retry-btn'),\n                questionText: document.getElementById('question-text'),\n                optionsContainer: document.getElementById('options-container'),\n                progressFill: document.getElementById('progress-fill'),\n                resultContent: document.getElementById('result-content')\n            };\n            this.bindEvents();\n        }\n\n        bindEvents() {\n            if(this.elements.startBtn) this.elements.startBtn.addEventListener('click', () => this.startTest());\n            if(this.elements.retryBtn) this.elements.retryBtn.addEventListener('click', () => this.resetTest());\n        }\n\n        switchView(viewName) {\n            Object.values(this.views).forEach(view => {\n                if(view) view.classList.remove('active');\n            });\n            if (this.views[viewName]) {\n                this.views[viewName].classList.add('active');\n            }\n        }\n\n        startTest() {\n            this.currentQuestionIndex = 0;\n            this.userAnswers = {};\n            this.renderQuestion();\n            this.switchView('question');\n        }\n\n        renderQuestion() {\n            const question = this.questions[this.currentQuestionIndex];\n            if (!question) return;\n\n            const progress = (this.currentQuestionIndex / this.questions.length) * 100;\n            this.elements.progressFill.style.width = `${progress}%`;\n            this.elements.questionText.textContent = question.text;\n            this.elements.optionsContainer.innerHTML = '';\n\n            question.options.forEach(option => {\n                const button = document.createElement('button');\n                button.className = 'option-btn';\n                button.textContent = option.text;\n                button.addEventListener('click', () => this.handleAnswer(option.trait, option.value));\n                this.elements.optionsContainer.appendChild(button);\n            });\n        }\n\n        handleAnswer(trait, value) {\n            this.userAnswers[trait] = value;\n            this.currentQuestionIndex++;\n\n            if (this.currentQuestionIndex < this.questions.length) {\n                this.renderQuestion();\n            } else {\n                this.calculateResult();\n            }\n        }\n\n        calculateResult() {\n            this.elements.progressFill.style.width = '100%';\n            let bestMatchDress = null;\n            let highestScore = -1;\n\n            if (this.dresses.length === 0) {\n                this.elements.resultContent.innerHTML = '<div class=\"result-desc\">現在、診断対象のドレスが登録されていません。</div>';\n                this.switchView('result');\n                return;\n            }\n\n            this.dresses.forEach(dress => {\n                let score = 0;\n                for (const [trait, value] of Object.entries(this.userAnswers)) {\n                    if (dress.traits[trait] === value) {\n                        score += 1;\n                    }\n                }\n                if (score > highestScore) {\n                    highestScore = score;\n                    bestMatchDress = dress;\n                }\n            });\n            this.renderResult(bestMatchDress);\n            this.switchView('result');\n        }\n\n        renderResult(dress) {\n            const imagePath = dress.img ? dress.img : \"https://via.placeholder.com/400x500?text=No+Image\";\n            \n            this.elements.resultContent.innerHTML = `\n                <div class=\"result-image-wrapper\">\n                    <img src=\"${imagePath}\" alt=\"${dress.name}\" class=\"result-image\" loading=\"eager\">\n                </div>\n                <div class=\"result-dress-name\">${dress.name}</div>\n                <div class=\"result-size\">対応サイズ：${dress.size}</div>\n                <div class=\"result-desc\">${dress.desc}</div>\n            `;\n        }\n\n        resetTest() {\n            this.switchView('start');\n        }\n    }\n\n    new WeddingDressDiagnostic();\n</script>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    }
  },
