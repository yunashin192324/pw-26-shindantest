{
  "name": "pokestop-finder",
  "private": true,
  "description": "開発用。アプリの利用には不要（index.html を開くだけで動きます）",
  "scripts": {
    "build:s2": "esbuild tools/s2-entry.mjs --bundle --format=iife --global-name=S2 --minify --footer:js=\"globalThis.S2=S2;\" --outfile=vendor/s2/s2.bundle.js",
    "test": "node --test tests/*.test.js",
    "e2e": "node tests/e2e/run.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "s2-geometry": "1.2.10",
    "s2js": "1.44.0"
  }
}
