{%- comment -%}
  Assign this template to the Page with handle "diagnosis" (Admin >
  Online Store > Pages > Diagnosis > Theme template > page.diagnosis).
  Requires the 6 plan products to exist with the handles below (or
  edit the `handles` list to match whatever handles you actually used).
{%- endcomment -%}

{%- render 'breadcrumb', current_title: page.title -%}

<section class="page-hero">
  <div class="hero-media">
    <img src="{{ 'hero-diagnosis.svg' | asset_url }}" alt="{{ page.title | escape }}" width="1920" height="900">
  </div>
  <div class="hero-content">
    <p class="eyebrow">30-Second Diagnosis</p>
    <h1>あなたに合う撮影地を、<br>30秒で診断。</h1>
    <p class="lede">3つの質問に答えるだけで、おすすめの撮影地とプランをご提案します。</p>
  </div>
</section>

<section>
  <div class="container">
    <div class="diag-wrap">
      <div class="diag-progress"><div class="diag-progress-fill"></div></div>

      <div class="diag-panel is-active" data-index="0" data-key="vibe">
        <p class="diag-step">Question 1 / 3</p>
        <h2 class="diag-question">気になる雰囲気はどちらですか？</h2>
        <div class="diag-options">
          <button class="diag-option" data-value="hawaii">定番ビーチ×常夏の開放感<span class="diag-option-sub">ワイキキビーチ、ダイヤモンドヘッド（ハワイ）</span></button>
          <button class="diag-option" data-value="danang">コスパの良い非日常リゾート<span class="diag-option-sub">黄金の橋、五つ星リゾート（ダナン）</span></button>
          <button class="diag-option" data-value="london">歴史的建築×クラシックな気品<span class="diag-option-sub">タワーブリッジ、古城・庭園（ロンドン）</span></button>
        </div>
      </div>

      <div class="diag-panel" data-index="1" data-key="budget">
        <p class="diag-step">Question 2 / 3</p>
        <h2 class="diag-question">ご予算の目安はどのくらいですか？</h2>
        <div class="diag-options">
          <button class="diag-option" data-value="low">30万円以下<span class="diag-option-sub">まずは無理のない範囲で</span></button>
          <button class="diag-option" data-value="mid">30〜45万円<span class="diag-option-sub">内容とのバランスを重視</span></button>
          <button class="diag-option" data-value="high">45万円以上<span class="diag-option-sub">こだわりを優先したい</span></button>
        </div>
      </div>

      <div class="diag-panel" data-index="2" data-key="priority">
        <p class="diag-step">Question 3 / 3</p>
        <h2 class="diag-question">一番重視したいことは何ですか？</h2>
        <div class="diag-options">
          <button class="diag-option" data-value="standard">王道・安心感のある内容<span class="diag-option-sub">定番のロケーションでしっかりと</span></button>
          <button class="diag-option" data-value="value">コストパフォーマンス<span class="diag-option-sub">費用を抑えつつ満足できる内容</span></button>
          <button class="diag-option" data-value="special">特別感・非日常体験<span class="diag-option-sub">複数ロケーションや特別な演出</span></button>
        </div>
      </div>

      <div class="diag-panel diag-result" data-index="3">
        <p class="eyebrow">Your Result</p>
        <p style="margin-top:8px;">あなたにおすすめのプランは</p>
        <h2 class="diag-result-name">—</h2>
        <span class="avail-tag diag-result-avail">—</span>
        <p class="diag-result-reason mt-40">—</p>
        <p class="diag-result-price">—</p>
        <div class="cta-row" style="justify-content:center;">
          <a href="#" class="btn btn-gold diag-result-link">プランを見る</a>
          <button class="btn btn-outline-dark diag-restart">もう一度診断する</button>
        </div>
        <p class="note mt-40" style="font-size:0.8rem;color:var(--text-muted);">診断結果は目安です。詳しい内容は各プランページでご確認いただくか、お気軽にご相談ください。</p>
      </div>
    </div>
  </div>
</section>

<section class="bg-black text-center">
  <div class="container">
    <p class="eyebrow reveal">Not sure yet?</p>
    <h2 class="reveal reveal-1">迷ったら、まずはご相談ください。</h2>
    <div class="cta-row reveal reveal-2" style="justify-content:center;margin-top:32px;">
      <a href="{{ pages['about'].url | default: '#' }}#contact" class="btn btn-outline-light">相談する</a>
      <a href="{{ routes.root_url }}#destinations" class="btn btn-gold">全プランを見る</a>
    </div>
  </div>
</section>

{%- comment -%} Live product data for the quiz result — edit handles to match your store. {%- endcomment -%}
<script>
window.DIAGNOSIS_PRODUCTS = {
  {%- assign handles = "hawaii-basic,hawaii-premium,danang-basic,danang-premium,london-basic,london-premium" | split: "," -%}
  {%- for handle in handles -%}
    {%- assign p = all_products[handle] -%}
    {%- if p and p.id != blank -%}
    "{{ handle }}": {
      "name": {{ p.title | json }},
      "price": {{ p.price | money | json }},
      "avail": {{ p.metafields.custom.availability | default: 'confirm' | json }},
      "availLabel": {{ p.metafields.custom.availability_label | default: '現地確認後ご回答' | json }},
      "href": {{ p.url | json }},
      "reason": {{ p.metafields.custom.diagnosis_reason | default: '' | json }}
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endif -%}
  {%- endfor -%}
};
</script>
<script src="{{ 'diagnosis.js' | asset_url }}" defer></script>
