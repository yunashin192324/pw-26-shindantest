    "faq": {
      "type": "propose-faq",
      "settings": {
        "visible": 5
      },
      "blocks": {
        "q_1": {
          "type": "question",
          "settings": {
            "question": "出発の数日前でも予約できますか？",
            "answer": "はい。行き先ごとに「最短○日前まで」の受付締切があり、各ページと受付状況カレンダーで確認できます。"
          }
        },
        "q_2": {
          "type": "question",
          "settings": {
            "question": "予約はすぐに確定しますか？",
            "answer": "予約はリクエスト制です。フォトグラファーの手配を確認し、{reply_hours}時間以内に確定可否をメールでご連絡します。お支払いは確定のご連絡のあとです。"
          }
        },
        "q_3": {
          "type": "question",
          "settings": {
            "question": "相手にプロポーズだと気づかれませんか？",
            "answer": "「旅の記念撮影」として自然に始めます。予約確認の連絡も、控えめな件名を選べます。"
          }
        },
        "q_4": {
          "type": "question",
          "settings": {
            "question": "雨が降ったらどうなりますか？",
            "answer": "行き先ごとの雨天対応があります。多くの場所で、翌日以降の空き枠へ無料で振替できます。"
          }
        },
        "q_5": {
          "type": "question",
          "settings": {
            "question": "現地で日本語は通じますか？",
            "answer": "日本語サポートが付いています。当日の連絡も日本語で行えます。"
          }
        },
        "q_6": {
          "type": "question",
          "settings": {
            "question": "キャンセルはできますか？",
            "answer": "予約日の一定期間前まではキャンセル・返金が可能です。規定は予約確認画面とメールでご案内します。"
          }
        },
        "q_7": {
          "type": "question",
          "settings": {
            "question": "写真はいつ届きますか？",
            "answer": "撮影後、オンラインで順次お届けします。目安の日数は予約確認メールでご案内します。"
          }
        },
        "q_8": {
          "type": "question",
          "settings": {
            "question": "指輪や花束は用意してもらえますか？",
            "answer": "花束はプランに含まれています。指輪はご自身でご用意ください。"
          }
        },
        "q_9": {
          "type": "question",
          "settings": {
            "question": "撮影場所は変えられますか？",
            "answer": "行き先ごとの推奨スポットをもとに、当日の天候や混雑に合わせてフォトグラファーが調整します。"
          }
        }
      },
