{%- comment -%}
  Usage: {% render 'breadcrumb', crumb1_title: 'ハワイ', crumb1_url: collection.url, current_title: product.title %}
  Supports up to one intermediate level (crumb1) plus the current page.
  Also emits the matching BreadcrumbList JSON-LD.
{%- endcomment -%}
<p class="breadcrumb">
  <span><a href="{{ routes.root_url }}">TOP</a></span>
  {%- if crumb1_title -%}
    <span><a href="{{ crumb1_url }}">{{ crumb1_title }}</a></span>
  {%- endif -%}
  <span>{{ current_title }}</span>
</p>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "TOP", "item": {{ shop.url | append: routes.root_url | json }} }
    {%- if crumb1_title -%}
    ,{ "@type": "ListItem", "position": 2, "name": {{ crumb1_title | json }}, "item": {{ shop.url | append: crumb1_url | json }} }
    ,{ "@type": "ListItem", "position": 3, "name": {{ current_title | json }} }
    {%- else -%}
    ,{ "@type": "ListItem", "position": 2, "name": {{ current_title | json }} }
    {%- endif -%}
  ]
}
</script>
