{%- comment -%}
  collection-schema — BreadcrumbList JSON-LD for a destination
  collection page.

  Params:
    collection — required
{%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "TOP", "item": {{ shop.url | append: routes.root_url | json }} },
    { "@type": "ListItem", "position": 2, "name": "撮影地一覧", "item": {{ shop.url | append: routes.all_collections_url | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ collection.title | json }}, "item": {{ canonical_url | json }} }
  ]
}
</script>
