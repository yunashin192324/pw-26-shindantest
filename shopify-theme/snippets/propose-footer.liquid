{%- comment -%}
  Footer for the propose layout. Lists every destination page (plain links: the main
  internal-linking path for search engines). Policy links appear once the policy exists
  in 設定 > ポリシー.
{%- endcomment -%}
<footer class="ft" id="ft">
  <div class="wrap">
    <div class="ft-top">
      <a href="/pages/propose" class="hd-logo">PROPOSE<small>世界のプロポーズプラン</small></a>
      <nav class="ft-links" aria-label="フッターメニュー">
        <a href="/pages/propose#destinations">旅行先</a>
        <a href="/pages/propose#plan">プラン</a>
        <a href="/pages/propose#faq">よくある質問</a>
        {%- if shop.terms_of_service %}<a href="{{ shop.terms_of_service.url }}">利用規約</a>{% endif %}
        {%- if shop.privacy_policy %}<a href="{{ shop.privacy_policy.url }}">プライバシー</a>{% endif %}
        {%- if shop.refund_policy %}<a href="{{ shop.refund_policy.url }}">キャンセルポリシー</a>{% endif %}
        <a href="{{ routes.root_url }}">{{ shop.name }}</a>
      </nav>
    </div>
    <nav class="ft-dests" aria-label="旅行先一覧">
      {%- for loc in metaobjects.propose.values -%}
        {%- liquid
          assign loc_url = loc.system.url
          if loc_url == blank
            assign loc_url = '/pages/propose/' | append: loc.system.handle
          endif
        -%}
        <a href="{{ loc_url }}">{{ loc.location_name.value | escape }}でプロポーズ</a>
      {%- endfor -%}
    </nav>
    <p class="ft-meta">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
  </div>
</footer>
