{%- comment -%}
  Line icons on a 32px grid (same drawings as the mockup).
  Accepts: name — beach | chapel | church | monument | restaurant | hotel | calendar | clock | yen | lock
{%- endcomment -%}
<svg class="ic" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'beach' -%}
      <circle cx="22" cy="9" r="3.6"/><path d="M3 22c3.2-3 6.4-3 9.6 0s6.4 3 9.6 0 6.4-3 9.8 0"/><path d="M3 27c3.2-3 6.4-3 9.6 0s6.4 3 9.6 0 6.4-3 9.8 0"/>
    {%- when 'chapel' -%}
      <path d="M16 2.5v6M13.2 5.3h5.6"/><path d="M8 28V16l8-5.5 8 5.5v12z"/><path d="M13 28v-6.5a3 3 0 0 1 6 0V28"/><path d="M4 28h24"/>
    {%- when 'church' -%}
      <path d="M16 2v5M13.5 4.5h5"/><path d="M12 13l4-6 4 6v15h-8z"/><path d="M12 17H7l-2 3v8h7M20 17h5l2 3v8h-7"/><path d="M14.2 28v-5h3.6v5"/>
    {%- when 'monument' -%}
      <path d="M16 2.5v4"/><path d="M13.5 28 16 6.5 18.5 28"/><path d="M14.6 16.5h2.8M13.9 21h4.2"/><path d="M10 28h12"/>
    {%- when 'restaurant' -%}
      <path d="M8 3v7a3 3 0 0 0 6 0V3M11 3v25"/><path d="M20 3h7l-.9 8a2.6 2.6 0 0 1-5.2 0zM23.5 13.6V28M20 28h7"/>
    {%- when 'hotel' -%}
      <path d="M7 28V5h13v23"/><path d="M20 13h5v15"/><path d="M3 28h26"/><path d="M11 10h1.6M15 10h1.6M11 14.5h1.6M15 14.5h1.6M11 19h1.6M15 19h1.6"/><path d="M12 28v-4h4v4"/>
    {%- when 'calendar' -%}
      <rect x="5" y="7" width="22" height="20" rx="1.5"/><path d="M5 13h22M11 4v5M21 4v5M11 18h3M18 18h3M11 22h3"/>
    {%- when 'clock' -%}
      <circle cx="16" cy="16" r="11"/><path d="M16 9v7l4.5 3"/>
    {%- when 'yen' -%}
      <circle cx="16" cy="16" r="11"/><path d="M11.5 9.5 16 16l4.5-6.5M16 16v8M12 18.5h8M12 21.5h8"/>
    {%- when 'lock' -%}
      <rect x="7" y="14" width="18" height="13" rx="1.5"/><path d="M11 14v-4a5 5 0 0 1 10 0v4"/>
  {%- endcase -%}
</svg>
