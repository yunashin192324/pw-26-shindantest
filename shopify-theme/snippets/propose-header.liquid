{%- comment -%}
  Fixed header + mobile drawer. Rendered by layout/propose.liquid on the TOP and
  location pages (the booking page has its own compact header).
  Accepts: cta_url — where 「予約する」 goes (TOP: the destination list,
  location page: booking with that location preselected).
{%- endcomment -%}
<header class="hd is-over" id="hd">
  <a href="/pages/propose" class="hd-logo">PROPOSE<small>世界のプロポーズプラン</small></a>
  <nav class="hd-nav" aria-label="メインメニュー">
    <a href="/pages/propose#destinations">旅行先</a>
    <a href="/pages/propose#proposal">当日の流れ</a>
    <a href="/pages/propose#plan">プラン</a>
    <a href="/pages/propose#faq">よくある質問</a>
    <a href="{{ cta_url }}" class="btn">予約する</a>
  </nav>
  <button class="hd-menu" id="hd-menu" type="button" aria-label="メニューを開く" aria-expanded="false" aria-controls="hd-drawer"><span></span><span></span><span></span></button>
</header>
<nav class="hd-drawer" id="hd-drawer" aria-label="メニュー">
  <a href="/pages/propose#destinations">旅行先から探す <small>DESTINATIONS</small></a>
  <a href="/pages/propose#destinations">場所から探す <small>PLACE</small></a>
  <a href="/pages/propose#proposal">当日の流れ <small>YOUR PROPOSAL</small></a>
  <a href="/pages/propose#plan">プラン・料金 <small>PLAN</small></a>
  <a href="/pages/propose#faq">よくある質問 <small>FAQ</small></a>
  <a href="/pages/propose#destinations" class="btn">旅行先から探す</a>
</nav>
