{%- comment -%}
  One photo block (.photo wrapper + responsive <img>).
  Accepts:
    image         — an image object (metaobject file field .value, or image_picker setting)
    alt           — alt text (the image's own alt wins; set it in コンテンツ > ファイル)
    decorative    — true when the photo repeats nearby text (alt="")
    pos           — CSS object-position, e.g. "50% 60%"
    sizes         — sizes attribute
    eager         — true for the first screen (hero): loads at high priority; everything else lazy-loads
    class         — extra classes on the wrapper
    fallback_name — shown on the placeholder tile when there is no photo yet
{%- endcomment -%}
{%- liquid
  assign pos = pos | default: '50% 50%'
  assign sizes = sizes | default: '100vw'
  assign alt_text = image.alt | default: alt | default: ''
  if decorative
    assign alt_text = ''
  endif
  assign img_style = 'object-position:' | append: pos
-%}
<div class="photo{% if class != blank %} {{ class }}{% endif %}">
  {%- if image != blank -%}
    {%- if eager -%}
      {{ image | image_url: width: 2000 | image_tag: widths: '400, 600, 800, 1200, 1600, 2000', sizes: sizes, alt: alt_text, loading: 'eager', fetchpriority: 'high', decoding: 'async', style: img_style }}
    {%- else -%}
      {{ image | image_url: width: 2000 | image_tag: widths: '400, 600, 800, 1200, 1600, 2000', sizes: sizes, alt: alt_text, loading: 'lazy', decoding: 'async', style: img_style }}
    {%- endif -%}
  {%- else -%}
    <div class="ph"><span class="ph-name">{{ fallback_name | escape }}</span><span class="ph-soon">写真準備中</span></div>
  {%- endif -%}
</div>
