{%- comment -%}
  destination-schema
  ----------------------------------------------------------------
  都市ページ用の構造化データ。BreadcrumbList + Place(TouristDestination)
  + (FAQが登録されていれば)FAQPage を出力する。AI検索(GEO)がそのまま
  引用できるよう、都市の要点(国・地域・ベストシーズン等)を機械可読な
  形でも公開する。

  Params:
    destination  — required
    region_label — required, 例: 'Europe'
{%- endcomment -%}
{%- assign name_ja = destination.name_ja.value -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": {{ name_ja | json }},
  "alternateName": {{ destination.name_en.value | json }},
  "description": {{ destination.description.value | strip_html | truncate: 300 | json }},
  {%- if destination.hero_image.value %}
  "image": [{{ destination.hero_image.value | image_url: width: 1600 | prepend: "https:" | json }}],
  {%- endif %}
  "address": {
    "@type": "PostalAddress",
    "addressCountry": {{ destination.country.value | json }}
  },
  {%- if destination.recommended_for.value != blank %}
  "touristType": {{ destination.recommended_for.value | json }},
  {%- endif %}
  "url": {{ canonical_url | json }}
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "TOP", "item": {{ shop.url | append: routes.root_url | json }} },
    { "@type": "ListItem", "position": 2, "name": "撮影地一覧", "item": {{ shop.url | append: '/pages/destinations' | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ region_label | json }}, "item": {{ shop.url | append: '/pages/' | append: destination.region.value | replace: '_', '-' | json }} },
    { "@type": "ListItem", "position": 4, "name": {{ name_ja | json }}, "item": {{ canonical_url | json }} }
  ]
}
</script>

{%- assign faqs = destination.faqs.value -%}
{%- if faqs.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for faq in faqs -%}
    {
      "@type": "Question",
      "name": {{ faq.question | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ faq.answer | json }} }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
