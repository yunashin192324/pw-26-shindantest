{% render 'danang-common' %}
{%- if section.settings.enable -%}
<div class="danang-scope" id="reserve">
  {% style %}
    #shopify-section-{{ section.id }} { background: {{ section.settings.bg_color }}; }
    #shopify-section-{{ section.id }} .danang-reserve-eyebrow { color: {{ section.settings.eyebrow_color }}; }
    #shopify-section-{{ section.id }} .danang-reserve-title { color: {{ section.settings.title_color }}; font-size: {{ section.settings.title_size }}px; }
    #shopify-section-{{ section.id }} .danang-reserve-desc { color: {{ section.settings.text_color }}; }
    #shopify-section-{{ section.id }} .danang-reserve-primary { background: {{ section.settings.accent_color }}; color: #fff; }
    #shopify-section-{{ section.id }} .danang-reserve-secondary { border: 1px solid {{ section.settings.text_color }}; color: {{ section.settings.text_color }}; }
  {% endstyle %}

  <section style="padding:5rem 0;text-align:center;">
    <div class="danang-wrap danang-wrap--narrow">
      {%- if section.settings.eyebrow != blank -%}
        <p class="danang-serif danang-reserve-eyebrow" style="letter-spacing:0.15em;text-transform:uppercase;font-size:0.85rem;margin-bottom:0.5rem;">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="danang-serif danang-reserve-title" style="font-weight:300;margin-bottom:1rem;">{{ section.settings.title | newline_to_br }}</h2>
      <p class="danang-reserve-desc" style="font-size:0.875rem;margin-bottom:2rem;">{{ section.settings.desc | newline_to_br }}</p>
      <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:1rem;">
        {%- if section.settings.primary_label != blank -%}
          <a href="{{ section.settings.primary_url | default: '#' }}" class="danang-btn danang-reserve-primary" style="padding:0.9rem 2rem;">{{ section.settings.primary_label }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ section.settings.secondary_url | default: '#' }}" class="danang-btn danang-reserve-secondary" style="padding:0.9rem 2rem;">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>
{%- endif -%}

{% schema %}
{
  "name": "ダナン｜ご予約CTA",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "このセクションを表示する", "default": true },
    { "type": "color", "id": "bg_color", "label": "背景色", "default": "#1a1a1a" },
    { "type": "text", "id": "eyebrow", "label": "小見出し", "default": "Reservation" },
    { "type": "color", "id": "eyebrow_color", "label": "小見出しの色", "default": "#d4a843" },
    { "type": "textarea", "id": "title", "label": "タイトル（Enterキーで自由に改行できます）", "default": "ビーチプランを予約する" },
    { "type": "color", "id": "title_color", "label": "タイトルの色", "default": "#faf8f5" },
    { "type": "range", "id": "title_size", "label": "タイトルの文字サイズ（px）", "min": 18, "max": 48, "step": 1, "default": 28 },
    { "type": "textarea", "id": "desc", "label": "説明文（Enterキーで自由に改行できます）", "default": "空き状況のご確認・ご予約、まずはお気軽にご相談ください。" },
    { "type": "color", "id": "text_color", "label": "説明文の色", "default": "#faf8f5" },
    { "type": "color", "id": "accent_color", "label": "メインボタンの色", "default": "#b8860b" },
    { "type": "text", "id": "primary_label", "label": "メインボタン文字", "default": "空き状況を確認して予約する" },
    { "type": "url", "id": "primary_url", "label": "メインボタンのリンク先" },
    { "type": "text", "id": "secondary_label", "label": "サブボタン文字", "default": "他のプランも診断する" },
    { "type": "url", "id": "secondary_url", "label": "サブボタンのリンク先" }
  ],
  "presets": [
    { "name": "ダナン｜ご予約CTA" }
  ]
}
{% endschema %}
