{%- comment -%}
  collections-grid — "撮影地から選ぶ" region cards on the TOP page,
  reusing .region-card. Each block picks a Collection directly, so
  adding a new destination is "add block → pick collection", no code.
{%- endcomment -%}
{%- if section.settings.show_section and section.blocks.size > 0 -%}
  <section id="destinations" class="{% if section.settings.background == 'ivory' %}bg-ivory{% endif %}">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Destinations</p>
        <h2>{{ section.settings.heading }}</h2>
        <div class="divider-gold"></div>
        {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
      </div>
      <div class="grid grid-3">
        {%- for block in section.blocks -%}
          {%- assign col = block.settings.collection -%}
          {%- if col -%}
            <a href="{{ col.url }}" class="region-card reveal{% if forloop.index0 > 0 %} reveal-{{ forloop.index0 | modulo: 4 }}{% endif %}" {{ block.shopify_attributes }}>
              {%- if col.featured_image -%}
                <img src="{{ col.featured_image | image_url: width: 700 }}" alt="{{ col.featured_image.alt | default: col.title | escape }}" loading="lazy" width="700" height="933">
              {%- endif -%}
              <div class="region-card-body">
                {%- if block.settings.eyebrow != blank -%}<p class="region-card-eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
                <h3 class="region-card-title">{{ col.title }}</h3>
                {%- if block.settings.meta != blank -%}<p class="region-card-meta">{{ block.settings.meta }}</p>{%- endif -%}
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "撮影地から選ぶ",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "表示する", "default": true },
    { "type": "text", "id": "heading", "label": "見出し", "default": "撮影地から選ぶ" },
    { "type": "richtext", "id": "body", "label": "本文" },
    { "type": "select", "id": "background", "label": "背景", "options": [
        { "value": "white", "label": "白" },
        { "value": "ivory", "label": "アイボリー" }
      ], "default": "ivory" }
  ],
  "blocks": [
    {
      "type": "destination",
      "name": "撮影地",
      "settings": [
        { "type": "collection", "id": "collection", "label": "コレクション" },
        { "type": "text", "id": "eyebrow", "label": "英字ラベル", "default": "Country" },
        { "type": "text", "id": "meta", "label": "補足（プラン数・ベストシーズンなど）" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "撮影地から選ぶ" }]
}
{% endschema %}
