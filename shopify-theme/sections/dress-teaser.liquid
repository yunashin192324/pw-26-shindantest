<section class="bg-ivory">
  <div class="container">
    <div class="split">
      <div class="split-media reveal">
        {%- if section.settings.image -%}
          <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.heading | escape }}" loading="lazy" width="1000" height="1250">
        {%- else -%}
          <img src="{{ 'dress-1.svg' | asset_url }}" alt="{{ section.settings.heading | escape }}" width="1000" height="1250">
        {%- endif -%}
      </div>
      <div class="reveal reveal-1">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <div class="divider-gold" style="margin-left:0;"></div>
        <p>{{ section.settings.text }}</p>
        <div class="cta-row" style="margin-top:32px;">
          <a href="{{ section.settings.cta_link | default: pages['dress'].url }}" class="btn btn-outline-dark">{{ section.settings.cta_text }}</a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ドレス紹介",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "画像" },
    { "type": "text", "id": "eyebrow", "label": "アイキャッチテキスト", "default": "Dress" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "フォーシスアンドカンパニーの衣裳を、そのまま海外へ。" },
    { "type": "textarea", "id": "text", "label": "本文", "default": "全国の提携サロンで試着し、選んだ一着をそのまま撮影地まで。海外挙式・フォトウェディングに精通したフォーシスアンドカンパニーの上質なドレス・タキシードだから、写真映えも着心地も妥協しません。" },
    { "type": "text", "id": "cta_text", "label": "ボタンテキスト", "default": "ドレスを詳しく見る" },
    { "type": "url", "id": "cta_link", "label": "ボタンリンク先" }
  ],
  "presets": [ { "name": "ドレス紹介" } ]
}
{% endschema %}
