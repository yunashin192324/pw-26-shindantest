{%- comment -%}
  journal-grid — latest articles grid (3 col desktop / 1 col mobile via
  the existing .grid.grid-3 utility). Visiting /blogs/{handle}/tagged/{tag}
  (linked from journal-category.liquid) narrows blog.articles natively —
  no custom filtering JS required.
{%- endcomment -%}
<section id="journal-grid" class="bg-ivory">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>
        {%- if current_tags -%}
          {%- capture label -%}{% render 'journal-category-label', tag: current_tags.first %}{%- endcapture -%}
          {{ label }}
        {%- else -%}
          {{ section.settings.heading }}
        {%- endif -%}
      </h2>
      <div class="divider-gold"></div>
      <p>{{ section.settings.description }}</p>
    </div>

    {%- paginate blog.articles by section.settings.per_page -%}
      {%- if blog.articles.size > 0 -%}
        <div class="grid grid-3">
          {%- for article in blog.articles -%}
            {%- assign reveal_index = forloop.index0 | modulo: 3 -%}
            {%- capture reveal_class -%}{% if reveal_index > 0 %}reveal-{{ reveal_index }}{% endif %}{%- endcapture -%}
            {%- assign reveal_class = reveal_class | strip -%}
            {%- render 'journal-card', article: article, reveal_class: reveal_class -%}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="ページネーション">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}">＜ 前へ</a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}
                <span class="current">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}">次へ ＞</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="text-center">まだ記事がありません。</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "JOURNAL 記事一覧",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "英字見出し", "default": "Latest Stories" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "最新記事" },
    { "type": "textarea", "id": "description", "label": "説明文", "default": "撮影地のリアル、ドレスの選び方、旅の準備——ふたりの物語のヒントを。" },
    { "type": "range", "id": "per_page", "label": "1ページの表示件数", "min": 6, "max": 24, "step": 3, "default": 9 }
  ],
  "presets": [{ "name": "JOURNAL 記事一覧" }]
}
{% endschema %}
