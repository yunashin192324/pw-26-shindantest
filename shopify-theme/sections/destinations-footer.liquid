{%- comment -%}
  destinations-footer
  ----------------------------------------------------------------
  独立したフッター。既存の sections/footer.liquid (TOP/JOURNAL用) には
  一切手を加えず、layout/theme.destinations.liquid からのみ使用する。
{%- endcomment -%}
<footer class="dst-footer">
  <div class="dst-container">
    <div class="dst-footer-top">
      <div>
        <div class="dst-logo">{{ section.settings.logo_text }}</div>
        <p class="dst-footer-tagline">{{ section.settings.tagline }}</p>
      </div>
      {%- for block in section.blocks -%}
        <div class="dst-footer-col">
          <h4>{{ block.settings.heading }}</h4>
          <ul>
            {%- for link in block.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>
    <div class="dst-footer-bottom">
      <span>{{ section.settings.copyright }}</span>
      <span>{{ section.settings.credit }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "撮影地フッター",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "ロゴ文字", "default": "HIS World Wedding" },
    { "type": "textarea", "id": "tagline", "label": "タグライン", "default": "世界中の撮影地から、おふたりだけの物語を。" },
    { "type": "text", "id": "copyright", "label": "コピーライト", "default": "© 2026 HIS World Wedding." },
    { "type": "text", "id": "credit", "label": "クレジット表記", "default": "Operated by HIS Co., Ltd." }
  ],
  "blocks": [
    {
      "type": "menu_column",
      "name": "メニュー列",
      "settings": [
        { "type": "text", "id": "heading", "label": "見出し" },
        { "type": "link_list", "id": "menu", "label": "リンク" }
      ]
    }
  ],
  "max_blocks": 4,
  "default": {
    "blocks": [
      { "type": "menu_column", "settings": { "heading": "地域から選ぶ" } },
      { "type": "menu_column", "settings": { "heading": "サイト" } },
      { "type": "menu_column", "settings": { "heading": "お問い合わせ" } }
    ]
  }
}
{% endschema %}
