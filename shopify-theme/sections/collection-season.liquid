{%- comment -%}
  collection-season — ベストシーズン guide, 4 blocks by default
  (quarterly), reusing the plain card-media + h3 + p pattern from the
  existing collection LPs.
{%- endcomment -%}
{%- if section.settings.show_section and section.blocks.size > 0 -%}
  <section>
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Best Season</p>
        <h2>{{ section.settings.heading }}</h2>
        <div class="divider-gold"></div>
        {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
      </div>
      <div class="grid grid-4">
        {%- for block in section.blocks -%}
          <div class="reveal{% if forloop.index0 > 0 %} reveal-{{ forloop.index0 | modulo: 4 }}{% endif %}" {{ block.shopify_attributes }}>
            <div class="card-media" style="aspect-ratio:3/4;">
              {%- if block.settings.image -%}
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.image.alt | default: block.settings.title | escape }}" loading="lazy" width="600" height="800">
              {%- endif -%}
            </div>
            <h3 style="font-size:1rem;margin-top:14px;">{{ block.settings.title }}</h3>
            <p style="font-size:0.85rem;">{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "ベストシーズン",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "表示する", "default": true },
    { "type": "text", "id": "heading", "label": "見出し", "default": "ベストシーズン" },
    { "type": "richtext", "id": "body", "label": "本文" }
  ],
  "blocks": [
    {
      "type": "season",
      "name": "時期",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "画像" },
        { "type": "text", "id": "title", "label": "時期", "default": "2〜4月" },
        { "type": "text", "id": "text", "label": "説明", "default": "気温・湿度ともに穏やかで、最も撮影しやすい時期。" }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}
