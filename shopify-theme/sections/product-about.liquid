{%- comment -%}
  product-about — ③ このプランについて. Overview / features / location
  intro, kept short. Body defaults to product.description (native
  Shopify Product Description) but can be overridden below — override
  the "本文" field's dynamic source per product if a shorter summary
  than the full description is preferred here.
{%- endcomment -%}
{%- if section.settings.show_section -%}
  <section>
    <div class="container">
      <div class="grid grid-2" style="align-items:center;">
        <div class="split-media reveal">
          {%- if section.settings.image -%}
            <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | default: product.title | escape }}" loading="lazy" width="900" height="1125">
          {%- elsif product.featured_image -%}
            <img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.title | escape }}" loading="lazy" width="900" height="1125">
          {%- endif -%}
        </div>
        <div class="reveal reveal-1">
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
          <h2>{{ section.settings.heading }}</h2>
          <div class="divider-gold" style="margin-left:0;"></div>
          {%- if section.settings.body != blank -%}
            <div>{{ section.settings.body }}</div>
          {%- else -%}
            <div>{{ product.description }}</div>
          {%- endif -%}

          {%- if section.blocks.size > 0 -%}
            <div class="tag-row mt-40">
              {%- for block in section.blocks -%}
                <span class="tag" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "このプランについて",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "表示する", "default": true },
    { "type": "image_picker", "id": "image", "label": "画像", "info": "未設定の場合はメイン商品画像を使用します。" },
    { "type": "text", "id": "eyebrow", "label": "英字見出し", "default": "Plan Overview" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "このプランについて" },
    { "type": "richtext", "id": "body", "label": "本文", "info": "未入力の場合は商品説明（Description）を表示します。" }
  ],
  "blocks": [
    {
      "type": "spec_tag",
      "name": "特徴タグ",
      "settings": [
        { "type": "text", "id": "label", "label": "文言", "default": "撮影時間 約6時間" }
      ]
    }
  ],
  "max_blocks": 8,
  "default": {
    "blocks": [
      { "type": "spec_tag", "settings": { "label": "撮影時間 約6時間" } },
      { "type": "spec_tag", "settings": { "label": "カメラマン2名体制" } },
      { "type": "spec_tag", "settings": { "label": "ロケーション3箇所" } }
    ]
  }
}
{% endschema %}
