{%- comment -%}
  TOP: common FAQ. The first N are shown; the rest open with 「すべての質問を見る」.
  {reply_hours} in an answer is replaced with propose_settings.reply_hours.
  Also outputs FAQPage structured data from the same blocks.
{%- endcomment -%}
{%- assign pp_settings = metaobjects.propose_settings.values.first -%}
{%- assign reply_hours = pp_settings.reply_hours.value | default: 24 -%}
<section class="sec" id="faq" aria-labelledby="faq-title">
  <div class="wrap-narrow">
    <div class="sec-head center reveal">
      <span class="label">{{ section.settings.label | escape }}</span>
      <h2 class="h2" id="faq-title">{{ section.settings.heading | escape }}</h2>
    </div>
    <div class="faq" data-faq>
      {%- for block in section.blocks -%}
        {%- assign answer = block.settings.answer | replace: '{reply_hours}', reply_hours | escape | newline_to_br -%}
        <div {% if forloop.index > section.settings.visible %}class="hidden" data-faq-more{% endif %} {{ block.shopify_attributes }}>
          {% render 'propose-faq-list', question: block.settings.question, answer: answer %}
        </div>
      {%- endfor -%}
    </div>
    {%- if section.blocks.size > section.settings.visible %}
    <div class="faq-more"><button type="button" class="link" data-faq-open>すべての質問を見る</button></div>
    {%- endif %}
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    {
      "@type": "Question",
      "name": {{ block.settings.question | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | replace: '{reply_hours}', reply_hours | json }} }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>

{% schema %}
{
  "name": "プロポーズ FAQ",
  "settings": [
    { "type": "text", "id": "label", "label": "英語ラベル", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "よくあるご質問" },
    { "type": "range", "id": "visible", "label": "最初に表示する数", "min": 3, "max": 10, "step": 1, "default": 5 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "質問",
      "settings": [
        { "type": "text", "id": "question", "label": "質問" },
        { "type": "textarea", "id": "answer", "label": "回答", "info": "{reply_hours} は返信までの時間に置き換わります。" }
      ]
    }
  ],
  "presets": [{ "name": "プロポーズ FAQ" }]
}
{% endschema %}
