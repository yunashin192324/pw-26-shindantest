{%- comment -%}
  product-options — ⑤ オプション. Card UI for add-on purchases. If the
  option is modelled as its own Shopify product (e.g. an "album"
  product used as a line-item add-on), link the card to it; otherwise
  it's informational copy that funnels into the Appointo booking flow
  where options are actually selected.
{%- endcomment -%}
{%- if section.settings.show_section and section.blocks.size > 0 -%}
  <section>
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Options</p>
        <h2>{{ section.settings.heading }}</h2>
        <div class="divider-gold"></div>
      </div>
      <div class="grid grid-4">
        {%- for block in section.blocks -%}
          {%- assign linked = block.settings.linked_product -%}
          <div class="card option-card reveal{% if forloop.index0 > 0 %} reveal-{{ forloop.index0 | modulo: 4 }}{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}
              <div class="card-media">
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.image.alt | default: block.settings.title | escape }}" loading="lazy" width="600" height="750">
              </div>
            {%- endif -%}
            <div class="card-body">
              <h3 class="card-title" style="font-size:1.1rem;">{{ block.settings.title }}</h3>
              {%- if block.settings.description != blank -%}<p class="card-desc">{{ block.settings.description }}</p>{%- endif -%}
              <div class="card-foot" style="border-top:none;padding-top:0;">
                <span class="card-price">
                  {%- if linked -%}+{{ linked.price | money }}{%- else -%}{{ block.settings.price_label }}{%- endif -%}
                </span>
                {%- if linked -%}<a href="{{ linked.url }}" class="card-link">詳しく見る ＞</a>{%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "オプション",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "表示する", "default": true },
    { "type": "text", "id": "heading", "label": "見出し", "default": "オプション" }
  ],
  "blocks": [
    {
      "type": "option",
      "name": "オプションカード",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "画像" },
        { "type": "text", "id": "title", "label": "名称", "default": "アルバム制作" },
        { "type": "text", "id": "description", "label": "説明" },
        { "type": "text", "id": "price_label", "label": "価格表記（リンク商品未設定時）", "default": "+¥50,000" },
        { "type": "product", "id": "linked_product", "label": "関連商品（任意）", "info": "オプションをShopify商品として販売する場合に設定すると価格・リンクを自動表示します。" }
      ]
    }
  ],
  "max_blocks": 8,
  "default": {
    "blocks": [
      { "type": "option", "settings": { "title": "アルバム制作", "price_label": "+¥50,000" } },
      { "type": "option", "settings": { "title": "ドローン空撮", "price_label": "+¥22,000" } },
      { "type": "option", "settings": { "title": "衣裳追加（1着）", "price_label": "+¥28,000" } },
      { "type": "option", "settings": { "title": "サンセットディナー同時手配", "price_label": "+¥35,000" } }
    ]
  }
}
{% endschema %}
