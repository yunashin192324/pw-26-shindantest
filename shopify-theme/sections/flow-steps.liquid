{%- comment -%}
  flow-steps — generic numbered flow, reusing .flow / .flow-step /
  .flow-arrow. Used for the TOP page's "ご利用の流れ" and Dress's
  "試着からご利用までの流れ".
{%- endcomment -%}
{%- if section.settings.show_section and section.blocks.size > 0 -%}
  <section class="{% if section.settings.background == 'black' %}bg-black{% elsif section.settings.background == 'ivory' %}bg-ivory{% endif %}">
    <div class="container">
      <div class="section-head reveal">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <div class="divider-gold"></div>
      </div>
      <div class="flow">
        {%- for block in section.blocks -%}
          <div class="flow-step reveal{% if forloop.index0 > 0 %} reveal-{{ forloop.index0 | modulo: 4 }}{% endif %}" {{ block.shopify_attributes }}>
            <div class="num"></div>
            <h4>{{ block.settings.title }}</h4>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          </div>
          {%- unless forloop.last -%}<div class="flow-arrow">→</div>{%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "利用の流れ",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "表示する", "default": true },
    { "type": "text", "id": "eyebrow", "label": "英字見出し", "default": "Flow" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "ご利用の流れ" },
    { "type": "select", "id": "background", "label": "背景", "options": [
        { "value": "white", "label": "白" },
        { "value": "ivory", "label": "アイボリー" },
        { "value": "black", "label": "黒" }
      ], "default": "black" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "ステップ",
      "settings": [
        { "type": "text", "id": "title", "label": "見出し", "default": "ステップ名" },
        { "type": "text", "id": "text", "label": "説明" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "利用の流れ" }]
}
{% endschema %}
