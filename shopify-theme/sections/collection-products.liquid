{%- comment -%}
  collection-products — the plan cards for this destination. Pulls
  straight from collection.products (native Shopify Collections — add
  a product to this collection in Admin and it appears here, no theme
  edit needed). Sort order / manual curation is controlled the normal
  Shopify way (collection "Sort" setting, or drag order for Manual
  collections).

  Card conventions (set via product tags, so no code change per product):
    "人気"     tag → gold "人気" badge
    "即予約"   tag → green "即予約できます" pill
    default          → "現地確認後ご案内" pill
{%- endcomment -%}
{%- if section.settings.show_section -%}
  <section class="{% if section.settings.background == 'ivory' %}bg-ivory{% endif %}">
    <div class="container">
      {%- assign heading = section.settings.heading -%}
      {%- if heading == blank -%}{%- assign heading = collection.title | append: 'のプラン' -%}{%- endif -%}
      <div class="section-head reveal">
        <p class="eyebrow">Plans</p>
        <h2>{{ heading }}</h2>
        <div class="divider-gold"></div>
      </div>
      {%- if collection.products.size > 0 -%}
        <div class="grid grid-{{ section.settings.columns }}">
          {%- for product in collection.products -%}
            <a href="{{ product.url }}" class="card reveal{% if forloop.index0 > 0 %} reveal-{{ forloop.index0 | modulo: 4 }}{% endif %}">
              <div class="card-media">
                {%- if product.tags contains '人気' -%}<span class="card-badge gold">人気</span>{%- endif -%}
                {%- if product.featured_image -%}
                  <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="800" height="1000">
                {%- endif -%}
              </div>
              <div class="card-body">
                <p class="card-region">{{ collection.title }}</p>
                <h3 class="card-title">{{ product.title }}</h3>
                {%- if product.description != blank -%}
                  <p class="card-desc">{{ product.description | strip_html | truncate: 60 }}</p>
                {%- endif -%}
                {%- if product.tags contains '即予約' -%}
                  <span class="avail-tag instant">即予約できます</span>
                {%- else -%}
                  <span class="avail-tag confirm">現地確認後ご回答</span>
                {%- endif -%}
                <div class="card-foot">
                  <span class="card-price">{{ product.price | money }}<small>税込 / 2名</small></span>
                  <span class="card-link">詳細を見る ＞</span>
                </div>
              </div>
            </a>
          {%- endfor -%}
        </div>
      {%- elsif request.design_mode -%}
        <p class="note text-center">このコレクションにはまだ商品が追加されていません。Admin → Collections から商品を追加してください。</p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "プラン一覧",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "表示する", "default": true },
    { "type": "text", "id": "heading", "label": "見出し（空欄でコレクション名を使用）" },
    { "type": "select", "id": "background", "label": "背景", "options": [
        { "value": "white", "label": "白" },
        { "value": "ivory", "label": "アイボリー" }
      ], "default": "ivory" },
    { "type": "select", "id": "columns", "label": "列数", "options": [
        { "value": "2", "label": "2列" },
        { "value": "3", "label": "3列" }
      ], "default": "2" }
  ]
}
{% endschema %}
