{%- comment -%}
  product-cta — ⑬ 最後のCTA. Full-bleed background photo + Appointo /
  contact buttons, same dark hero treatment used elsewhere.
{%- endcomment -%}
{%- if section.settings.show_section -%}
  <section class="cta-band text-center">
    <div class="hero-media">
      {%- if section.settings.background_image -%}
        <img src="{{ section.settings.background_image | image_url: width: 2400 }}" alt="" loading="lazy" width="2400" height="1350">
      {%- endif -%}
    </div>
    <div class="container" style="position:relative;z-index:1;">
      <p class="eyebrow reveal">{{ section.settings.eyebrow }}</p>
      <h2 class="reveal reveal-1" style="color:var(--white);">{{ section.settings.heading }}</h2>
      {%- if section.settings.description != blank -%}
        <p class="reveal reveal-2" style="margin-top:16px;color:var(--text-on-dark-muted);">{{ section.settings.description }}</p>
      {%- endif -%}
      <div class="cta-row reveal reveal-3" style="justify-content:center;margin-top:32px;">
        <a href="#booking" class="btn btn-gold">{{ section.settings.booking_label }}</a>
        {%- if section.settings.contact_url != blank -%}
          <a href="{{ section.settings.contact_url }}" class="btn btn-outline-light">{{ section.settings.contact_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "最後のCTA",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "表示する", "default": true },
    { "type": "image_picker", "id": "background_image", "label": "背景画像" },
    { "type": "text", "id": "eyebrow", "label": "英字見出し", "default": "Reservation" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "このプランを予約する" },
    { "type": "richtext", "id": "description", "label": "本文" },
    { "type": "text", "id": "booking_label", "label": "予約ボタン文言", "default": "空き状況を見る" },
    { "type": "text", "id": "contact_label", "label": "問い合わせボタン文言", "default": "相談する" },
    { "type": "url", "id": "contact_url", "label": "問い合わせボタンリンク先", "info": "例：/pages/about#contact" }
  ]
}
{% endschema %}
