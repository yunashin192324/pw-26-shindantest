{%- comment -%}
  Location page — templates/metaobject/propose.json → /pages/propose/<handle>.

  Order follows what someone about to propose asks, top to bottom:
    where can I do it? (hero → reassurance → PLACE CARDS) → what will the day be like? →
    how much? → is my date open? → what if…? (FAQ)
  Each fact appears once: the deadline/reply/payment reassurance sits under the intro, rain sits
  next to the dates, prices live in the plan table (plus the two "from" prices in the hero).

  Everything location-specific comes from the `propose` metaobject (see PROPOSE-SETUP.md §4).
  Block text may use {location} {meeting_point} {lead_time} {reply_hours}.
{%- endcomment -%}
{%- liquid
  assign loc = metaobject
  assign pp_settings = metaobjects.propose_settings.values.first
  assign reply_hours = pp_settings.reply_hours.value | default: 24
  assign plan = loc.plan_product.value
  assign name_en = loc.location_name_en.value
  assign name_ja = loc.location_name.value
  assign name_title = name_en | downcase | capitalize
  assign lead_time = loc.lead_time.value | default: 3
  assign booking_url = '/pages/propose-booking?loc=' | append: loc.system.handle
  assign meeting_point = loc.meeting_point.value
  assign has_best = false
  if loc.best_time.value != blank and loc.best_time_note.value != blank
    assign has_best = true
  endif
  if plan
    assign light_price = plan.variants[0].price
    if plan.variants.size > 1
      assign std_price = plan.variants[1].price
    endif
    if plan.variants.size > 2
      assign lux_price = plan.variants[2].price
    endif
  endif
  assign pp_types = 'beach,chapel,church,monument,restaurant,hotel' | split: ','
  assign fee_types = 'chapel,church,restaurant,hotel'
  assign hero_alt = name_ja | append: 'の景色'
  assign place_count = 0
-%}
{%- capture place_names -%}
  {%- for t in pp_types -%}
    {%- assign venue_key = t | append: '_venues' -%}
    {%- if loc.place_types.value contains t or loc[venue_key].value != blank -%}
      {%- if place_count > 0 %}・{% endif -%}{% render 'propose-place-type', type: t, part: 'ja' %}
      {%- assign place_count = place_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<section class="lhero" aria-labelledby="l-title">
  {% render 'propose-photo', image: loc.hero_image.value, pos: loc.hero_image_position.value, alt: hero_alt, eager: true, fallback_name: name_en %}
  <div class="hero-scrim"></div>
  <p class="crumb"><a href="/pages/propose">TOP</a> ／ <a href="/pages/propose#destinations">旅行先</a> ／ {{ name_ja | escape }}</p>
  <div class="lhero-body">
    <span class="label">Propose in {{ name_title | escape }}</span>
    <p class="lhero-name" aria-hidden="true">{{ name_en | escape }}</p>
    <h1 class="h1" id="l-title">{{ loc.catch_copy.value | escape | newline_to_br }}</h1>
    {%- if plan %}
    <p class="lhero-price"><span>花束のみ <b class="price">{{ light_price | money }}</b>〜</span>{% if std_price %}<span>写真付き <b class="price">{{ std_price | money }}</b>〜</span>{% endif %}</p>
    {%- endif %}
    <div class="lhero-cta">
      {%- if place_count > 0 %}<button type="button" class="btn btn-light" data-scroll="loc-place">場所を選ぶ</button>{% endif %}
      <button type="button" class="btn btn-line" data-scroll="loc-avail">日程を確認する</button>
    </div>
  </div>
</section>

<section class="sec" style="padding-bottom:calc(var(--sec) * .5)" aria-labelledby="l-about">
  <div class="wrap">
    <div class="lintro reveal">
      <div><span class="label">About {{ name_en | escape }}</span><h2 class="h2" id="l-about">{{ loc.tagline.value | escape }}</h2></div>
      <p class="lede" style="margin-top:0">{{ loc.description.value | escape | newline_to_br }}</p>
    </div>
    <dl class="facts reveal">
      <div class="fact"><dt>受付期限</dt><dd>{{ lead_time }}日前まで<small>リクエストの受付</small></dd></div>
      <div class="fact"><dt>確定のご連絡</dt><dd>{{ reply_hours }}時間以内<small>メールでお知らせ</small></dd></div>
      <div class="fact"><dt>お支払い</dt><dd>確定のあと<small>リクエストは無料</small></dd></div>
      <div class="fact"><dt>サプライズ</dt><dd>配慮あり<small>件名を控えめに</small></dd></div>
    </dl>
  </div>
</section>

{%- if place_count > 0 %}
{%- comment -%}
  Place cards: every option is visible text (headings + venue names). propose.js toggles the
  selection, shows the matching detail panel, and adds &place=<type> to every booking link
  on the page (also from ?place= in the URL).
{%- endcomment -%}
<section class="sec sec-deep" id="loc-place" aria-labelledby="l-place">
  <div class="wrap" data-place-picker>
    <div class="sec-head reveal">
      <span class="label">Place</span>
      <h2 class="h2" id="l-place">{{ name_ja | escape }}の、<br class="br-sp">プロポーズ場所を選ぶ。</h2>
      <p class="lede">{{ place_names }}から選べます。選んだ場所は、そのまま予約に引き継がれます。</p>
    </div>
    <div class="pcards reveal" role="radiogroup" aria-label="プロポーズの場所">
      {%- for t in pp_types -%}
        {%- assign venue_key = t | append: '_venues' -%}
        {%- assign venues = loc[venue_key].value -%}
        {%- if loc.place_types.value contains t or venues != blank -%}
        <button type="button" role="radio" aria-checked="false" class="pcard" data-place="{{ t }}">
          {% render 'propose-icon', name: t %}
          <span class="tick" aria-hidden="true">✓</span>
          <b>{% render 'propose-place-type', type: t, part: 'ja' %}</b>
          <span class="en-sm">{% render 'propose-place-type', type: t, part: 'en' %}</span>
          <p>{% render 'propose-place-type', type: t, part: 'desc' %}</p>
          {%- if venues != blank %}<span class="pv">{% for v in venues %}{{ v | escape }}{% unless forloop.last %}<br>{% endunless %}{% endfor %}</span>{% endif %}
        </button>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="place-detail" aria-live="polite">
      <div data-place-panel=""><p class="pd-hint">まだ選ばなくても大丈夫です。迷ったときは、その日にいちばん合う場所をご案内します。</p></div>
      {%- for t in pp_types -%}
        {%- assign venue_key = t | append: '_venues' -%}
        {%- assign venues = loc[venue_key].value -%}
        {%- if loc.place_types.value contains t or venues != blank -%}
        <div data-place-panel="{{ t }}" hidden>
          <p class="pd-title"><b>{% render 'propose-place-type', type: t, part: 'ja' %}</b>で申し込む</p>
          <p>{% render 'propose-place-type', type: t, part: 'desc' %}</p>
          {%- if venues != blank %}
          <p class="place-venues">選べる会場：{{ venues | join: '／' | escape }}</p>
          {%- else %}
          <p class="place-venues">会場は、ご希望に合わせてご案内します。</p>
          {%- endif %}
          {%- if fee_types contains t %}<p class="note">{{ section.settings.venue_note | escape }}</p>{% endif %}
          <button type="button" class="btn" data-scroll="loc-avail">日程を確認する <span class="arrow" aria-hidden="true">↓</span></button>
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif %}

<section class="sec" aria-labelledby="l-day">
  <div class="wrap assure-wrap">
    <div class="sec-head reveal">
      <span class="label">Your Proposal</span>
      <h2 class="h2" id="l-day">{{ name_ja | escape }}での、<br class="br-sp">当日の流れ。</h2>
      <p class="lede">{{ loc.duration.value | escape }}。{{ section.settings.day_lede | escape }}</p>
    </div>
    <div>
      <ol class="timeline reveal">
        {%- assign step_no = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            {%- assign step_no = step_no | plus: 1 -%}
            {%- assign text = block.settings.text | replace: '{meeting_point}', meeting_point | replace: '{location}', name_ja -%}
            <li class="tl-item{% if block.settings.highlight %} is-key{% endif %}" {{ block.shopify_attributes }}>
              <span class="step-no">{{ step_no | prepend: '0' | slice: -2, 2 }}</span>
              <h3 class="h3">{{ block.settings.title | escape }}</h3>
              <p>{{ text | escape }}</p>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
      {%- if section.settings.day_note != blank %}<p class="note" style="margin-top:24px">{{ section.settings.day_note | escape }}</p>{% endif %}
    </div>
  </div>
</section>

<section class="sec sec-deep" aria-labelledby="l-plan">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="label">Plan</span>
      <h2 class="h2" id="l-plan">{{ name_ja | escape }}の、<br class="br-sp">プランと料金。</h2>
    </div>
    {%- if plan -%}
      {% render 'propose-plan-box', light_price: light_price, standard_price: std_price, luxury_price: lux_price, booking_url: booking_url %}
    {%- endif -%}
  </div>
</section>

<section class="sec" id="loc-avail" aria-labelledby="l-avail">
  <div class="wrap-narrow">
    <div class="sec-head reveal">
      <span class="label">Availability</span>
      <h2 class="h2" id="l-avail">{{ name_ja | escape }}の、<br class="br-sp">日程を確認する。</h2>
      <p class="lede">旅行中の日付を選ぶと、申し込める時間が分かります。</p>
    </div>
    <div class="avail reveal" id="avail" data-avail="pp-location-data">
      <noscript><a class="btn btn-block" href="{{ booking_url }}">日付を選んで申し込む</a></noscript>
    </div>
    {%- if loc.rain_plan.value != blank %}
    <p class="rain-note reveal"><b>雨の日</b>{{ loc.rain_plan.value | escape }}</p>
    {%- endif %}
  </div>
</section>

<section class="sec sec-deep" aria-labelledby="l-faq">
  <div class="wrap-narrow">
    <div class="sec-head reveal">
      <span class="label">FAQ</span>
      <h2 class="h2" id="l-faq">{{ name_ja | escape }}のプロポーズ、<br class="br-sp">よくあるご質問</h2>
    </div>
    <div class="faq">
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq' or block.type == 'rain_faq' -%}
          {%- liquid
            assign q = block.settings.question | replace: '{location}', name_ja
            if block.type == 'rain_faq'
              assign a = loc.rain_plan.value
            else
              assign a = block.settings.answer | replace: '{location}', name_ja | replace: '{meeting_point}', meeting_point | replace: '{lead_time}', lead_time | replace: '{reply_hours}', reply_hours
            endif
            assign a_html = a | escape | newline_to_br
          -%}
          {%- if a != blank -%}
          <div {{ block.shopify_attributes }}>{% render 'propose-faq-list', question: q, answer: a_html %}</div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<section class="final">
  {% render 'propose-photo', image: loc.hero_image.value, pos: '50% 18%', decorative: true, fallback_name: name_en %}
  <div class="wrap">
    <span class="label">Propose in {{ name_title | escape }}</span>
    <h2 class="h2">{{ section.settings.final_heading | escape }}</h2>
    {%- if plan %}<p class="lede">{{ name_ja | escape }}のプロポーズ　花束のみ {{ light_price | money }}〜{% if std_price %}／写真付き {{ std_price | money }}〜{% endif %}</p>{% endif %}
    <a class="btn btn-light" href="{{ booking_url }}">この場所で予約する <span class="arrow" aria-hidden="true">→</span></a>
    <nav class="ft-links" style="justify-content:center;margin-top:48px" aria-label="ほかの旅行先">
      {%- for other in metaobjects.propose.values -%}
        {%- unless other.system.handle == loc.system.handle -%}
          {%- liquid
            assign other_url = other.system.url
            if other_url == blank
              assign other_url = '/pages/propose/' | append: other.system.handle
            endif
          -%}
          <a href="{{ other_url }}">{{ other.location_name.value | escape }}</a>
        {%- endunless -%}
      {%- endfor -%}
    </nav>
  </div>
</section>

<div class="sticky-cta" id="sticky-cta" aria-hidden="true">
  {%- if plan %}<div class="sticky-price"><small>{% if std_price %}写真付き{% else %}FROM{% endif %}</small><span class="price">{{ std_price | default: light_price | money }}〜</span></div>{% endif %}
  <a class="btn" href="{{ booking_url }}">この場所で予約する</a>
</div>

{%- comment -%} Data for the availability quick check (assets/propose.js). {%- endcomment -%}
<script type="application/json" id="pp-location-data">
  {
    "id": {{ loc.system.handle | json }},
    "leadDays": {{ lead_time | json }},
    "timeSlots": {% if loc.time_slots.value != blank %}{{ loc.time_slots.value | json }}{% else %}[]{% endif %},
    "bestTime": {% if has_best %}{{ loc.best_time.value | json }}{% else %}null{% endif %},
    "bestTimeNote": {{ loc.best_time_note.value | default: '' | json }},
    "blocked": {% if loc.blocked_slots.value != blank %}{{ loc.blocked_slots.value | json }}{% else %}[]{% endif %},
    "few": {% if loc.few_left_slots.value != blank %}{{ loc.few_left_slots.value | json }}{% else %}[]{% endif %},
    "bookingUrl": "/pages/propose-booking"
  }
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "世界のプロポーズプラン", "item": {{ shop.url | append: '/pages/propose' | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ name_ja | append: 'でプロポーズ' | json }}, "item": {{ canonical_url | json }} }
      ]
    }
    {%- if plan -%},
    {
      "@type": "Product",
      "name": {{ name_ja | append: ' プロポーズプラン' | json }},
      "description": {{ loc.description.value | default: '' | json }},
      {%- if loc.hero_image.value != blank %}
      "image": {{ loc.hero_image.value | image_url: width: 1200 | prepend: 'https:' | json }},
      {%- endif %}
      "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": {{ shop.currency | json }},
        "lowPrice": {{ light_price | money_without_currency | remove: ',' | json }},
        "highPrice": {{ lux_price | default: std_price | default: light_price | money_without_currency | remove: ',' | json }},
        "offerCount": {{ plan.variants.size | at_most: 3 }},
        "offers": [
          {%- for v in plan.variants limit: 3 -%}
            {%- liquid
              case forloop.index
                when 1
                  assign o_name = 'ライトプラン（花束のみ）'
                when 2
                  assign o_name = 'スタンダードプラン（花束＋写真撮影）'
                else
                  assign o_name = 'ラグジュアリープラン（花束＋写真撮影＋動画撮影＋デコレーション）'
              endcase
            -%}
          { "@type": "Offer", "name": {{ o_name | json }}, "price": {{ v.price | money_without_currency | remove: ',' | json }}, "priceCurrency": {{ shop.currency | json }}, "url": {{ canonical_url | json }} }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    }
    {%- endif -%},
    {
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign faq_first = true -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq' or block.type == 'rain_faq' -%}
            {%- liquid
              assign q = block.settings.question | replace: '{location}', name_ja
              if block.type == 'rain_faq'
                assign a = loc.rain_plan.value
              else
                assign a = block.settings.answer | replace: '{location}', name_ja | replace: '{meeting_point}', meeting_point | replace: '{lead_time}', lead_time | replace: '{reply_hours}', reply_hours
              endif
            -%}
            {%- if a != blank -%}
              {%- unless faq_first %},{% endunless -%}
              { "@type": "Question", "name": {{ q | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ a | json }} } }
              {%- assign faq_first = false -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  ]
}
</script>

{% schema %}
{
  "name": "プロポーズ 旅行先ページ",
  "settings": [
    { "type": "header", "content": "文章" },
    { "type": "text", "id": "day_lede", "label": "当日の流れ 説明", "default": "最初は旅の記念撮影として、気づかれないまま、その瞬間へ。" },
    { "type": "textarea", "id": "day_note", "label": "当日の流れ 注記", "default": "※ 写真撮影付きのプラン（スタンダード・ラグジュアリー）の流れです。ライトプランは撮影がありません。" },
    { "type": "text", "id": "venue_note", "label": "場所 注記（チャペル・教会・レストラン・ホテル）", "default": "※ 会場の使用料や条件は会場ごとに異なるため、確定のご連絡でご案内します。" },
    { "type": "text", "id": "final_heading", "label": "締めの見出し", "default": "あとは、日程を選ぶだけ。" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "当日の流れ",
      "settings": [
        { "type": "text", "id": "title", "label": "見出し" },
        { "type": "textarea", "id": "text", "label": "説明", "info": "{meeting_point}＝集合場所、{location}＝旅行先名 に置き換わります。" },
        { "type": "checkbox", "id": "highlight", "label": "プロポーズの瞬間として強調する", "default": false }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "question", "label": "質問", "info": "{location} が使えます。" },
        { "type": "textarea", "id": "answer", "label": "回答", "info": "{location} {meeting_point} {lead_time} {reply_hours} が使えます。" }
      ]
    },
    {
      "type": "rain_faq",
      "name": "FAQ（雨の日・旅行先の「雨天時の対応」を回答に使う）",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "question", "label": "質問", "default": "雨が降ったらどうなりますか？" }
      ]
    }
  ]
}
{% endschema %}
