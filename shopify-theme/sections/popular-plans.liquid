<section id="plans">
  <div class="container">
    <div class="section-head reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <div class="divider-gold"></div>
      {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="grid grid-3">
      {%- for block in section.blocks -%}
        {%- if block.settings.product != blank -%}
          {%- render 'product-card', product: block.settings.product, badge: block.settings.badge -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "人気プラン",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "アイキャッチテキスト", "default": "Popular Plans" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "人気のフォトウェディングプラン" },
    { "type": "textarea", "id": "subheading", "label": "リード文", "default": "ハワイ・ダナン・ロンドン——選ばれているプランから、あなたの一枚を探す。" }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "プラン",
      "settings": [
        { "type": "product", "id": "product", "label": "商品" },
        { "type": "text", "id": "badge", "label": "バッジ（任意）", "info": "例: 人気No.1" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "人気プラン",
      "blocks": [ { "type": "plan" }, { "type": "plan" }, { "type": "plan" } ]
    }
  ]
}
{% endschema %}
