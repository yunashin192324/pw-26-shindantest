{%- comment -%}
  product-gallery — ② 撮影ギャラリー. Horizontal-scroll, Pinterest-style
  gutters. Defaults to native Product Media (order managed in Admin —
  drag to reorder there); add image blocks here instead if a curated
  subset/order different from the product's media is needed.
{%- endcomment -%}
{%- if section.settings.show_section -%}
  <section class="{% if section.settings.background == 'ivory' %}bg-ivory{% endif %}">
    <div class="container">
      {%- if section.settings.heading != blank -%}
        <div class="section-head reveal">
          <p class="eyebrow">Gallery</p>
          <h2>{{ section.settings.heading }}</h2>
          <div class="divider-gold"></div>
        </div>
      {%- endif -%}

      <div class="photo-scroll reveal">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <div class="photo-scroll-item" {{ block.shopify_attributes }}>
              {%- if block.settings.image -%}
                <img
                  src="{{ block.settings.image | image_url: width: 1000 }}"
                  alt="{{ block.settings.image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="1000" height="1250"
                >
              {%- endif -%}
              {%- if block.settings.caption != blank -%}<span class="photo-scroll-caption">{{ block.settings.caption }}</span>{%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for image in product.images limit: section.settings.max_images -%}
            <div class="photo-scroll-item">
              <img
                src="{{ image | image_url: width: 1000 }}"
                alt="{{ image.alt | default: product.title | escape }}"
                loading="lazy"
                width="1000" height="1250"
              >
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "撮影ギャラリー",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "表示する", "default": true },
    { "type": "text", "id": "heading", "label": "見出し", "default": "撮影イメージ" },
    { "type": "select", "id": "background", "label": "背景", "options": [
        { "value": "white", "label": "白" },
        { "value": "ivory", "label": "アイボリー" }
      ], "default": "white" },
    { "type": "range", "id": "max_images", "label": "商品画像から表示する枚数（ブロック未追加時）", "min": 3, "max": 50, "step": 1, "default": 10 }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "写真",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "画像" },
        { "type": "text", "id": "caption", "label": "キャプション（任意）" }
      ]
    }
  ],
  "max_blocks": 20
}
{% endschema %}
