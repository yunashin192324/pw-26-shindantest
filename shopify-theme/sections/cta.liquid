<section class="bg-black text-center">
  <div class="container">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow reveal">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="reveal reveal-1">{{ section.settings.heading }}</h2>
    <div class="cta-row reveal reveal-2" style="justify-content:center;margin-top:36px;">
      {%- for block in section.blocks -%}
        {%- assign style = 'btn-outline-light' -%}
        {%- if block.settings.style == 'gold' -%}{%- assign style = 'btn-gold' -%}{%- endif -%}
        <a href="{{ block.settings.link | default: '#' }}" class="btn {{ style }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CTA",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "アイキャッチテキスト", "default": "Get Started" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "世界で、一生残る一枚を。まずは、あなたに合う撮影地から。" }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "ボタン",
      "settings": [
        { "type": "text", "id": "text", "label": "テキスト" },
        { "type": "url", "id": "link", "label": "リンク先" },
        { "type": "select", "id": "style", "label": "スタイル", "default": "outline",
          "options": [ { "value": "outline", "label": "アウトライン" }, { "value": "gold", "label": "ゴールド（強調）" } ] }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "CTA",
      "blocks": [
        { "type": "button", "settings": { "text": "相談する", "style": "outline" } },
        { "type": "button", "settings": { "text": "30秒診断する", "style": "gold" } },
        { "type": "button", "settings": { "text": "商品一覧を見る", "style": "outline" } }
      ]
    }
  ]
}
{% endschema %}
