{%- comment -%}
  product-related — ⑫ 関連商品. Uses Shopify's native product
  recommendations engine (the same signal Search & Discovery lets
  merchants tune in Admin → no manual product picking needed here).

  How it works: on a normal page load `recommendations.performed` is
  false, so this renders as an empty shell. product.js's
  <product-recommendations> custom element then fetches
  routes.product_recommendations_url — Shopify re-renders *this same
  section* through that endpoint, where `recommendations.performed`
  is true and `recommendations.products` is populated, and the
  returned HTML is swapped in. This is the standard OS 2.0 pattern.
{%- endcomment -%}
{%- if section.settings.show_section -%}
  <product-recommendations
    class="product-recommendations-wrapper"
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.max_products }}&intent=related"
  >
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <section class="{% if section.settings.background == 'ivory' %}bg-ivory{% endif %}">
        <div class="container">
          <div class="section-head reveal">
            <p class="eyebrow">You May Also Like</p>
            <h2>{{ section.settings.heading }}</h2>
            <div class="divider-gold"></div>
          </div>
          <div class="carousel">
            <div class="carousel-viewport">
              {%- for product in recommendations.products -%}
                <a href="{{ product.url }}" class="card carousel-item">
                  <div class="card-media">
                    {%- if product.featured_image -%}
                      <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="700" height="875">
                    {%- endif -%}
                  </div>
                  <div class="card-body">
                    <h3 class="card-title" style="font-size:1.1rem;">{{ product.title }}</h3>
                    <div class="card-foot" style="border-top:none;padding-top:0;">
                      <span class="card-price">{{ product.price | money }}</span>
                      <span class="card-link">詳しく見る ＞</span>
                    </div>
                  </div>
                </a>
              {%- endfor -%}
            </div>
            <div class="carousel-nav">
              <button type="button" class="carousel-prev" aria-label="前へ">‹</button>
              <button type="button" class="carousel-next" aria-label="次へ">›</button>
            </div>
          </div>
        </div>
      </section>
    {%- endif -%}
  </product-recommendations>
{%- endif -%}

{% schema %}
{
  "name": "関連商品",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "表示する", "default": true },
    { "type": "text", "id": "heading", "label": "見出し", "default": "この撮影地をご覧になった方はこちらも検討しています" },
    { "type": "select", "id": "background", "label": "背景", "options": [
        { "value": "white", "label": "白" },
        { "value": "ivory", "label": "アイボリー" }
      ], "default": "ivory" },
    { "type": "range", "id": "max_products", "label": "表示件数", "min": 3, "max": 10, "step": 1, "default": 6 }
  ],
  "presets": [{ "name": "関連商品" }]
}
{% endschema %}
