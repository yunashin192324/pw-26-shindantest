{%- comment -%}
  diagnosis-quiz — generic client-side quiz (diagnosis.js) built on
  the existing .diag-* components. Reused for both the destination
  diagnosis (page.diagnosis.json) and the dress-style diagnosis
  (page.dress-diagnosis.json). Add blocks in this fixed order: one
  "質問" block followed by 2–3 "選択肢" blocks, repeated per question;
  then any number of "診断結果" blocks.

  Each 診断結果 block works in one of two modes:
    - 商品 (product) set → links a real Shopify product (price/URL/
      availability badge pulled from it). Used by the destination quiz.
    - 商品 empty → generic result: 画像/見出し/説明文/リンク先の4つの
      設定で完結。予約バッジは表示されない。Used by the dress quiz to
      point at a style description (e.g. an anchor on the dress
      gallery page) instead of a purchasable product.

  The result-bucket key formula lives in diagnosis.js: first
  question's answer, optionally combined with a second signal — see
  that file's comment for the exact rule each quiz instance uses.
{%- endcomment -%}
{%- assign question_blocks = section.blocks | where: 'type', 'question' -%}
{%- assign result_blocks = section.blocks | where: 'type', 'result' -%}
{%- assign total_questions = question_blocks.size -%}

{%- if section.settings.show_section and total_questions > 0 -%}
  <section>
    <div class="container">
      <div class="diag-wrap" data-diagnosis-quiz data-key-formula="{{ section.settings.key_formula }}" data-results-id="diagnosis-results-data-{{ section.id }}">
        <div class="diag-progress"><div class="diag-progress-fill"></div></div>

        {%- assign q_index = -1 -%}
        {%- assign panel_open = false -%}
        {%- assign options_open = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'question' -%}
            {%- if options_open -%}</div>{%- assign options_open = false -%}{%- endif -%}
            {%- if panel_open -%}</div>{%- endif -%}
            {%- assign q_index = q_index | plus: 1 -%}
            <div class="diag-panel{% if q_index == 0 %} is-active{% endif %}" data-index="{{ q_index }}" data-key="{{ block.settings.key }}" {{ block.shopify_attributes }}>
              <p class="diag-step">Question {{ q_index | plus: 1 }} / {{ total_questions }}</p>
              <h2 class="diag-question">{{ block.settings.question }}</h2>
              <div class="diag-options">
              {%- assign panel_open = true -%}
              {%- assign options_open = true -%}
          {%- elsif block.type == 'option' -%}
            <button class="diag-option" type="button" data-value="{{ block.settings.value }}" {{ block.shopify_attributes }}>{{ block.settings.label }}{%- if block.settings.sub != blank -%}<span class="diag-option-sub">{{ block.settings.sub }}</span>{%- endif -%}</button>
          {%- endif -%}
        {%- endfor -%}
        {%- if options_open -%}</div>{%- endif -%}
        {%- if panel_open -%}</div>{%- endif -%}

        <div class="diag-panel diag-result" data-index="{{ total_questions }}">
          <p class="eyebrow">Your Result</p>
          <p class="diag-result-lede" style="margin-top:8px;">{{ section.settings.result_lede }}</p>
          <div class="diag-result-image"><img src="" alt=""></div>
          <h2 class="diag-result-name">—</h2>
          <span class="avail-tag diag-result-avail">—</span>
          <p class="diag-result-reason mt-40">—</p>
          <p class="diag-result-price">—</p>
          <div class="cta-row" style="justify-content:center;">
            <a href="#" class="btn btn-gold diag-result-link">{{ section.settings.result_link_label }}</a>
            <button class="btn btn-outline-dark diag-restart" type="button">もう一度診断する</button>
          </div>
          <p class="note mt-40" style="font-size:0.8rem;color:var(--text-muted);">{{ section.settings.result_footnote }}</p>
        </div>
      </div>
    </div>
  </section>

  <script type="application/json" id="diagnosis-results-data-{{ section.id }}">
  {
    {%- assign printed_any = false -%}
    {%- for block in result_blocks -%}
      {%- assign product = block.settings.product -%}
      {%- if block.settings.result_key != blank -%}
        {%- if printed_any -%},{%- endif -%}
        {%- if product -%}
          {{ block.settings.result_key | json }}: {
            "name": {{ product.title | json }},
            "image": {{ product.featured_image | image_url: width: 640 | json }},
            "price": {{ product.price | money | json }},
            "avail": {{ block.settings.avail_style | json }},
            "availLabel": {{ block.settings.avail_label | json }},
            "url": {{ product.url | json }},
            "reason": {{ block.settings.reason | default: product.description | strip_html | truncate: 120 | json }}
          }
        {%- else -%}
          {{ block.settings.result_key | json }}: {
            "name": {{ block.settings.heading | json }},
            "image": {%- if block.settings.image -%}{{ block.settings.image | image_url: width: 640 | json }}{%- else -%}""{%- endif -%},
            "price": "",
            "avail": "",
            "availLabel": {{ block.settings.avail_label | json }},
            "url": {{ block.settings.link_url | json }},
            "reason": {{ block.settings.reason | strip_html | json }}
          }
        {%- endif -%}
        {%- assign printed_any = true -%}
      {%- endif -%}
    {%- endfor -%}
  }
  </script>
{%- elsif request.design_mode -%}
  <section><div class="container"><p class="note text-center">「質問」ブロックと「選択肢」ブロックを追加すると診断が表示されます。</p></div></section>
{%- endif -%}

{% schema %}
{
  "name": "診断",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "表示する", "default": true },
    { "type": "select", "id": "key_formula", "label": "結果キーの決め方", "options": [
        { "value": "first_plus_tier", "label": "1問目の値 ＋ 他の質問に「high」「special」があれば-premium／なければ-basic" },
        { "value": "first_question", "label": "1問目の値のみ" }
      ], "default": "first_plus_tier", "info": "診断結果ブロックの「結果キー」と対応させてください。" },
    { "type": "text", "id": "result_lede", "label": "結果画面のリード文", "default": "あなたにおすすめのプランは" },
    { "type": "text", "id": "result_link_label", "label": "結果画面のボタン文言", "default": "プランを見る" },
    { "type": "text", "id": "result_footnote", "label": "結果画面の注記", "default": "診断結果は目安です。詳しい内容は各プランページでご確認いただくか、お気軽にご相談ください。" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "質問",
      "settings": [
        { "type": "text", "id": "key", "label": "キー（半角英数字）", "default": "vibe", "info": "1問目はdiagnosis.jsの結果判定で使用する診断結果ブロックのキー接頭辞になります。" },
        { "type": "text", "id": "question", "label": "質問文", "default": "気になる雰囲気はどちらですか？" }
      ]
    },
    {
      "type": "option",
      "name": "選択肢",
      "settings": [
        { "type": "text", "id": "value", "label": "値（半角英数字）", "default": "hawaii" },
        { "type": "text", "id": "label", "label": "選択肢の文言", "default": "選択肢" },
        { "type": "text", "id": "sub", "label": "補足文言（任意）" }
      ]
    },
    {
      "type": "result",
      "name": "診断結果",
      "settings": [
        { "type": "text", "id": "result_key", "label": "結果キー", "info": "diagnosis.jsのロジックに合わせたキー（商品診断の例：hawaii-premium）" },
        { "type": "header", "content": "商品にリンクする場合" },
        { "type": "product", "id": "product", "label": "商品", "info": "設定した場合、名称・画像・価格・URLは商品から自動取得されます（下の「見出し」「画像」「リンク先」は無視されます）。" },
        { "type": "select", "id": "avail_style", "label": "予約バッジの種類", "options": [
            { "value": "instant", "label": "即予約" },
            { "value": "confirm", "label": "リクエスト予約" }
          ], "default": "instant" },
        { "type": "text", "id": "avail_label", "label": "予約バッジ文言（空欄で非表示）" },
        { "type": "header", "content": "商品にリンクしない場合" },
        { "type": "image_picker", "id": "image", "label": "画像" },
        { "type": "text", "id": "heading", "label": "見出し" },
        { "type": "url", "id": "link_url", "label": "リンク先" },
        { "type": "header", "content": "共通" },
        { "type": "textarea", "id": "reason", "label": "説明文（商品リンク時は空欄で商品説明を使用）" }
      ]
    }
  ],
  "max_blocks": 40,
  "presets": [{ "name": "30秒診断" }]
}
{% endschema %}
