{%- comment -%}
  article-related-products — "この記事で紹介したプラン".

  Matches the article's tags against existing collection handles
  (e.g. an article tagged "hawaii" automatically surfaces the Hawaii
  collection's products) so merchants don't need a separate product
  picker per article — the same tags used for JOURNAL categorisation
  do double duty here. If no tag matches a collection, the section
  falls back to the collection chosen below in the theme editor, and
  hides itself entirely if that is empty too.
{%- endcomment -%}
{%- assign matched_collection = blank -%}
{%- for tag in article.tags -%}
  {%- assign candidate = collections[tag] -%}
  {%- if candidate != blank and candidate.products.size > 0 -%}
    {%- assign matched_collection = candidate -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- if matched_collection == blank -%}
  {%- assign matched_collection = section.settings.fallback_collection -%}
{%- endif -%}

{%- if matched_collection != blank and matched_collection.products.size > 0 -%}
  <section>
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Featured Plan</p>
        <h2>{{ section.settings.heading }}</h2>
        <div class="divider-gold"></div>
      </div>
      <div class="grid grid-3">
        {%- for product in matched_collection.products limit: section.settings.max_products -%}
          <a href="{{ product.url }}" class="card journal-product-card reveal{% if forloop.index0 > 0 %} reveal-{{ forloop.index0 }}{% endif %}">
            <div class="card-media">
              {%- if product.featured_image -%}
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="800" height="1000"
                >
              {%- endif -%}
            </div>
            <div class="card-body">
              <h3 class="card-title">{{ product.title }}</h3>
              <div class="card-foot" style="border-top:none;padding-top:0;">
                <span class="card-price">{{ product.price | money }}</span>
                <span class="card-link">詳しく見る ＞</span>
              </div>
            </div>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "関連商品",
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し", "default": "この記事で紹介したプラン" },
    { "type": "range", "id": "max_products", "label": "最大表示件数", "min": 2, "max": 3, "step": 1, "default": 3 },
    { "type": "collection", "id": "fallback_collection", "label": "フォールバック用コレクション", "info": "記事タグに一致するコレクションが無い場合に表示します。" }
  ]
}
{% endschema %}
