{% render 'danang-common' %}
{%- if section.settings.enable -%}
<div class="danang-scope">
  {% style %}
    #shopify-section-{{ section.id }} { background: {{ section.settings.bg_color }}; }
    #shopify-section-{{ section.id }} .danang-list-title { color: {{ section.settings.title_color }}; }
    #shopify-section-{{ section.id }} .danang-list-text { color: {{ section.settings.text_color }}; font-size: {{ section.settings.text_size }}px; }
    #shopify-section-{{ section.id }} .danang-included-grid {
      display: grid; grid-template-columns: 1fr; gap: 3rem;
    }
    @media (min-width: 768px) {
      #shopify-section-{{ section.id }} .danang-included-grid { grid-template-columns: 1fr 1fr; }
    }
  {% endstyle %}

  <section style="padding:4rem 0;">
    <div class="danang-wrap danang-included-grid">
      <div>
        <h3 class="danang-list-title" style="font-weight:500;margin-bottom:0.75rem;">{{ section.settings.included_title }}</h3>
        <div class="danang-divider" style="margin-bottom:1.5rem;"></div>
        <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:0.75rem;">
          {%- for block in section.blocks -%}
            {%- if block.type == 'included_item' -%}
              <li class="danang-list-text" style="display:flex;gap:0.5rem;align-items:flex-start;" {{ block.shopify_attributes }}>
                <span style="color:{{ section.settings.title_color }};font-weight:700;">✓</span>
                <span>{{ block.settings.text | newline_to_br }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
      <div>
        <h3 class="danang-list-title" style="font-weight:500;margin-bottom:0.75rem;">{{ section.settings.excluded_title }}</h3>
        <div class="danang-divider" style="margin-bottom:1.5rem;"></div>
        <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:0.75rem;">
          {%- for block in section.blocks -%}
            {%- if block.type == 'excluded_item' -%}
              <li class="danang-list-text" style="display:flex;gap:0.5rem;align-items:flex-start;" {{ block.shopify_attributes }}>
                <span style="color:#9ca3af;">✗</span>
                <span>{{ block.settings.text | newline_to_br }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </section>
</div>
{%- endif -%}

{% schema %}
{
  "name": "ダナン｜含む/含まない",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "このセクションを表示する", "default": true },
    { "type": "color", "id": "bg_color", "label": "背景色", "default": "#faf8f5" },
    { "type": "color", "id": "title_color", "label": "見出しの色", "default": "#1a1a1a" },
    { "type": "color", "id": "text_color", "label": "本文の色", "default": "#374151" },
    { "type": "range", "id": "text_size", "label": "本文の文字サイズ（px）", "min": 12, "max": 20, "step": 1, "default": 14 },
    { "type": "text", "id": "included_title", "label": "左側の見出し", "default": "含まれるもの" },
    { "type": "text", "id": "excluded_title", "label": "右側の見出し", "default": "含まれないもの" }
  ],
  "blocks": [
    {
      "type": "included_item",
      "name": "含まれる項目",
      "settings": [
        { "type": "textarea", "id": "text", "label": "内容（Enterキーで自由に改行できます）", "default": "項目" }
      ]
    },
    {
      "type": "excluded_item",
      "name": "含まれない項目",
      "settings": [
        { "type": "textarea", "id": "text", "label": "内容（Enterキーで自由に改行できます）", "default": "項目" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ダナン｜含む/含まない",
      "blocks": [
        { "type": "included_item", "settings": { "text": "撮影料・カメラマン1名（約3時間）" } },
        { "type": "included_item", "settings": { "text": "衣裳一式（フォーシスアンドカンパニー製 / ドレス・タキシード各1着）" } },
        { "type": "included_item", "settings": { "text": "簡易ヘアメイク（1回）" } },
        { "type": "included_item", "settings": { "text": "撮影データ一式のオンライン納品（厳選50カット＋全カット）" } },
        { "type": "included_item", "settings": { "text": "日本語対応スタッフによる事前サポート" } },
        { "type": "excluded_item", "settings": { "text": "航空券・宿泊費" } },
        { "type": "excluded_item", "settings": { "text": "空港・撮影地までの送迎" } },
        { "type": "excluded_item", "settings": { "text": "バナヒルズ入場料" } },
        { "type": "excluded_item", "settings": { "text": "アルバム制作（オプション）" } }
      ]
    }
  ]
}
{% endschema %}
