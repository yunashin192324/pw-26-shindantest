{%- comment -%}
  product-booking — Appointo "buy box". Sits directly under the hero,
  in the position an Amazon purchase box would occupy (per spec).

  Real integration: once the Appointo app is installed, its booking
  widget is a Shopify app block that merchants drag in here from
  Theme Editor → this section → "Add block" → Apps. The `"@app"` entry
  in this section's schema is what makes that slot appear, and
  `{% render block %}` is the standard OS 2.0 way to render whatever
  app block gets dropped in — this is a real embed slot, not a
  placeholder. Until Appointo is installed/added, a lightweight
  fallback (date / time / guests mock + an external booking link)
  keeps the section looking complete.
{%- endcomment -%}
{%- if section.settings.show_section -%}
  {%- assign variant = product.selected_or_first_available_variant -%}
  <section id="booking" class="bg-ivory">
    <div class="container">
      <div class="grid grid-2" style="align-items:start;">
        <div class="reveal">
          <p class="eyebrow">Reservation</p>
          <h2>{{ section.settings.heading }}</h2>
          <div class="divider-gold" style="margin-left:0;"></div>
          {%- if section.settings.description != blank -%}
            <p>{{ section.settings.description }}</p>
          {%- endif -%}
          {%- if section.settings.highlights != blank -%}
            <ul class="check-list mt-40">
              {%- for line in section.settings.highlights | newline_to_br | split: '<br />' -%}
                {%- assign line = line | strip -%}
                {%- if line != blank -%}<li>{{ line }}</li>{%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>

        <div class="reveal reveal-1">
          <div class="price-panel booking-panel">
            <span class="avail-tag {% if section.settings.badge_style == 'instant' %}instant{% else %}confirm{% endif %}">{{ section.settings.badge_label }}</span>
            <div class="amount mt-40">{{ variant.price | money }}<small> {{ section.settings.price_note }}</small></div>

            <div class="appointo-embed" data-product-id="{{ product.id }}" data-variant-id="{{ variant.id }}">
              {%- if section.blocks.size > 0 -%}
                {%- for block in section.blocks -%}
                  {% render block %}
                {%- endfor -%}
              {%- else -%}
                <div class="booking-field"><span>日付</span><span>—</span></div>
                <div class="booking-field"><span>時間</span><span>—</span></div>
                <div class="booking-field"><span>人数</span><span>2名</span></div>
                {%- if request.design_mode -%}
                  <p class="note">Appointoアプリを導入後、このセクションの「ブロックを追加」からAppointoの予約ウィジェットを追加してください。</p>
                {%- endif -%}
                <div class="cta-row" style="margin-top:22px;">
                  {%- if section.settings.fallback_url != blank -%}
                    <a href="{{ section.settings.fallback_url }}" class="btn btn-gold btn-block">{{ section.settings.fallback_label }}</a>
                  {%- else -%}
                    <a href="#reserve" class="btn btn-gold btn-block">{{ section.settings.fallback_label }}</a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>

            {%- if section.settings.note != blank -%}<p class="note">{{ section.settings.note }}</p>{%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "予約（Appointo）",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "表示する", "default": true },
    { "type": "text", "id": "heading", "label": "見出し", "default": "空き状況・ご予約" },
    { "type": "richtext", "id": "description", "label": "本文" },
    { "type": "textarea", "id": "highlights", "label": "ポイント（1行1項目）" },
    { "type": "select", "id": "badge_style", "label": "バッジの種類", "options": [
        { "value": "instant", "label": "即予約できます" },
        { "value": "confirm", "label": "現地確認後ご案内" }
      ], "default": "confirm" },
    { "type": "text", "id": "badge_label", "label": "バッジ文言", "default": "現地確認後ご案内" },
    { "type": "text", "id": "price_note", "label": "価格の注記", "default": "税込 / 2名様" },
    { "type": "text", "id": "fallback_label", "label": "予約ボタン文言（Appointo未設置時）", "default": "空き状況を問い合わせる" },
    { "type": "url", "id": "fallback_url", "label": "予約ボタンリンク先（Appointo未設置時）" },
    { "type": "text", "id": "note", "label": "補足メモ", "default": "ご希望日の第2候補まで承ります。繁忙期は早めのお問い合わせがおすすめです。" }
  ],
  "blocks": [{ "type": "@app" }]
}
{% endschema %}
