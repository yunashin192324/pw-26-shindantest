{%- comment -%}
  destination-faq — よくある質問(destination.faqsが空なら非表示)と、
  同じ地域の関連都市への内部リンク(GEO/回遊性向上)。

  注意: where/reject/sortフィルターに 'slug.value' 'region.value'
  のような文字列を渡す書き方は、ストアによってはMetaobjectのdrop
  解決の相性で一致しないことが実機検証で確認された（直接のdot-access
  d.region.value 等は正しく動くことを確認済み）。そのためこのファイル
  では where/reject/sort を一切使わず、for + if の手動ループと
  選択ソートだけで実装している。
{%- endcomment -%}
{%- assign destination = blank -%}
{%- for d in shop.metaobjects.destination.values -%}
  {%- if d.slug.value == page.handle -%}
    {%- assign destination = d -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- if destination -%}
  {%- assign faqs = destination.faqs.value -%}
  {%- if faqs.size > 0 -%}
    <section>
      <div class="dst-container" style="max-width:760px;">
        <div class="dst-section-head dst-reveal">
          <p class="dst-eyebrow">FAQ</p>
          <h2>{{ section.settings.heading }}</h2>
          <hr class="dst-divider">
        </div>
        <div class="dst-accordion">
          {%- for faq in faqs -%}
            <div class="dst-accordion-item dst-reveal">
              <button type="button" class="dst-accordion-trigger">
                <span><span class="dst-q-mark">Q. </span>{{ faq.question }}</span>
              </button>
              <div class="dst-accordion-panel"><p>{{ faq.answer }}</p></div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- assign all_destinations = shop.metaobjects.destination.values -%}
  {%- comment -%} 1st pass: 同じ地域・自分以外の件数を数える {%- endcomment -%}
  {%- assign related_count = 0 -%}
  {%- for d in all_destinations -%}
    {%- if d.region.value == destination.region.value and d.slug.value != destination.slug.value -%}
      {%- assign related_count = related_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if related_count > 0 -%}
    <section class="dst-bg-ivory">
      <div class="dst-container">
        <div class="dst-section-head dst-reveal">
          <p class="dst-eyebrow">Related</p>
          <h2>{{ section.settings.related_heading }}</h2>
          <hr class="dst-divider">
        </div>
        <div class="dst-region-grid">
          {%- comment -%} 2nd pass: sort_order昇順に最大4件、選択ソートで描画 {%- endcomment -%}
          {%- assign rendered_slugs = '' -%}
          {%- assign render_max = related_count | at_most: 4 -%}
          {%- for i in (1..render_max) -%}
            {%- assign min_sort_order = blank -%}
            {%- assign min_destination = blank -%}
            {%- for d in all_destinations -%}
              {%- assign already_rendered = rendered_slugs contains d.slug.value -%}
              {%- if d.region.value == destination.region.value and d.slug.value != destination.slug.value and already_rendered == false -%}
                {%- if min_sort_order == blank or d.sort_order.value < min_sort_order -%}
                  {%- assign min_sort_order = d.sort_order.value -%}
                  {%- assign min_destination = d -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if min_destination != blank -%}
              {% render 'destination-card', destination: min_destination %}
              {%- assign rendered_slugs = rendered_slugs | append: min_destination.slug.value | append: ',' -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "都市 FAQ・関連都市",
  "settings": [
    { "type": "text", "id": "heading", "label": "FAQ見出し", "default": "よくある質問" },
    { "type": "text", "id": "related_heading", "label": "関連都市 見出し", "default": "その他の撮影地" }
  ]
}
{% endschema %}
