{%- comment -%}
  TOP: four reassurances directly under the hero, for someone deciding days before departure.
  In a block's title/text, {min_lead} = the shortest lead_time among destinations and
  {reply_hours} = propose_settings.reply_hours (default 24).
{%- endcomment -%}
{%- liquid
  assign pp_settings = metaobjects.propose_settings.values.first
  assign reply_hours = pp_settings.reply_hours.value | default: 24
  assign min_lead = 99
  for loc in metaobjects.propose.values
    assign lt = loc.lead_time.value | plus: 0
    if lt < min_lead
      assign min_lead = lt
    endif
  endfor
  if min_lead == 99
    assign min_lead = '—'
  endif
-%}
<section class="trust" aria-label="安心のポイント">
  <div class="wrap">
    <ul class="trust-list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign t_title = block.settings.title | replace: '{min_lead}', min_lead | replace: '{reply_hours}', reply_hours
          assign t_text = block.settings.text | replace: '{min_lead}', min_lead | replace: '{reply_hours}', reply_hours
        -%}
        <li class="trust-item" {{ block.shopify_attributes }}>
          {% render 'propose-icon', name: block.settings.icon %}
          <div><b>{{ t_title | escape }}</b><span>{{ t_text | escape }}</span></div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "プロポーズ 安心のポイント",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "項目",
      "settings": [
        { "type": "select", "id": "icon", "label": "アイコン", "default": "calendar", "options": [
          { "value": "calendar", "label": "カレンダー" },
          { "value": "clock", "label": "時計" },
          { "value": "yen", "label": "円" },
          { "value": "lock", "label": "鍵" }
        ] },
        { "type": "text", "id": "title", "label": "見出し", "info": "{min_lead}＝最短の受付期限（日数）、{reply_hours}＝返信までの時間 に置き換わります。" },
        { "type": "text", "id": "text", "label": "説明" }
      ]
    }
  ],
  "presets": [{ "name": "プロポーズ 安心のポイント" }]
}
{% endschema %}
