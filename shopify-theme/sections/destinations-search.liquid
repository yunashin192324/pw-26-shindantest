{%- comment -%}
  destinations-search — 都市名/英語名/国/地域/テーマでのインクリメンタル検索。
  検索対象データはこのセクションが唯一の情報源としてJSONで書き出し、
  destinations.js がクライアント側でフィルタする(120都市以上でも
  初期表示では画像を1枚も読み込まない = パフォーマンス配慮)。
  「テーマから選ぶ」のタイルクリックも dst:search イベント経由で
  ここに検索条件を渡す。
{%- endcomment -%}
{%- assign destinations = shop.metaobjects.destination.values -%}
<section id="dst-search" class="dst-bg-ivory">
  <div class="dst-container">
    <div class="dst-section-head dst-reveal">
      <p class="dst-eyebrow">Search</p>
      <h2>{{ section.settings.heading }}</h2>
      <hr class="dst-divider">
      <p>{{ section.settings.description }}</p>
    </div>

    <div class="dst-search-box dst-reveal dst-reveal-1">
      <div class="dst-search-field">
        <label for="dst-search-input" class="dst-sr-only">撮影地を検索</label>
        <input type="search" id="dst-search-input" placeholder="{{ section.settings.placeholder }}" autocomplete="off">
      </div>
      <div class="dst-search-meta">
        <span class="dst-search-count" id="dst-search-count"></span>
      </div>
      <div class="dst-search-results" id="dst-search-results" hidden></div>
      <p class="dst-search-empty" id="dst-search-empty">{{ section.settings.empty_label }}</p>
    </div>
  </div>

  <template id="dst-result-template">
    <a href="#" class="dst-card">
      <div class="dst-card-media"><img loading="lazy" alt=""></div>
      <div class="dst-card-body">
        <p class="dst-card-country"></p>
        <p class="dst-card-name-en"></p>
        <h3 class="dst-card-name-ja"></h3>
        <div class="dst-card-themes"></div>
        <span class="dst-card-link">詳しく見る ＞</span>
      </div>
    </a>
  </template>

  <script type="application/json" id="dst-search-data">
    [
    {%- for destination in destinations -%}
      {%- capture region_label -%}{% render 'destination-region-label', region_key: destination.region.value %}{%- endcapture -%}
      {%- assign region_label = region_label | strip -%}
      {%- assign thumb = '' -%}
      {%- if destination.hero_image.value -%}
        {%- assign thumb = destination.hero_image.value | image_url: width: 240 -%}
      {%- endif -%}
      {
        "name_ja": {{ destination.name_ja.value | json }},
        "name_en": {{ destination.name_en.value | json }},
        "country": {{ destination.country.value | json }},
        "region": {{ destination.region.value | json }},
        "region_label": {{ region_label | json }},
        "themes": {{ destination.themes.value | json }},
        "theme_labels": [
          {%- for theme_key in destination.themes.value -%}
            {%- capture tl -%}{% render 'destination-theme-label', theme_key: theme_key %}{%- endcapture -%}
            {{ tl | strip | json }}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
        "url": {{ destination.slug.value | prepend: '/pages/' | json }},
        "thumb": {{ thumb | json }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
    ]
  </script>
</section>

{% schema %}
{
  "name": "撮影地一覧 検索",
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し", "default": "撮影地を探す" },
    { "type": "textarea", "id": "description", "label": "説明文", "default": "都市名・国・地域・テーマから検索できます。" },
    { "type": "text", "id": "placeholder", "label": "入力欄プレースホルダー", "default": "例：パリ、ハワイ、ビーチ" },
    { "type": "text", "id": "empty_label", "label": "0件時のメッセージ", "default": "該当する撮影地が見つかりませんでした。別のキーワードでお試しください。" }
  ],
  "presets": [{ "name": "撮影地一覧 検索" }]
}
{% endschema %}
