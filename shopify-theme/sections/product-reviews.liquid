{%- comment -%}
  product-reviews — ⑩ レビュー. Judge.me embed. `shop.metafields.judgeme.widget`
  is populated automatically by the Judge.me app once installed and is
  the app's own documented embed method — no extra JS needed. A static
  placeholder (stars + count) shows in Theme Editor before the app is
  connected so the section never looks broken.
{%- endcomment -%}
{%- if section.settings.show_section -%}
  <section class="{% if section.settings.background == 'ivory' %}bg-ivory{% endif %}">
    <div class="container" style="max-width:900px;">
      <div class="section-head reveal">
        <p class="eyebrow">Reviews</p>
        <h2>{{ section.settings.heading }}</h2>
        <div class="divider-gold"></div>
      </div>

      <div class="reveal">
        {%- if shop.metafields.judgeme.widget -%}
          {{ shop.metafields.judgeme.widget }}
        {%- elsif request.design_mode -%}
          <div class="review-placeholder text-center">
            <p style="color:var(--gold);letter-spacing:0.1em;">★★★★★</p>
            <p class="note" style="margin-top:10px;">Judge.meアプリを導入すると、ここに★評価・レビュー数・写真付きレビューが自動表示されます。</p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "レビュー（Judge.me）",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "表示する", "default": true },
    { "type": "text", "id": "heading", "label": "見出し", "default": "お客様の声" },
    { "type": "select", "id": "background", "label": "背景", "options": [
        { "value": "white", "label": "白" },
        { "value": "ivory", "label": "アイボリー" }
      ], "default": "white" }
  ]
}
{% endschema %}
