{%- comment -%}
  region-city-list — 地域ページの都市一覧。ページのhandleから地域キーを
  判定し、その地域に属するDestinationを全件(sort_order昇順)表示する
  (一覧ページと異なりここでは8件キャップなし)。

  注意: where/sortフィルターに 'region.value' のような文字列を渡す
  書き方は、ストアによってはMetaobjectのdrop解決の相性で0件になる
  ことが実機検証で確認された（`{{ d.region.value }}` の直接参照は
  正しく動くが、フィルター文字列引数経由だと一致しない）。そのため
  ここでは where/sort を一切使わず、for + if の手動ループと選択ソート
  だけで実装している。
{%- endcomment -%}
{%- assign region_key = page.handle | replace: '-', '_' -%}
{%- assign all_destinations = shop.metaobjects.destination.values -%}

{%- comment -%} 1st pass: この地域に該当する件数を数える {%- endcomment -%}
{%- assign region_count = 0 -%}
{%- for d in all_destinations -%}
  {%- if d.region.value == region_key -%}
    {%- assign region_count = region_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

<section class="dst-bg-ivory">
  <div class="dst-container">
    <div class="dst-section-head dst-reveal">
      <h2>{{ section.settings.heading }}</h2>
      <hr class="dst-divider">
      <p>{{ region_count }}件の撮影地</p>
    </div>
    {%- if region_count > 0 -%}
      <div class="dst-region-grid">
        {%- comment -%} 2nd pass: sort_order昇順に全件、選択ソートで描画 {%- endcomment -%}
        {%- assign rendered_slugs = '' -%}
        {%- for i in (1..region_count) -%}
          {%- assign min_sort_order = blank -%}
          {%- assign min_destination = blank -%}
          {%- for d in all_destinations -%}
            {%- assign already_rendered = rendered_slugs contains d.slug.value -%}
            {%- if d.region.value == region_key and already_rendered == false -%}
              {%- if min_sort_order == blank or d.sort_order.value < min_sort_order -%}
                {%- assign min_sort_order = d.sort_order.value -%}
                {%- assign min_destination = d -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if min_destination != blank -%}
            {% render 'destination-card', destination: min_destination %}
            {%- assign rendered_slugs = rendered_slugs | append: min_destination.slug.value | append: ',' -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="dst-text-center">近日公開予定です。</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "地域 都市一覧",
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し", "default": "都市一覧" }
  ],
  "presets": [{ "name": "地域 都市一覧" }]
}
{% endschema %}
