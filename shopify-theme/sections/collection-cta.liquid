{%- comment -%}
  collection-cta — closing CTA toward this destination's first plan
  and toward the diagnosis flow.
{%- endcomment -%}
{%- if section.settings.show_section -%}
  <section class="bg-black text-center">
    <div class="container">
      <p class="eyebrow reveal">{{ section.settings.eyebrow }}</p>
      <h2 class="reveal reveal-1">{{ section.settings.heading }}</h2>
      <div class="cta-row reveal reveal-2" style="justify-content:center;margin-top:32px;">
        {%- assign first_product = collection.products.first -%}
        {%- if first_product -%}
          <a href="{{ first_product.url }}" class="btn btn-gold">{{ section.settings.primary_label }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_url != blank -%}
          <a href="{{ section.settings.secondary_url }}" class="btn btn-outline-light">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "最後のCTA",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "表示する", "default": true },
    { "type": "text", "id": "eyebrow", "label": "英字見出し", "default": "" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "この撮影地で、あなたの一枚を。" },
    { "type": "text", "id": "primary_label", "label": "メインボタン文言", "default": "プランを見る" },
    { "type": "text", "id": "secondary_label", "label": "サブボタン文言", "default": "30秒診断する" },
    { "type": "url", "id": "secondary_url", "label": "サブボタンリンク先" }
  ]
}
{% endschema %}
