{%- comment -%}
  Full-bleed hero for the propose-home page. All copy + the hero photo
  are editable from the theme customizer — no code changes needed to
  swap the campaign image or headline.
{%- endcomment -%}
{{ 'propose.css' | asset_url | stylesheet_tag }}
<script src="{{ 'propose.js' | asset_url }}" defer></script>

<section class="pp-root pp-hero">
  <div class="pp-hero-media">
    {%- if section.settings.image != blank -%}
      <div class="pp-ph pp-ph-hero"><img src="{{ section.settings.image | image_url: width: 1800 }}" alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" loading="eager" width="1800" height="{{ 1800 | divided_by: section.settings.image.aspect_ratio | round }}"></div>
    {%- else -%}
      <div class="pp-ph pp-ph-hero" style="--c1:#1c3a4a;--c2:#e2955c;" role="img" aria-label="{{ section.settings.heading | escape }}"></div>
    {%- endif -%}
    <div class="pp-hero-scrim"></div>
    <div class="pp-hero-copy">
      <h1>{{ section.settings.heading | newline_to_br }}</h1>
      {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '#pp-destinations' }}" class="pp-btn pp-btn-gold">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "プロポーズ Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "背景写真", "info": "未設定の場合はプレースホルダーのグラデーションを表示します。" },
    { "type": "textarea", "id": "heading", "label": "見出し", "default": "世界で、\n忘れられないプロポーズを。" },
    { "type": "textarea", "id": "subheading", "label": "サブコピー", "default": "世界10か所から選べる、プロポーズのための特別な旅。場所・プラン・日程をその場で選んで、そのまま予約できます。" },
    { "type": "text", "id": "cta_label", "label": "CTA文言", "default": "プロポーズする場所を選ぶ" },
    { "type": "url", "id": "cta_url", "label": "CTAリンク先", "info": "未設定の場合は #pp-destinations（このページの一覧セクション）へスクロールします。" }
  ],
  "presets": [{ "name": "プロポーズ Hero" }]
}
{% endschema %}
