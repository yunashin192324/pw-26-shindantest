<section>
  <div class="container">
    <div class="section-head reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <div class="divider-gold"></div>
    </div>
    <div class="grid grid-4">
      {%- for block in section.blocks -%}
      <div class="trust-item reveal" {{ block.shopify_attributes }}>
        <div class="trust-icon">
          {%- case block.settings.icon -%}
            {%- when 'salon' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/></svg>
            {%- when 'dress' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 3c-2.5 2-4 4.5-4 8a4 4 0 008 0c0-3.5-1.5-6-4-8zM8 19h8"/></svg>
            {%- when 'support' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="9"/><path d="M8 12h8M12 8v8"/></svg>
            {%- when 'booking' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="4" width="18" height="16" rx="1"/><path d="M3 9h18M8 2v4M16 2v4"/></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z"/></svg>
          {%- endcase -%}
        </div>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.description }}</p>
      </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "安心ポイント",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "アイキャッチテキスト", "default": "Peace of Mind" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "選ばれる、5つの安心" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "安心ポイント",
      "settings": [
        { "type": "select", "id": "icon", "label": "アイコン", "default": "shield",
          "options": [
            { "value": "shield", "label": "盾（品質）" },
            { "value": "salon", "label": "サロン（試着）" },
            { "value": "dress", "label": "ドレス（衣裳）" },
            { "value": "support", "label": "サポート" },
            { "value": "booking", "label": "予約" }
          ]
        },
        { "type": "text", "id": "title", "label": "タイトル" },
        { "type": "textarea", "id": "description", "label": "説明文" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "安心ポイント",
      "blocks": [
        { "type": "point", "settings": { "icon": "shield", "title": "HIS品質", "description": "旅行大手HISが企画・運営。長年の海外手配実績に基づく安心の品質。" } },
        { "type": "point", "settings": { "icon": "salon", "title": "日本全国で試着", "description": "渡航前に、お近くの提携サロンでドレス・タキシードの試着が可能。" } },
        { "type": "point", "settings": { "icon": "dress", "title": "フォーシスの衣裳", "description": "フォーシスアンドカンパニーの上質なドレス・タキシードをそのまま現地へ。" } },
        { "type": "point", "settings": { "icon": "support", "title": "日本語サポート", "description": "現地でも日本語対応スタッフ・通訳が同行、または手配で安心。" } },
        { "type": "point", "settings": { "icon": "booking", "title": "オンライン予約", "description": "空き状況の確認からご予約まで、オンラインで完結。" } }
      ]
    }
  ]
}
{% endschema %}
