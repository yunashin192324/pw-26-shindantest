{% render 'danang-common' %}
{%- if section.settings.enable -%}
<div class="danang-scope">
  {% style %}
    #shopify-section-{{ section.id }} .danang-sticky-cta { background: {{ section.settings.bg_color }}; border-top: 1px solid #e5e7eb; }
    #shopify-section-{{ section.id }} .danang-sticky-secondary { border: 1px solid {{ section.settings.text_color }}; color: {{ section.settings.text_color }}; }
    #shopify-section-{{ section.id }} .danang-sticky-primary { background: {{ section.settings.accent_color }}; color: #fff; }
    @media (min-width: 768px) {
      #shopify-section-{{ section.id }} .danang-sticky-cta { display: none; }
    }
  {% endstyle %}

  <div class="danang-sticky-cta" style="position:fixed;bottom:0;left:0;width:100%;padding:0.75rem 1rem;display:flex;justify-content:center;gap:0.75rem;z-index:40;">
    {%- if section.settings.secondary_label != blank -%}
      <a href="{{ section.settings.secondary_url | default: '#' }}" class="danang-btn danang-sticky-secondary" style="padding:0.6rem 1.5rem;">{{ section.settings.secondary_label }}</a>
    {%- endif -%}
    {%- if section.settings.primary_label != blank -%}
      <a href="{{ section.settings.primary_url | default: '#reserve' }}" class="danang-btn danang-sticky-primary" style="padding:0.6rem 1.5rem;">{{ section.settings.primary_label }}</a>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "ダナン｜モバイル追従CTA",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "このセクションを表示する（スマートフォンのみ表示）", "default": true },
    { "type": "color", "id": "bg_color", "label": "背景色", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "サブボタンの文字色", "default": "#1a1a1a" },
    { "type": "color", "id": "accent_color", "label": "メインボタンの色", "default": "#b8860b" },
    { "type": "text", "id": "secondary_label", "label": "サブボタン文字", "default": "相談する" },
    { "type": "url", "id": "secondary_url", "label": "サブボタンのリンク先" },
    { "type": "text", "id": "primary_label", "label": "メインボタン文字", "default": "予約する" },
    { "type": "url", "id": "primary_url", "label": "メインボタンのリンク先" }
  ],
  "presets": [
    { "name": "ダナン｜モバイル追従CTA" }
  ]
}
{% endschema %}
