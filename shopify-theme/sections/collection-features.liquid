{%- comment -%}
  collection-features — "この撮影地で撮る、という選択" icon grid,
  reusing .trust-item / .trust-icon (same component as product-features).
{%- endcomment -%}
{%- if section.settings.show_section and section.blocks.size > 0 -%}
  <section class="{% if section.settings.background == 'ivory' %}bg-ivory{% endif %}">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Features</p>
        <h2>{{ section.settings.heading }}</h2>
        <div class="divider-gold"></div>
        {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
      </div>
      <div class="grid grid-4">
        {%- for block in section.blocks -%}
          <div class="trust-item reveal{% if forloop.index0 > 0 %} reveal-{{ forloop.index0 | modulo: 4 }}{% endif %}" {{ block.shopify_attributes }}>
            <div class="trust-icon">{% render 'product-icon', icon: block.settings.icon %}</div>
            <h3>{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "撮影地の特徴",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "表示する", "default": true },
    { "type": "text", "id": "heading", "label": "見出し", "default": "この撮影地で撮る、という選択" },
    { "type": "richtext", "id": "body", "label": "本文" },
    { "type": "select", "id": "background", "label": "背景", "options": [
        { "value": "white", "label": "白" },
        { "value": "ivory", "label": "アイボリー" }
      ], "default": "white" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "特徴",
      "settings": [
        { "type": "select", "id": "icon", "label": "アイコン", "options": [
            { "value": "pin", "label": "スポット" },
            { "value": "sun", "label": "気候" },
            { "value": "shield", "label": "安心" },
            { "value": "sparkle", "label": "おすすめ" },
            { "value": "camera", "label": "撮影" },
            { "value": "car", "label": "アクセス" }
          ], "default": "pin" },
        { "type": "text", "id": "title", "label": "見出し", "default": "特徴タイトル" },
        { "type": "text", "id": "text", "label": "説明" }
      ]
    }
  ],
  "max_blocks": 4,
  "default": {
    "blocks": [
      { "type": "point", "settings": { "icon": "pin" } },
      { "type": "point", "settings": { "icon": "sun" } },
      { "type": "point", "settings": { "icon": "shield" } },
      { "type": "point", "settings": { "icon": "sparkle" } }
    ]
  }
}
{% endschema %}
