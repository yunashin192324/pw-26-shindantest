{%- comment -%} TOP: three plans + options. Prices are the lowest per plan across destinations. {%- endcomment -%}
{%- comment -%} Plan products have 3 variants in this order: Light, Standard, Luxury. {%- endcomment -%}
{%- liquid
  assign min_light = 0
  assign min_std = 0
  assign min_lux = 0
  for loc in metaobjects.propose.values
    assign plan = loc.plan_product.value
    if plan
      assign v1 = plan.variants[0].price
      if min_light == 0 or v1 < min_light
        assign min_light = v1
      endif
      if plan.variants.size > 1
        assign v2 = plan.variants[1].price
        if min_std == 0 or v2 < min_std
          assign min_std = v2
        endif
      endif
      if plan.variants.size > 2
        assign v3 = plan.variants[2].price
        if min_lux == 0 or v3 < min_lux
          assign min_lux = v3
        endif
      endif
    endif
  endfor
  if min_light == 0
    assign min_light = nil
  endif
  if min_std == 0
    assign min_std = nil
  endif
  if min_lux == 0
    assign min_lux = nil
  endif
-%}
<section class="sec" id="plan" aria-labelledby="plan-title">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="label">{{ section.settings.label | escape }}</span>
      <h2 class="h2" id="plan-title">{{ section.settings.heading | escape | newline_to_br }}</h2>
      {%- if section.settings.lede != blank %}<p class="lede">{{ section.settings.lede | escape }}</p>{% endif %}
    </div>
    {% render 'propose-plan-box', light_price: min_light, standard_price: min_std, luxury_price: min_lux, from: true %}
  </div>
</section>

{% schema %}
{
  "name": "プロポーズ 料金",
  "settings": [
    { "type": "text", "id": "label", "label": "英語ラベル", "default": "Plan" },
    { "type": "textarea", "id": "heading", "label": "見出し", "default": "料金は、\n3つのプランから。" },
    { "type": "text", "id": "lede", "label": "説明文", "default": "花束だけのライトから、写真と動画を残すラグジュアリーまで。必要なものはオプションで足せます。" }
  ],
  "presets": [{ "name": "プロポーズ 料金" }]
}
{% endschema %}
