{%- comment -%}
  TOP: the day in five steps. Text only (photos would repeat the destination cards above).
  Same timeline component as the location page.
{%- endcomment -%}
<section class="sec sec-deep" id="proposal" aria-labelledby="pr-title">
  <div class="wrap assure-wrap">
    <div class="sec-head reveal">
      <span class="label">{{ section.settings.label | escape }}</span>
      <h2 class="h2" id="pr-title">{{ section.settings.heading | escape | newline_to_br }}</h2>
      {%- if section.settings.lede != blank %}<p class="lede">{{ section.settings.lede | escape }}</p>{% endif %}
    </div>
    <div>
      <ol class="timeline reveal">
        {%- for block in section.blocks -%}
          <li class="tl-item{% if block.settings.highlight %} is-key{% endif %}" {{ block.shopify_attributes }}>
            <span class="step-no">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3 class="h3">{{ block.settings.title | escape }}</h3>
            <p>{{ block.settings.text | escape }}</p>
          </li>
        {%- endfor -%}
      </ol>
      {%- if section.settings.note != blank %}<p class="note" style="margin-top:24px">{{ section.settings.note | escape }}</p>{% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "プロポーズ 当日の流れ",
  "settings": [
    { "type": "text", "id": "label", "label": "英語ラベル", "default": "Your Proposal" },
    { "type": "textarea", "id": "heading", "label": "見出し", "default": "当日は、\nこんな時間になります。" },
    { "type": "text", "id": "lede", "label": "説明文", "default": "撮影だと気づかれないまま、その瞬間へ。すべて約2時間です。" },
    { "type": "textarea", "id": "note", "label": "注記", "default": "※ 写真撮影付きのプラン（スタンダード・ラグジュアリー）の流れです。ライトプランは撮影がありません。" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "ステップ",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "title", "label": "見出し" },
        { "type": "textarea", "id": "text", "label": "説明" },
        { "type": "checkbox", "id": "highlight", "label": "プロポーズの瞬間として強調する", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "プロポーズ 当日の流れ" }]
}
{% endschema %}
