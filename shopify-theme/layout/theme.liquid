<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    {% if template.name == 'index' %}{{ shop.name }}{% else %}{{ page_title }} | {{ shop.name }}{% endif %}
  </title>
  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}
  <link rel="canonical" href="{{ canonical_url }}">

  {%- comment -%}
    Article / blog templates override these with their own image + copy
    via the article-hero / journal-hero sections; this is the site-wide
    fallback so every page still ships a complete OGP / Twitter Card.
  {%- endcomment -%}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:type" content="{% if template.name == 'article' %}article{% elsif template.name == 'product' %}product{% else %}website{% endif %}">
  <meta property="og:title" content="{{ page_title | escape }}">
  {% if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}
  <meta property="og:url" content="{{ canonical_url }}">
  {% if template.name == 'article' and article.image %}
    <meta property="og:image" content="{{ article.image | image_url: width: 1600 | prepend: 'https:' }}">
  {% elsif template.name == 'product' and product.featured_image %}
    <meta property="og:image" content="{{ product.featured_image | image_url: width: 1600 | prepend: 'https:' }}">
  {% elsif template.name == 'collection' and collection.image %}
    <meta property="og:image" content="{{ collection.image | image_url: width: 1600 | prepend: 'https:' }}">
  {% elsif settings.social_share_image %}
    <meta property="og:image" content="{{ settings.social_share_image | image_url: width: 1600 | prepend: 'https:' }}">
  {% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title | escape }}">
  {% if page_description %}<meta name="twitter:description" content="{{ page_description | escape }}">{% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Noto+Sans+JP:wght@300;400;500;700&display=swap" rel="stylesheet">

  {% if settings.favicon %}
    <link rel="icon" href="{{ settings.favicon | image_url: width: 32 }}" type="image/png">
  {% endif %}

  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'journal.css' | asset_url }}">
  {%- if template.name == 'product' %}
  <link rel="stylesheet" href="{{ 'product.css' | asset_url }}">
  {%- endif %}

  {{ content_for_header }}
</head>
<body>

  {% section 'header' %}

  {{ content_for_layout }}

  {% section 'footer' %}

  {%- if template.name == 'product' %}
  <div class="sticky-cta">
    <a href="{{ settings.contact_url | default: '/pages/about#contact' }}" class="btn btn-outline-dark">相談する</a>
    <a href="#booking" class="btn btn-gold">予約する</a>
  </div>
  {%- endif %}

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  <script src="{{ 'journal.js' | asset_url }}" defer></script>
  {%- if template.name == 'product' %}
  <script src="{{ 'product.js' | asset_url }}" defer></script>
  {%- endif %}
  {%- if template.name == 'page' and template.suffix contains 'diagnosis' %}
  <script src="{{ 'diagnosis.js' | asset_url }}" defer></script>
  {%- endif %}
</body>
</html>
